# Parts of Apple's configuration a pod VM has no hardware or use for. The
# kernel image is copied into every VM's memory whole, and Virtualization.framework
# keeps a second copy on the host (experiments/32-pod-memory-footprint), so every
# MiB here is two per pod.
#
# No display is attached to a pod VM.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# A pod VM cannot host VMs of its own: Containerization does not enable nested
# virtualization, and it needs an M3 or later besides.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# Nothing sleeps, hibernates or kexecs a pod; it is stopped and a new one boots.
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# One memory node per VM.
# CONFIG_NUMA is not set
# The kernel's log is read over the console at boot, and 2 MiB of buffer is
# 2 MiB of every VM: 128 KiB holds a pod's whole boot log several times over.
CONFIG_LOG_BUF_SHIFT=17
