# USB mass storage, so a disk can be attached to a machine that is already
# running. Virtualization.framework cannot hot-add a virtio device, but since
# macOS 15 it can attach a USB mass-storage device to a live xHCI controller.
# Apple's configuration has neither USB nor SCSI disks.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
