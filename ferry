#!/usr/bin/env bash
# ferry -- Kubernetes on a Mac, one virtual machine per pod.
set -uo pipefail

# Where ferry's own files are.
#
# An installed ferry is reached through a symlink -- ~/.local/bin/ferry ->
# ~/.ferry-dist/current/ferry -- and dirname of the symlink is the bin
# directory, which contains none of the kernel, manifests, plugins or binaries
# this script opens. So the link is followed to the file itself.
#
# It is followed only that far. 'current' is itself a symlink to the installed
# version, and this deliberately does not resolve it: the root stays
# ~/.ferry-dist/current, so everything that writes this path down -- above all
# the LaunchAgent plist, which is written once and read at every login -- keeps
# pointing at whichever release is current rather than at the one that happened
# to be installed the day the agent was registered. Upgrading ferry is then
# moving one symlink, which is the whole reason 'current' exists. `cd` resolves
# directory symlinks logically, so this falls out rather than being arranged.
#
# readlink -f would resolve the lot, and is GNU besides; macOS has had it only
# since Ventura and this has to run from a LaunchAgent with almost no
# environment, so the loop is written out. It is bounded because a symlink cycle
# is otherwise a hang.
ferry_self="${BASH_SOURCE[0]}"
for _ in 1 2 3 4 5 6 7 8; do
  [ -L "$ferry_self" ] || break
  link="$(readlink "$ferry_self")"
  case "$link" in
    /*) ferry_self="$link" ;;
    *)  ferry_self="$(cd "$(dirname "$ferry_self")" && pwd)/$link" ;;
  esac
done
here="$(cd "$(dirname "$ferry_self")" && pwd)"
unset ferry_self link
FERRY_ROOT="$here"
export FERRY_ROOT
# Which Kubernetes this checkout has built, where those binaries live, and what
# may legally follow what. Shared with build-kubelet.sh and the control-plane
# scripts, which have to agree with this one about all three.
# shellcheck source=lib/versions.sh
. "$here/lib/versions.sh"
# shellcheck source=lib/ports.sh
. "$here/lib/ports.sh"
# Which version each node and this Mac's ferry-proxyd run, and the other
# decisions an upgrade makes before it acts.
# shellcheck source=lib/upgrade.sh
. "$here/lib/upgrade.sh"
# A checkout from before the store had bin/kubelet as a plain file and the
# version in bin/.kubelet-version. That is a version directory with one binary
# in it, so it is moved in rather than rebuilt.
ferry_adopt_legacy_binaries

# A kubelet holds thousands of descriptors -- watches, TLS connections, one log
# file per container. A login shell on macOS allows about a million, but an SSH
# session allows 256, and 'ferry join' is usually run over SSH. Inheriting that
# gives a node that works for a few minutes and then fails to reach the API, with
# an error that says nothing about descriptors.
ulimit -n 65536 2>/dev/null || ulimit -n unlimited 2>/dev/null || true

# Which cluster this is.
#
# ferry keeps its state at fixed paths and binds fixed ports, which is right
# until a second copy of ferry runs on the same Mac -- and with git worktrees
# that happens without anyone deciding to. Two clusters then share one etcd, one
# set of certificates, one set of sockets, and both try to reserve the same vmnet
# subnet. What it looks like from outside is a cluster that was working and
# quietly stopped.
#
# So everything that cannot be shared is named after the checkout it belongs to.
# The main checkout is "default" and keeps exactly the paths and ports it always
# had; a linked worktree gets its own. The key is the directory rather than the
# branch: a branch changes under a running cluster the moment someone checks
# something else out, two worktrees can sit on the same branch, and a detached
# HEAD has no branch at all.
ferry_profile() {
  [ -n "${FERRY_PROFILE:-}" ] && { echo "$FERRY_PROFILE"; return; }
  local common top
  common="$(git -C "$here" rev-parse --git-common-dir 2>/dev/null)"
  top="$(git -C "$here" rev-parse --git-dir 2>/dev/null)"
  # Not a checkout at all, which is what an installed release is. There is one
  # of those per Mac and it is the cluster people mean, so it is "default" --
  # the same ports, state directory and pod network a main checkout gets.
  #
  # Without this the release directory's own name became the profile:
  # ~/.ferry-dist/versions/ferry-v0.1.0 reads as a worktree called
  # "ferry-v0-1-0", on shifted ports and its own pod CIDR. Every upgrade would
  # then have been a different cluster, and the old one's etcd would still be
  # sitting in ~/.ferry-ferry-v0-1-0 holding the workload.
  [ -z "$common" ] && { echo default; return; }
  # In the main checkout these are the same directory; in a worktree they differ.
  if [ "$common" = "$top" ]; then echo default; return; fi
  basename "$here" | tr -c 'a-zA-Z0-9_-' '-' | sed 's/-*$//' | cut -c1-24
}
PROFILE="$(ferry_profile)"

# A number for the profile, so ports and subnets can be moved out of each other's
# way. It is allocated and written down rather than hashed: a hash cannot promise
# two profiles differ, and with a handful of worktrees a collision is likely
# rather than exotic -- the first attempt here put two of three worktrees on the
# same number, which is the bug this whole change exists to prevent.
#
# The register is a file of "<index> <profile>" lines. Claiming is done under a
# directory lock, because concurrent checkouts is the case being designed for and
# two of them starting at once must not claim the same number.
FERRY_PROFILES="${FERRY_PROFILES:-$HOME/.ferry-profiles}"

ferry_profile_index() {
  [ "$PROFILE" = default ] && { echo 0; return; }

  local existing
  existing="$(awk -v p="$PROFILE" '$2 == p {print $1; exit}' "$FERRY_PROFILES" 2>/dev/null)"
  [ -n "$existing" ] && { echo "$existing"; return; }

  local lock="$FERRY_PROFILES.lock" waited=0
  while ! mkdir "$lock" 2>/dev/null; do
    waited=$((waited + 1))
    [ "$waited" -gt 50 ] && { rmdir "$lock" 2>/dev/null; break; }
    sleep 0.1
  done

  # Re-read inside the lock: another checkout may have claimed it while waiting.
  existing="$(awk -v p="$PROFILE" '$2 == p {print $1; exit}' "$FERRY_PROFILES" 2>/dev/null)"
  if [ -z "$existing" ]; then
    local n=1
    while awk -v i="$n" '$1 == i {found=1} END {exit !found}' "$FERRY_PROFILES" 2>/dev/null; do
      n=$((n + 1))
      [ "$n" -gt 50 ] && break
    done
    existing="$n"
    printf '%s %s\n' "$existing" "$PROFILE" >> "$FERRY_PROFILES"
  fi
  rmdir "$lock" 2>/dev/null
  echo "$existing"
}
PROFILE_INDEX="$(ferry_profile_index)"
PORT_SHIFT=$(( PROFILE_INDEX * 1000 ))
# Suffix for anything named rather than numbered.
[ "$PROFILE" = default ] && SUFFIX="" || SUFFIX="-$PROFILE"

# Cluster state that should survive a restart: certificates and etcd.
FERRY_HOME="${FERRY_HOME:-$HOME/.ferry$SUFFIX}"

# How fast a kubelet may talk to the API server.
#
# Upstream defaults to 50 QPS with a burst of 100, sized for a node that is
# one of hundreds and where a kubelet flooding the API server is a real
# hazard. A ferry cluster is one or two nodes and an API server on the same
# Mac, and at those defaults a 20-pod burst is paced at a very regular 40ms a
# pod -- two requests each, one token per 20ms. The containers are all started
# within 55ms and the last pod's status is not stored for another 580ms, so
# the whole burst is waiting on a rate limiter rather than on any work.
#
# Measured, 20-pod burst, last pod Running: 875ms at the defaults, 347ms at
# these. See experiments/24-benchmark-harness/FINDINGS.md.
FERRY_KUBE_API_QPS="${FERRY_KUBE_API_QPS:-500}"
FERRY_KUBE_API_BURST="${FERRY_KUBE_API_BURST:-1000}"
# Runtime state lives under /tmp deliberately. macOS caps unix socket paths at
# ~104 bytes and the kubelet builds its podresources socket beneath --root-dir,
# so a long home directory would break it.
FERRY_RUN="${FERRY_RUN:-/tmp/ferry-run$SUFFIX}"
FERRY_SOCK="${FERRY_SOCK:-/tmp/ferry-cri$SUFFIX.sock}"
FERRY_EXEC_SOCK="${FERRY_EXEC_SOCK:-/tmp/ferry-exec$SUFFIX.sock}"
FERRY_STREAMER_SOCK="${FERRY_STREAMER_SOCK:-/tmp/ferry-streamer$SUFFIX.sock}"
FERRY_STREAM_ADDR="${FERRY_STREAM_ADDR:-127.0.0.1:$(( 10350 + PORT_SHIFT ))}"
FERRY_PROXYD_SOCK="${FERRY_PROXYD_SOCK:-/tmp/ferry-proxyd$SUFFIX.sock}"
FERRY_NETPOL_SOCK="${FERRY_NETPOL_SOCK:-/tmp/ferry-netpol$SUFFIX.sock}"
FERRY_GPUD_SOCK="${FERRY_GPUD_SOCK:-/tmp/ferry-gpud$SUFFIX.sock}"
# Pod sockets are named by pod uid, and macOS caps a unix socket path near 104
# bytes, so this directory is deliberately short.
FERRY_GPU_DIR="${FERRY_GPU_DIR:-$FERRY_RUN/gpu}"
# How many pods may hold the GPU at once. There is one GPU; this is policy.
GPU_CAPACITY="${FERRY_GPU_CAPACITY:-1}"
# How long one request holds the device before a waiting pod gets a turn, and so
# roughly the worst wait a co-tenant sees.
GPU_SLICE="${FERRY_GPU_SLICE:-0.5}"
NODE_NAME="${FERRY_NODE_NAME:-ferry-mac$SUFFIX}"
POD_SUBNET="${FERRY_POD_SUBNET:-192.168.66.1/24}"
POD_CPUS="${FERRY_POD_CPUS:-2}"
# What counts as too little disk to start pods on.
#
# The upstream default is a percentage, and a percentage is the wrong shape for a
# laptop: 5% of a 1TB disk is 46GB held in reserve, so a Mac with 45GB free taints
# itself and schedules nothing, while a Mac with a small disk gets almost no
# margin at all. An absolute figure says what it means. Kubernetes accepts either.
EVICT_DISK="${FERRY_EVICTION_DISK:-4Gi}"
EVICT_MEMORY="${FERRY_EVICTION_MEMORY:-500Mi}"
# The Swift toolchain ferry is built with.
#
# SWIFT_MIN is what the sources need. SWIFT_RECOMMENDED is what ferry is
# actually built and run with, and is worth matching across every Mac in a
# cluster: binaries are copied between machines, and two toolchains produce two
# builds that are only probably the same.
SWIFT_MIN=6.2
SWIFT_RECOMMENDED=6.4
# How many pods this Mac can actually hold.
#
# The kubelet's default is 110 and the hypervisor stops at 128 virtual machines,
# so the count looked like the binding limit. It is not: a pod here is a VM, and
# an idle one costs host memory before the workload does anything -- 226 MiB
# until experiment 32, and 133 MiB since, measured flat at 20 and 60 pods. Most
# of what went was the guest reading 8 MiB around every page fault into its two
# 83 MiB agent binaries, which the host keeps once touched; the rest was a
# kernel carrying a display stack and a hypervisor of its own.
#
# The figure is for the default 512 MiB VM. A bigger one costs about 21 MiB
# more per GiB it is given, touched or not -- the kernel's page map, zeroed at
# boot -- so a pod with a 4 GiB limit (a 4.25 GiB VM) is nearer 210 MiB.
#
# So memory can still decide, and advertising 110 on a machine that cannot hold
# 110 asks the scheduler to place pods that will fail to start. Half of RAM is
# the budget for that overhead, which leaves the other half for the workloads
# themselves: 110 from 32 GiB up, 61 on a 16 GiB Mac. FERRY_MAX_PODS overrides
# it for anyone who would rather find the wall.
pod_overhead_mib=133
# A checkout whose kernel predates that work still pays the old price, and
# should not promise pods it cannot hold. A release ships a current kernel.
if [ ! -f "$here/VERSION" ] \
  && [ "$(ferry_kernel_inputs)" != "$(cat "$here/kernel/vmlinux-arm64.inputs" 2>/dev/null)" ]; then
  pod_overhead_mib=226
fi
default_max_pods="$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 2 / pod_overhead_mib ))"
[ "$default_max_pods" -gt 110 ] && default_max_pods=110
[ "$default_max_pods" -lt 1 ] && default_max_pods=1
MAX_PODS="${FERRY_MAX_PODS:-$default_max_pods}"
# The cluster pod network: one flat segment every pod shares, on every node and
# every machine. Pods keep a vmnet NIC for the internet; this is the address
# Kubernetes knows them by. Setting it empty returns ferry to vmnet addressing
# and a single node.
# Each profile needs its own pod network: a vmnet subnet is reserved for the
# whole Mac, so two clusters asking for the same one means the second has none.
# The default keeps 10.244 so an existing cluster is undisturbed; the rest are
# numbered from 10.151 upward, which leaves room for fifty and stays clear of the
# ranges Docker and colima like.
if [ "$PROFILE_INDEX" = 0 ]; then
  CLUSTER_CIDR="${FERRY_CLUSTER_CIDR:-10.244.0.0/16}"
else
  CLUSTER_CIDR="${FERRY_CLUSTER_CIDR:-10.$(( 150 + PROFILE_INDEX )).0.0/16}"
fi
NODE_INDEX="${FERRY_NODE_INDEX:-0}"
RELAY_PORT="${FERRY_RELAY_PORT:-$(( 8472 + PORT_SHIFT ))}"
# Where machines join ferry's pod network. A second switch rather than a second
# network: ferry-cri owns the segment and the learning, and ferry-node holds the
# machines' end of it, the two speaking the same relay protocol ferry-cri
# already uses between Macs. Both ports are on loopback, so this is a hop
# between two processes rather than a hop onto a wire.
#
# Clear of RELAY_PORT rather than next to it. 'ferry node add' gives node N the
# switch port RELAY_PORT + N and allows N up to 200, so 8472..8672 is a range
# and not a port: the neighbouring 8473 is the *first* added node's switch, and
# whichever of the two bound second lost. That failure reads as "switch off;
# machines cannot reach mode 1 pods" or as an added node with no pod switch,
# depending on start order, neither of which points at a port collision.
MACHINE_RELAY_PORT="${FERRY_MACHINE_RELAY_PORT:-$(( 8700 + PORT_SHIFT ))}"
PEERS="${FERRY_PEERS:-}"
# Kept in FERRY_HOME rather than FERRY_RUN because it has to outlive a restart.
# ferry-cri reads it before the API server exists, to find out whether this
# cluster has other Macs in it -- which decides whether starting on a subnet
# other than this node's slice is a harmless fallback or a silent partition.
# A run directory under /tmp cannot answer that question after 'ferry down'.
PEERS_FILE="$FERRY_HOME/peers"
# Advertised to the other nodes, so it must be the address they can reach. The
# LAN address works for a node on this Mac and for a node on another.
lan_address() { ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en7 2>/dev/null || echo 127.0.0.1; }
LAN_IP="${FERRY_LAN_IP:-$(lan_address)}"
POD_MEMORY_MIB="${FERRY_POD_MEMORY_MIB:-512}"

# Prefer the NAT-capable kernel when it has been built. The fallback is the
# kata-containers kernel, which boots pods perfectly well but ships netfilter
# without the NAT extensions -- so a pod cannot program Service rules in its own
# kernel, and ClusterIP routing has to happen on the host instead.
NAT_KERNEL="$here/kernel/vmlinux-arm64"
FALLBACK_KERNEL="$here/experiments/03-vm-ceiling/assets/vmlinux-arm64"
if [ -f "$NAT_KERNEL" ]; then KERNEL="$NAT_KERNEL"; else KERNEL="$FALLBACK_KERNEL"; fi
# Whether the kernel can take a disk after boot: USB mass storage, the one
# device Virtualization.framework attaches to a running VM (experiment 26).
# kernel/usb-storage.config puts it in every kernel 'ferry kernel' builds; one
# built before that has none, and a machine given a disk it has no driver for
# would leave its pod waiting on a mount that never comes. So the class that
# needs it is offered only when the kernel carries it.
kernel_attaches_disks() { grep -qa "usb-storage" "$KERNEL" 2>/dev/null; }
BLOCK_CLASS="${FERRY_BLOCK_CLASS:-ferry-local-block}"
CLUSTER_DOMAIN="${FERRY_CLUSTER_DOMAIN:-cluster.local}"
COREDNS_IMAGE="${FERRY_COREDNS_IMAGE:-docker.io/coredns/coredns:1.11.3}"

# Whether this is an installed release or a checkout.
#
# A release carries a VERSION file and no sources; a checkout has sources and no
# VERSION. The difference decides what ferry can honestly offer: 'ferry build'
# and 'ferry kernel' need a toolchain and a Kubernetes tree that a release does
# not carry, and 'ferry upgrade' in a release fetches rather than compiles.
# Where install.sh is served. Printed by 'ferry token create', so a second Mac
# can be told to join in one line whether or not it has ferry yet.
FERRY_INSTALL_URL="${FERRY_INSTALL_URL:-https://get.ferry.kurpuis.com}"

# Was the cluster stopped on purpose?
#
# launchd restarts a job that exits non-zero, which is how the login agent
# notices a cluster that fell over. It cannot tell that apart from 'ferry down'
# on its own: both end with ferry-cri and the kubelet gone. Without a way to say
# which, 'ferry down' stops the cluster and launchd starts it again five seconds
# later, and there is no way to turn ferry off at all.
#
# So 'ferry down' writes this and 'ferry up' removes it, and the agent reads it
# to decide whether its exit means "restart me". In FERRY_HOME rather than
# FERRY_RUN because /tmp does not survive a reboot -- though the asymmetry is
# deliberate: after a reboot the marker is still there and the agent still
# starts, because 'ferry down' means this session, not forever.
# --- mode 2: machines -----------------------------------------------------
#
# The second mode, where the node is the VM and pods inside it are ordinary
# Linux containers sharing its kernel. See docs/MACHINES.md.
#
# Off unless asked for. Mode 2 is complete through milestone 3 -- a Machine
# becomes a node and pods on two machines reach each other -- but provisioning,
# consolidation and mixed-cluster scheduling are not built, so what it does
# today is turn `kubectl apply -f machine.yaml` into a node. Starting two more
# daemons and holding a vmnet network on every cluster, including the ones that
# will never declare a Machine, is not a fair default for that.
#
# The marker is in FERRY_HOME so the choice outlives a restart: 'ferry up' and
# the login agent bring machines back for a cluster that had them.
MACHINES_MARKER="$FERRY_HOME/machines-enabled"
machines_enabled() { [ -f "$MACHINES_MARKER" ]; }

# How hard this cluster tries not to lose a write.
#
#   full      every etcd commit reaches the SSD before it is acknowledged
#   relaxed   it reaches the OS, and the SSD when the OS gets to it
#
# The difference is one syscall and it is not small. Go's os.File.Sync() is
# fcntl(F_FULLFSYNC) on darwin -- a flush of the drive's own write cache --
# and plain fsync(2) on linux. etcd is Go and ferry runs it natively, so
# ferry asks for the expensive one where kind, inside a Linux VM, gets the
# cheap one for free. On this Mac: 0.031ms against 3.961ms, and every pod
# status update is an etcd write.
#
# 'relaxed' gives that up deliberately. A cluster you recreate on demand
# loses nothing it minds losing, and a 20-pod burst goes from 1.16s to
# 0.39s. A cluster holding something you would have to rebuild by hand
# should stay 'full', which is the default and what you get by saying
# nothing.
#
# In FERRY_HOME so the choice outlives a restart, the same way machines does:
# a cluster brought back by the login agent keeps the durability it was
# created with rather than silently changing character.
DURABILITY_MARKER="$FERRY_HOME/durability"
ferry_durability() {
  # The environment wins, for a one-off run that does not want to change the
  # cluster's recorded setting.
  if [ -n "${FERRY_DURABILITY:-}" ]; then echo "$FERRY_DURABILITY"; return; fi
  local v; v="$(cat "$DURABILITY_MARKER" 2>/dev/null)"
  case "$v" in relaxed|full) echo "$v" ;; *) echo full ;; esac
}
durability_is_relaxed() { [ "$(ferry_durability)" = relaxed ]; }
# Where the node image lives in a checkout and in a release. 'ferry node-image'
# writes it; release/build.sh ships it.
NODE_IMAGE_LAYOUT="${FERRY_NODE_IMAGE:-$here/node-image/oci}"
# Unpacked from that layout on first use, and kept: it is ~400MB and rebuilding
# it on every start would be minutes of nothing. FERRY_HOME rather than
# FERRY_RUN because /tmp does not survive a reboot.
NODE_DISK="${FERRY_NODE_DISK:-$FERRY_HOME/node.ext4}"
# Every machine sits on one vmnet network -- that is what makes mode 2's pod
# networking ordinary routing rather than mode 1's flooded switch. Profiles get
# their own, because a vmnet network is claimed for the whole Mac and a second
# cluster asking for the same one gets none.
# The subnet that last came up is remembered, because the preferred one is not
# always available: vmnet holds a subnet after the process using it stops, so
# `ferry machines enable` is sometimes run with FERRY_MACHINE_SUBNET pointing
# somewhere else. Without remembering it, the next `ferry up` went back to the
# default, failed to claim it, and brought the cluster up with mode 2 silently
# missing -- having been told, once, to use a different one.
MACHINE_SUBNET_FILE="$FERRY_HOME/machine-subnet"
MACHINE_SUBNET="${FERRY_MACHINE_SUBNET:-$(cat "$MACHINE_SUBNET_FILE" 2>/dev/null)}"
MACHINE_SUBNET="${MACHINE_SUBNET:-192.168.$(( 200 + PROFILE_INDEX )).0/24}"
# Cluster DNS for pods inside machines, as a ClusterIP.
#
# Mode 1's CoreDNS cannot serve them: it is a ferry-cri pod on the Mac's vmnet
# network, machines are on a vmnet network of their own, and vmnet keeps its
# networks apart. So machines get their own CoreDNS behind a Service, which
# kube-proxy inside each machine resolves -- the ordinary Kubernetes
# arrangement, which works there because a node VM has a kernel to program.
# Cross-mode resolution is MACHINES.md milestone 6.
MACHINE_DNS_IP="${FERRY_MACHINE_DNS_IP:-10.96.0.10}"
# The images `ferry image load` and `ferry image build` put into ferry-cri, also
# kept here and served to every node that is not the one they were loaded on:
# machines, which have a containerd of their own; nodes added with `ferry node
# add`, which have a store of their own; and nodes on other Macs, whose
# registries ask this one over the peer port. That is what makes a loaded image
# cluster-wide rather than per node, so it is on by default -- it costs one
# ~10 MiB process and nothing per image, since its blobs are hard links to the
# load's. FERRY_MACHINE_REGISTRY=0 turns it off. See start_registry.
MACHINE_REGISTRY="${FERRY_MACHINE_REGISTRY:-1}"
MACHINE_REGISTRY_PORT="${FERRY_MACHINE_REGISTRY_PORT:-$(( 5050 + PORT_SHIFT ))}"
# The other Macs', over TLS with the nodes' own certificates. The same number on
# every Mac of a cluster, since each works out the others' from its own.
REGISTRY_PEER_PORT="${FERRY_REGISTRY_PEER_PORT:-$(( 5051 + PORT_SHIFT ))}"
REGISTRY_DIR="$FERRY_HOME/registry"
machine_registry_enabled() { [ "$MACHINE_REGISTRY" = 1 ]; }
# What ferry-cri is told to ask first, so every node on this Mac finds what was
# loaded on any of them, or on another Mac.
image_mirror_flag() { machine_registry_enabled && echo "--image-mirror 127.0.0.1:$MACHINE_REGISTRY_PORT"; }
# What the Mac will commit to machines in total.
#
# A quarter of memory and half the cores by default. The provisioner will spend
# up to this and then tell Karpenter there is no capacity, which is a pod that
# stays Pending with a reason rather than a Mac that swaps -- the same answer a
# cloud gives when a zone is full, and the thing a cloud provider never has to
# implement because a region does not run out when you ask for one more node.
MACHINE_LIMIT_CPUS="${FERRY_MACHINE_LIMIT_CPUS:-$(( $(sysctl -n hw.ncpu) / 2 ))}"
MACHINE_LIMIT_MEMORY_GI="${FERRY_MACHINE_LIMIT_MEMORY_GI:-$(( $(sysctl -n hw.memsize) / 1073741824 / 4 ))}"
MACHINE_KUBE_PROXY_IMAGE="${FERRY_KUBE_PROXY_IMAGE:-registry.k8s.io/kube-proxy:v1.34.11}"

STOPPED_MARKER="$FERRY_HOME/stopped"
mark_stopped()   { mkdir -p "$FERRY_HOME" 2>/dev/null; : > "$STOPPED_MARKER"; }
clear_stopped()  { rm -f "$STOPPED_MARKER"; }
was_stopped()    { [ -f "$STOPPED_MARKER" ]; }

ferry_release_version() {
  [ -f "$here/VERSION" ] || return 1
  sed -n 's/^ferry=//p' "$here/VERSION" | head -1
}
is_release() { [ -f "$here/VERSION" ]; }
# What ferry-cri tells the kubelet it is, and so what `kubectl get nodes` shows
# as ferry://<version>. It was a constant, 0.1.0, through every release since.
#
# It has to be semver: the kubelet parses it, and anything that does not parse
# is shown as ferry://Unknown. A checkout says how far past which release it is
# -- `git describe` gives v0.3.0-2-gc87b652, a valid prerelease -- and one with
# no tags at all is 0.0.0-dev.
ferry_runtime_version() {
  ferry_release_version 2>/dev/null | grep . && return
  local described
  described="$(git -C "$here" describe --tags --match 'v[0-9]*' 2>/dev/null)"
  if [ -n "$described" ]; then echo "$described"; return; fi
  echo "0.0.0-dev+$(git -C "$here" rev-parse --short HEAD 2>/dev/null || echo unknown)"
}
# Whether the release was packaged with the mode 2 node image. Recorded by
# release/build.sh, because "the directory is missing" and "this build never had
# one" are different facts and only the second has a useful answer.
release_has_node_image() {
  [ "$(sed -n 's/^node-image=//p' "$here/VERSION" 2>/dev/null | head -1)" = yes ]
}

# macOS pgrep does not count reliably with -c, so count lines.
ip_in_cidr() { # address cidr
  local ip="$1" net="${2%/*}" bits="${2#*/}"
  [ -n "$ip" ] && [ "$net" != "$2" ] || return 1
  toint() { local IFS=.; set -- $1; echo $(( ($1 << 24) | ($2 << 16) | ($3 << 8) | $4 )); }
  local mask=$(( bits == 0 ? 0 : (0xFFFFFFFF << (32 - bits)) & 0xFFFFFFFF ))
  local a b; a="$(toint "$ip")"; b="$(toint "$net")"; unset -f toint
  [ $(( a & mask )) -eq $(( b & mask )) ]
}
count_vms() { pgrep -f "com.apple.Virtualization.VirtualMachine" 2>/dev/null | wc -l | tr -d ' '; }

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }

usage() {
  cat <<EOF
ferry -- Kubernetes on a Mac, one virtual machine per pod

  ferry doctor      check that this machine can run ferry
  ferry version     what this is, and what Kubernetes it runs
  ferry kernel      build a guest kernel with NAT support (slow, needs docker)
  ferry node-image  build the mode 2 node image (slow, needs docker)
  ferry build       build the kubelet, the runtime, and fetch the guest kernel
                    --kubernetes-version <vX.Y.Z> to pick a version, --rebuild to force
  ferry up          start the cluster
                    --durability relaxed to trade crash-safety for speed
  ferry down        stop the cluster (--purge to drop its data as well)
  ferry restart     stop and start the cluster, e.g. after a component died
  ferry status      show what is running
  ferry logs <c>    tail a component log (ferry-cri, kubelet, ferry-proxy, apiserver, etcd)
  ferry kubeconfig  print the path to the admin kubeconfig
                    --merge to add it to ~/.kube/config as a context
  ferry service     start the cluster at login (install|uninstall|status)
  ferry uninstall   stop everything and unlink ferry (--purge to delete the cluster)
  ferry node add <name>   add another node on this Mac
  ferry node rm <name>    stop one
  ferry node ls           list the nodes
  ferry image build       build an image here, with no docker anywhere
                          -t <name:tag>, -f <Dockerfile>, --stop to end the builder
  ferry image load <x>    run an image you built elsewhere, without a registry
  ferry profile           which cluster this checkout runs, and on what ports
  ferry addons list       what can be turned on, and what is
  ferry addons enable <n> turn one on and wait for it (--no-wait not to)
  ferry addons disable <n> remove exactly what enable applied
  ferry addons images <n> check an addon's images have linux/arm64 builds
  ferry token create      print a command another Mac can join with
  ferry join ...          join this Mac to a cluster on another

Machines -- mode 2, where the node is the VM and pods share its kernel:
  ferry machines status   whether mode 2 is on, and what it is running
  ferry machines enable   install the Machine CRD and start the controller
  ferry machines disable  stop it; Machines and the CRD are left alone
  ferry machines ls       the machines in this cluster

Upgrades:
  ferry upgrade status          what is running, what is built, what can roll back
  ferry upgrade plan <vX.Y.Z>   check an upgrade without doing any of it
  ferry upgrade apply <vX.Y.Z>  move the control plane, keeping the cluster's data
  ferry upgrade nodes [--to v]  drain and replace each kubelet on this Mac
  ferry upgrade node <name>     just that one [--to vX.Y.Z]
  ferry upgrade rollback        back to the version before the last apply
  ferry upgrade prune           remove store versions nothing uses [--yes]

Environment:
  FERRY_HOME             cluster state, default ~/.ferry
  FERRY_POD_SUBNET       pod network, default 192.168.66.1/24
  FERRY_POD_CPUS         cpus per pod VM, default 2
  FERRY_CLUSTER_CIDR     the pod network, default 10.244.0.0/16 (empty = vmnet)
  FERRY_EVICTION_DISK    free disk below which pods stop scheduling, default 4Gi
  FERRY_HOST_CLUSTER_IPS 1 to bind ClusterIPs on the Mac too, so the API server
                         can reach aggregated APIs like metrics.k8s.io (needs sudo)
  FERRY_RELAY_PORT       udp port the pod switch uses, default 8472. The base of
                         a range: an added node uses this plus its index
  FERRY_ALLOW_OFF_SLICE  1 to start even when vmnet will not give this node its
                         slice of the pod network. Other nodes will not reach
                         these pods; without it ferry refuses rather than
                         partition a multi-node cluster silently
  FERRY_POD_MEMORY_MIB   memory per pod VM, default 512
  K8S_VERSION            kubernetes to build, default $FERRY_DEFAULT_K8S_VERSION (same as
                         'ferry build --kubernetes-version')
  K8S_CONTROL_PLANE_VERSION  the darwin control plane build to use, when the
                         one ferry pins for that minor is not published
  ETCD_VERSION           override the etcd paired with this Kubernetes
  FERRY_KUBECONFIG       admin credentials, for upgrading a node on a Mac that
                         joined and so has only its kubelet's certificate
  FERRY_DRAIN_TIMEOUT    how long to wait for a node to drain, default 300s
EOF
}

# Binaries the kernel will refuse to run.
#
# Copying a file over one that is currently executing leaves the copy
# permanently unrunnable. macOS kills it at launch with SIGKILL, and it stays
# that way after whatever was running has exited -- the inode was rewritten
# while it was mapped, and nothing un-rewrites it. Removing the file and copying
# again fixes it, which is why every build script here does exactly that.
#
# It is worth a check because of how it presents: a bare "Killed: 9" against a
# binary that worked ten minutes ago, with nothing anywhere saying "signature".
# `codesign --verify` does not help -- it passes, because the signature is
# structurally valid; what is wrong is not the signature but the pages behind it.
#
# So the only thing that finds it is running them. Each gets the cheapest
# argument that makes it exit on its own: a version, a usage message, or a
# refusal to start. All of them return in well under a tenth of a second, and
# none of them touch the cluster's state.
ferry_probe_args() {
  case "$1" in
    etcd|kube-apiserver|kube-controller-manager|kube-scheduler|kubelet) echo "--version" ;;
    etcdctl) echo "version" ;;
    # A CNI plugin and two daemons that have no --version: give each something
    # it will decline, rather than something it will act on.
    ferry-cri) echo "--kernel /nonexistent" ;;
    ferry-gpud) echo "--control /dev/null/no --socket-dir /dev/null/no" ;;
    *) echo "--help" ;;
  esac
}

check_binaries_run() {
  local broken=() checked=0 name args
  for name in "$@"; do
    [ -x "$here/bin/$name" ] || continue
    checked=$(( checked + 1 ))
    args="$(ferry_probe_args "$name")"
    # Grouped with stderr redirected because the shell announces a killed child
    # itself -- "Killed: 9" straight to the terminal, which is the very message
    # this check exists to replace with something that explains it.
    # shellcheck disable=SC2086
    { timeout 5 "$here/bin/$name" $args >/dev/null 2>&1; } 2>/dev/null
    # 137 is 128 + SIGKILL. Every other outcome, including a non-zero exit or
    # the timeout, means the binary got far enough to be running its own code.
    [ "$?" -eq 137 ] && broken+=("$name")
  done

  # Nothing built yet is not a finding; 'ferry build' is already the next step.
  [ "$checked" -eq 0 ] && return 0
  if [ "${#broken[@]}" -eq 0 ]; then
    ok "$checked binaries run (none killed on launch)"
    return 0
  fi
  bad "killed on launch: ${broken[*]}"
  warn "a binary copied over one that was running stays unrunnable, and"
  echo "      codesign says it is fine. Rebuild to replace it: ferry build"
  return 1
}

# How to install the toolchain, without naming a version that will not exist.
#
# The label Apple offers moves -- the one this file used to print stopped being
# available -- so ask softwareupdate what it has rather than guessing. The
# removal is first because `softwareupdate --install` and `xcode-select
# --install` both lay a version down beside whatever is already there.
#
# What --install matches is the Label, and the Label is not the Title:
# softwareupdate lists `Label: Command Line Tools for Xcode 27.0-27.0` beside
# `Title: Command Line Tools for Xcode 27.0`. The title is the readable one and
# the one a person copies, and it fails with "No such update" -- so the line
# below prints labels only, and says to pass one through verbatim rather than
# retyping it.
swift_install_hint() {
  echo "      sudo rm -rf /Library/Developer/CommandLineTools"
  echo "      softwareupdate --list | sed -n 's/^\* Label: \(.*Command Line Tools.*\)/\1/p'"
  echo "      sudo softwareupdate --install \"<that label, copied exactly>\""
  echo "      ferry is built with Swift $SWIFT_RECOMMENDED; use the same one on every Mac."
}

cmd_doctor() {
  bold "ferry doctor"
  local fatal=0

  if [ "$(uname -m)" = "arm64" ]; then ok "Apple silicon"
  else bad "Apple silicon required (found $(uname -m))"; fatal=1; fi

  local major; major="$(sw_vers -productVersion | cut -d. -f1)"
  if [ "$major" -ge 26 ] 2>/dev/null; then ok "macOS $(sw_vers -productVersion)"
  else
    bad "macOS 26 or newer required (found $(sw_vers -productVersion))"
    warn "per-pod networking uses VZVmnetNetworkDeviceAttachment, which is macOS 26+"
    fatal=1
  fi

  # An installed release carries binaries, not sources. Swift and Go are how
  # those binaries were made on somebody else's Mac; requiring them here would
  # tell a person their working cluster is "not ready" for want of a compiler it
  # will never run.
  local swift_built
  if is_release; then
    ok "ferry $(ferry_release_version), installed release"
    swift_built="$(sed -n 's/^swift=//p' "$here/VERSION" | head -1)"
    [ -n "$swift_built" ] && echo "      built with Swift $swift_built; this Mac needs no toolchain"
  elif command -v swift >/dev/null; then
    # "Apple Swift version 6.4", not "swift-driver version: 1.148.6" -- the
    # driver is named first and its number is lower, so matching any "version"
    # reports 1.148 and fails the comparison for the wrong reason.
    local sv; sv="$(swift --version 2>&1 | grep -oE 'Apple Swift version [0-9]+\.[0-9]+' | head -1 | awk '{print $4}')"
    if [ -z "$sv" ]; then
      bad "Swift is installed but will not report a version"
      swift --version 2>&1 | head -2 | sed 's/^/      /'
      swift_install_hint
      fatal=1
    elif [ "$(printf '%s\n%s\n' "$sv" "$SWIFT_MIN" | sort -V | head -1)" != "$SWIFT_MIN" ]; then
      bad "Swift $SWIFT_MIN+ required (found $sv)"
      swift_install_hint
      fatal=1
    # A version number does not prove a working toolchain. The Command Line
    # Tools install as several packages, and laying one version over another
    # without removing the first leaves a tree that reports a version and cannot
    # build: a 6.3 driver reading 6.4 module interfaces, or a swift-package that
    # dies in dyld before it reads a manifest. Both were seen on a Mac whose
    # `swift --version` looked perfectly healthy, so this runs the thing rather
    # than asking it what it is.
    elif ! swift package --version >/dev/null 2>&1; then
      bad "Swift $sv is installed but SwiftPM cannot run -- the toolchain is mixed"
      echo "      Two Command Line Tools versions are installed over each other."
      echo "      Removing the directory first is the part that matters:"
      swift_install_hint
      fatal=1
    elif [ "$sv" = "$SWIFT_RECOMMENDED" ]; then
      ok "Swift $sv"
    else
      # Not fatal: the sources need SWIFT_MIN and this clears it. Said anyway,
      # because a cluster spans Macs and binaries are copied between them.
      ok "Swift $sv"
      warn "ferry is built with Swift $SWIFT_RECOMMENDED; this Mac has $sv"
      echo "      Matching the toolchain across every Mac in a cluster avoids"
      echo "      binaries that differ for reasons nobody is tracking."
    fi
  else bad "Swift not found"; swift_install_hint; fatal=1; fi

  if is_release; then :
  elif command -v go >/dev/null; then ok "$(go version | cut -d' ' -f3)"
  else bad "Go 1.24+ required, needed to build the kubelet"; fatal=1; fi

  if command -v kubectl >/dev/null; then ok "kubectl present"
  else warn "kubectl not found; you will want it to talk to the cluster"; fi

  # A release that was installed but never put on the PATH is a common enough
  # half-finished state to name.
  if is_release && ! command -v ferry >/dev/null; then
    warn "ferry is not on your PATH; you are running it by its full path"
    echo "      echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.zshrc && exec zsh"
  fi

  # Only worth saying anything about once something has been built.
  if [ -d "$here/bin" ]; then
    # etcdutl is here because rollback restores a snapshot with it, and a
    # rollback is a bad moment to find out the binary will not launch.
    check_binaries_run etcd etcdctl etcdutl kube-apiserver kube-controller-manager \
      kube-scheduler kubelet ferry-cri ferry-gpud ferry-cni ferry-streamer \
      ferry-proxyd ferry-netpol ferry-storage ferry-proxy || fatal=1
  fi

  # A pod is a VM, and every other VM on the Mac takes one of ferry's 128 slots.
  local vms; vms="$(count_vms)"
  local docker; docker="$(pgrep -f "com.docker.virtualization" 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$docker" -gt 0 ]; then
    warn "Docker Desktop is running and holds one of the 128 VM slots"
  fi
  ok "$vms virtual machines running (ceiling is 128, shared with all apps)"

  if [ -f "$NAT_KERNEL" ]; then
    ok "guest kernel with NAT support — Services route inside pods, no root needed"
    # Only a checkout has the inputs to compare, and only a kernel from before
    # the record lacks one.
    local kinputs; kinputs="$(ferry_kernel_inputs)"
    if [ -n "$kinputs" ] && [ "$kinputs" != "$(cat "$NAT_KERNEL.inputs" 2>/dev/null)" ]; then
      warn "the guest kernel was built from other patches or configuration; every pod"
      echo "      may be paying for what they fix. Rebuild with: ./ferry kernel"
    fi
  else
    warn "guest kernel without NAT (kata); Services will route through the host,"
    echo "      which needs root. Build one with: ./kernel/build-kernel.sh"
  fi

  local free; free="$(df -g "$HOME" | tail -1 | awk '{print $4}')"
  if [ "$free" -ge 20 ]; then ok "${free}G free disk"
  else warn "${free}G free disk; images and pod root filesystems need room"; fi

  echo
  if [ "$fatal" -eq 0 ]; then
    if is_release; then bold "ready -- run: ferry up"; else bold "ready -- run: ferry build && ferry up"; fi
    return 0
  else bold "not ready"; return 1; fi
}

# Which Kubernetes ferry builds.
#
# Every distribution lets you pick: minikube takes --kubernetes-version, kind
# takes a node image. ferry compiles the kubelet itself, so a version is a build
# input rather than a download, and the patches in patches/ are written against
# a particular tree. That makes another version a thing you can ask for and not
# a thing that is promised to work -- build-kubelet.sh verifies every seam it
# edits and fails loudly if one has moved, which is the honest failure for a
# version whose source has drifted.
K8S_VERSION="${K8S_VERSION:-$(ferry_active_version)}"
K8S_VERSION="${K8S_VERSION:-$FERRY_DEFAULT_K8S_VERSION}"

# Everything whose version Kubernetes decides: the kubelet, kube-proxy's rule
# generation, the three control plane binaries and etcd.
#
# Separated from the rest of the build because an upgrade needs exactly this and
# nothing else. ferry's own binaries are this checkout's code rather than
# Kubernetes', and rebuilding Swift and seven Go programs to move a patch
# release would be both slow and beside the point.
build_kubernetes_binaries() { # version
  local version="$1"
  local dir; dir="$(ferry_version_dir "$version")"

  # Rebuilt when its patches have changed as well as when it is missing. A
  # kubelet with no record of its inputs predates the record, and so may
  # predate any patch; it is rebuilt once to find out.
  local inputs; inputs="$(ferry_kubelet_inputs "$version")"
  local built; built="$(cat "$dir/kubelet.inputs" 2>/dev/null || true)"
  if [ ! -x "$dir/kubelet" ] || [ "${FERRY_REBUILD:-}" = "1" ]; then
    K8S_VERSION="$version" "$here/build-kubelet.sh" || return 1
  elif [ -n "$inputs" ] && [ "$inputs" != "$built" ]; then
    echo "==> kubelet $version was built from other patches; rebuilding"
    K8S_VERSION="$version" "$here/build-kubelet.sh" || return 1
  else
    echo "==> kubelet present, $version (--rebuild to force)"
  fi
  echo

  # kube-proxy's own rule generation, built for darwin from the patched tree.
  echo "==> ferry-proxyd"
  local src="${K8S_SRC:-${TMPDIR:-/tmp}/ferry-kubernetes-${version}}"
  if [ -d "$src" ]; then
    rm -f "$dir/ferry-proxyd"
    ( cd "$src" && GOFLAGS=-mod=vendor GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 \
        go build -o "$dir/ferry-proxyd" ./cmd/ferry-proxyd ) || return 1
    echo "==> $dir/ferry-proxyd"
  else
    warn "kubernetes source missing; run build-kubelet.sh first"
  fi
  echo

  echo "==> control plane ($(ferry_control_plane_version "$version"))"
  K8S_VERSION="$version" "$here/control-plane/fetch-binaries.sh" || return 1
}

cmd_build() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --kubernetes-version)
        [ $# -ge 2 ] && [ -n "${2:-}" ] || { bad "--kubernetes-version needs a value, such as v1.34.0"; return 2; }
        K8S_VERSION="$2"; shift 2 ;;
      --kubernetes-version=*) K8S_VERSION="${1#*=}"; shift ;;
      --rebuild) FERRY_REBUILD=1; shift ;;
      *) bad "usage: ferry build [--kubernetes-version <vX.Y.Z>] [--rebuild]"; return 2 ;;
    esac
  done
  ferry_version_valid "$K8S_VERSION" || {
    bad "--kubernetes-version $K8S_VERSION is not a version like v1.34.0"; return 2; }
  export K8S_VERSION

  # An installed release has the binaries and none of the sources. Saying so
  # here is better than failing four steps in on a missing build-kubelet.sh,
  # and the thing the person almost certainly wants -- a different Kubernetes --
  # is available to them without a toolchain.
  if is_release; then
    bad "this is an installed ferry $(ferry_release_version), not a checkout -- there is nothing here to build"
    echo
    echo "    It already carries kubernetes $(ferry_active_version), built and tested"
    echo "    as a set with the runtime and the guest kernel. To move to another,"
    echo "    install a ferry release that carries it:"
    echo "        curl -sfL $FERRY_INSTALL_URL | sh -"
    echo
    echo "    To build ferry from source instead:"
    echo "        git clone https://github.com/imaustink/ferry && cd ferry && ./ferry build"
    return 1
  fi

  bold "building ferry"
  echo "  kubernetes $K8S_VERSION (control plane $(ferry_control_plane_version "$K8S_VERSION"), etcd $(ferry_etcd_version "$K8S_VERSION"))"
  "$here/experiments/03-vm-ceiling/fetch-kernel.sh" || return 1
  echo
  local previous; previous="$(ferry_active_version)"
  [ -n "$previous" ] && [ "$previous" != "$K8S_VERSION" ] \
    && echo "==> this checkout was built at $previous; building $K8S_VERSION"
  build_kubernetes_binaries "$K8S_VERSION" || return 1
  echo
  # Only now does bin/ point at it. Building into the store first and switching
  # afterwards means a build that fails half way leaves the checkout on the
  # version it was already on rather than on half of a new one.
  ferry_activate_version "$K8S_VERSION" || return 1
  echo
  ( cd "$here/ferry-cri" && ./build.sh ) || return 1
  echo
  echo "==> ferry-proxy"
  ( cd "$here/ferry-proxy" && go build -o "$here/bin/ferry-proxy" . ) || return 1
  echo "==> $here/bin/ferry-proxy"
  echo
  echo "==> ferry-netpol"
  ( cd "$here/ferry-netpol" && go build -o "$here/bin/ferry-netpol" . ) || return 1
  echo "==> $here/bin/ferry-netpol"
  echo
  # What holds the API server's port while 'ferry upgrade' replaces it, so that
  # nothing is refused. Standard library only; a second to build.
  echo "==> ferry-handover"
  ( cd "$here/ferry-handover" && go build -o "$here/bin/ferry-handover" . ) || return 1
  echo "==> $here/bin/ferry-handover"
  echo
  # ferry-cni and the upstream plugins it runs, in both architectures.
  "$here/ferry-cni/build.sh" || return 1
  echo
  echo "==> ferry-storage"
  ( cd "$here/ferry-storage" && go build -o "$here/bin/ferry-storage" . ) || return 1
  echo "==> $here/bin/ferry-storage"
  echo
  echo "==> ferry-gpud"
  ( cd "$here/ferry-gpud" && ./build.sh ) || return 1
  echo
  echo "==> ferry-streamer"
  ( cd "$here/ferry-streamer" && go build -o "$here/bin/ferry-streamer" . ) || return 1
  echo "==> $here/bin/ferry-streamer"
  echo
  # Mode 2: the controller that turns a Machine into a node, and the tool that
  # makes the VM for it. Both are quick. The node *image* they boot is not, and
  # is built separately by 'ferry node-image' -- it needs Docker, which is the
  # same bargain 'ferry kernel' makes.
  echo "==> ferry-machined"
  ( cd "$here/ferry-machined" && go build -o "$here/bin/ferry-machined" . ) || return 1
  echo "==> $here/bin/ferry-machined"
  echo
  # What serves locally loaded images to machines, when FERRY_MACHINE_REGISTRY
  # asks for it. Standard library only, so it costs a second to build.
  echo "==> ferry-registry"
  ( cd "$here/ferry-registry" && go build -o "$here/bin/ferry-registry" . ) || return 1
  echo "==> $here/bin/ferry-registry"
  echo
  # Karpenter, with ferry as its cloud provider. It needs a newer Go than the
  # rest of this tree -- the library requires 1.26.6 -- which Go fetches on
  # demand rather than failing, so this does not raise ferry's own toolchain
  # floor.
  echo "==> ferry-karpenter"
  ( cd "$here/ferry-karpenter" && go build -o "$here/bin/ferry-karpenter" . ) || return 1
  echo "==> $here/bin/ferry-karpenter"
  echo
  echo "==> ferry-node"
  OUT="$here/bin/ferry-node" "$here/experiments/18-node-image/rebuild-tool.sh" || return 1
  echo
  # nft, for applying those rules inside pods.
  "$here/guest/build-nft.sh" || return 1
  echo
  bold "built -- run: ferry up"
  if [ ! -d "$NODE_IMAGE_LAYOUT" ]; then
    echo "  For mode 2 machines as well: ferry node-image  (slow, needs docker)"
  fi
}

# The mode 2 node image: a Linux userspace with containerd, a kubelet and the
# CNI plugins, built by Docker and exported as an OCI layout.
#
# Separate from 'ferry build' for the same reason 'ferry kernel' is: it needs
# Docker and it takes minutes, and neither is worth imposing on someone who only
# wants mode 1. A release carries the result, so the Mac installing one needs
# none of this.
cmd_node_image() {
  if is_release; then
    if release_has_node_image; then
      bad "this is an installed ferry $(ferry_release_version); it already carries the node image"
    else
      bad "this ferry $(ferry_release_version) was packaged without a node image, and a release cannot build one"
      echo "    It needs Docker and a Kubernetes staging step that a release does not carry."
      echo "    Install a release built with one, or build ferry from source:"
    fi
    echo "        git clone https://github.com/imaustink/ferry && cd ferry && ./ferry node-image"
    return 1
  fi
  command -v docker >/dev/null || { bad "docker is required to build the node image"; return 1; }
  docker info >/dev/null 2>&1 || { bad "docker is installed but not running"; return 1; }

  bold "building the mode 2 node image"
  # The node's kubelet has to match the control plane it joins, so the staging
  # step is told which Kubernetes this checkout is on rather than keeping its
  # own default -- the same drift lib/versions.sh exists to prevent.
  local k8s; k8s="$(ferry_active_version)"
  k8s="${k8s:-$K8S_VERSION}"
  echo "  kubernetes $(ferry_control_plane_version "$k8s") inside the node"
  KUBERNETES_VERSION="$(ferry_control_plane_version "$k8s")" \
    "$here/experiments/17-node-vm/stage.sh" || return 1
  echo
  LAYOUT="$NODE_IMAGE_LAYOUT" DISK="$here/node-image/node.ext4" \
    "$here/experiments/18-node-image/build.sh" || return 1
  echo
  bold "node image built"
  echo "  $NODE_IMAGE_LAYOUT"
  echo "  turn mode 2 on with: ferry machines enable"
}

running() { [ -f "$FERRY_RUN/$1.pid" ] && kill -0 "$(cat "$FERRY_RUN/$1.pid")" 2>/dev/null; }

# The version this cluster should be running: what it already is, or -- the
# first time, when it is nothing yet -- what the checkout has built.
cluster_version() {
  local version
  version="$(ferry_cluster_field kubernetes 2>/dev/null)" && [ -n "$version" ] \
    && { echo "$version"; return; }
  version="$(ferry_active_version)"
  echo "${version:-$K8S_VERSION}"
}

# A restart is a restart, not an upgrade.
#
# `ferry build --kubernetes-version` moves the checkout. If the cluster in
# ~/.ferry was last running something else, starting it again has to bring back
# what it was -- otherwise a build quietly becomes an upgrade, which is the
# thing this whole change exists to stop happening by accident.
align_to_cluster_version() {
  local want; want="$(ferry_cluster_field kubernetes 2>/dev/null)" || return 0
  local have; have="$(ferry_active_version)"
  [ -n "$want" ] && [ "$want" != "$have" ] || return 0

  if ! ferry_version_complete "$want"; then
    bad "this cluster last ran $want, and the binaries for it are gone"
    echo "    The checkout is built at ${have:-nothing}. Either build $want back:"
    echo
    echo "        ferry build --kubernetes-version $want"
    echo
    echo "    or start fresh:  ferry down --purge"
    return 1
  fi
  warn "this cluster is $want; the checkout is built at $have"
  # Which way to point depends on the direction. 'apply' refuses to go
  # backwards, so offering it for an older build is offering a command that
  # will decline -- the way back is rollback, and only if this is where the
  # cluster came from.
  if [ -z "$(ferry_skew_reason "$want" "$have")" ]; then
    echo "      Starting it at $want. To move it: ferry upgrade apply $have"
  elif [ "$(ferry_previous_field kubernetes 2>/dev/null)" = "$have" ]; then
    echo "      Starting it at $want. $have is older, so the way back is:"
    echo "      ferry upgrade rollback"
  else
    echo "      Starting it at $want, because $have is older and a control plane"
    echo "      does not go backwards in place."
  fi
  # The control plane's links only. Each node starts at the version it last
  # ran, recorded beside it, so bin/kubelet is not what decides that any more.
  # shellcheck disable=SC2086 # a list of names
  ferry_activate_version "$want" $FERRY_CONTROL_PLANE_BINARIES
}

# Start the four control plane processes at a named version.
#
# Factored out of cmd_up because an upgrade is this same call with a different
# version against the same etcd data directory. Everything the API server
# advertises is derived here rather than passed in, so a restart lands on the
# addresses the runtime actually has now -- which is also what makes it safe to
# call while ferry-cri is still up.
start_control_plane() { # version
  local version="$1"
  local gateway; gateway="$(cat "$FERRY_RUN/cri/gateway" 2>/dev/null)"
  [ -n "$gateway" ] || { bad "the runtime has not published a pod gateway"; return 1; }
  # Advertise the LAN address when there is one: it is the only address a pod on
  # another Mac can reach. Without a network, the pod gateway is still right.
  local advertise="$gateway"
  [ "$LAN_IP" != "127.0.0.1" ] && advertise="$LAN_IP"

  # kube-controller-manager allocates every Node a slice of this, and it has to
  # be the profile's own network. It was never passed, so it fell back to its
  # default of 10.244.0.0/16 while a worktree's pods were on 10.15x -- two
  # different pod networks in one cluster.
  #
  # Mode 1 could not see it: ferry-cri ignores node.spec.podCIDR and carves its
  # own slice from --cluster-cidr and --node-index, so nothing ever read the
  # allocation. Mode 2 does read it -- a machine's kubelet and CNI use exactly
  # that field -- so the first machine in a worktree cluster came up with pods
  # on 10.244.1.x while the Mac's pods were on 10.156.0.x, and kube-proxy was
  # told a third answer.
  K8S_VERSION="$version" \
  STATE="$FERRY_HOME" POD_GATEWAY="$gateway" ADVERTISE="$advertise" NODE_NAME="$NODE_NAME" \
    CLUSTER_CIDR="$CLUSTER_CIDR" \
    API_PORT="$(( 6443 + PORT_SHIFT ))" \
    ETCD_CLIENT_PORT="$(( 2379 + PORT_SHIFT ))" ETCD_PEER_PORT="$(( 2380 + PORT_SHIFT ))" \
    CONTROLLER_PORT="$(( 10257 + PORT_SHIFT ))" SCHEDULER_PORT="$(( 10259 + PORT_SHIFT ))" \
    SERVICE_NODE_PORT_RANGE="$(( 30000 + PROFILE_INDEX * 200 ))-$(( 30199 + PROFILE_INDEX * 200 ))" \
    FERRY_ETCD_NO_FSYNC="$(durability_is_relaxed && echo 1 || true)" \
    FERRY_KEEP_ETCD="${FERRY_KEEP_ETCD:-}" FERRY_HANDOVER="${FERRY_HANDOVER:-}" \
    FERRY_HANDOVER_BIN="$here/bin/ferry-handover" \
    "$here/control-plane/up.sh" >"$FERRY_RUN/logs/control-plane.log" 2>&1
  local rc=$?
  # 3 is up.sh saying the new API server never started and the old one is
  # still serving: nothing was switched, which the caller needs to tell apart
  # from a control plane that is down.
  if [ "$rc" -ne 0 ]; then
    bad "control plane failed"; tail -20 "$FERRY_RUN/logs/control-plane.log" | sed 's/^/    /'
    return "$rc"
  fi
  # The address it actually advertises, which is the LAN address whenever
  # there is one. This used to print the gateway either way, so a cluster whose
  # kubernetes Service pointed at 192.168.1.29 said it was advertising
  # 10.164.0.1, and that is where anyone debugging it would look first.
  ok "control plane $version advertising $advertise"
}

cmd_up() {
  # --durability full|relaxed, remembered for this cluster. Parsed before
  # anything starts, because it decides how etcd and the machine disks are
  # opened and those happen early.
  local want_durability=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --durability) want_durability="${2:-}"; shift 2 ;;
      --durability=*) want_durability="${1#*=}"; shift ;;
      --fast) want_durability=relaxed; shift ;;
      *) shift ;;
    esac
  done
  case "$want_durability" in
    "") ;;
    full|relaxed) : ;;
    *) bad "--durability $want_durability: expected 'full' or 'relaxed'"; return 2 ;;
  esac

  for required in "$here/bin/kubelet" "$here/bin/ferry-cri" "$here/bin/ferry-cni" "$KERNEL"; do
    [ -e "$required" ] || { bad "missing $(basename "$required") -- run: ferry build"; return 1; }
  done
  if running ferry-cri || running kubelet; then
    warn "ferry is already up; run 'ferry down' first"; return 1
  fi
  align_to_cluster_version || return 1

  mkdir -p "$FERRY_HOME" "$FERRY_RUN"/{kubelet,pki,podlogs,containerlogs,volume-plugins,logs}
  rm -f "$FERRY_SOCK" "$FERRY_EXEC_SOCK" "$FERRY_STREAMER_SOCK" "$FERRY_PROXYD_SOCK" "$FERRY_GPUD_SOCK"
  # This cluster is wanted again, so the login agent should treat its next
  # disappearance as a failure rather than as an intention.
  clear_stopped
  # Which kind of node this Mac is, for the login agent to read after a reboot.
  # A server can be started again from FERRY_HOME alone; a worker cannot.
  echo server > "$FERRY_HOME/role"
  [ -n "$want_durability" ] && printf '%s\n' "$want_durability" > "$DURABILITY_MARKER"

  bold "starting ferry"
  # Said every time, not only when it changes: someone reading this scrollback
  # to work out why a cluster lost data should not have to remember which day
  # they passed the flag.
  if durability_is_relaxed; then
    warn "durability: relaxed -- writes are acknowledged before they reach the disk"
    echo "      Fine for a cluster you recreate. A hard power loss can leave"
    echo "      etcd needing a restore. 'ferry up --durability full' to change it."
  fi

  start_gpud

  FERRY_VERSION="$(ferry_runtime_version)" "$here/bin/ferry-cri" \
    --endpoint "$FERRY_SOCK" --state "$FERRY_RUN/cri" --kernel "$KERNEL" \
    --pod-subnet "$POD_SUBNET" --pod-cpus "$POD_CPUS" --pod-memory-mib "$POD_MEMORY_MIB" \
    --exec-socket "$FERRY_EXEC_SOCK" --streamer-control "$FERRY_STREAMER_SOCK" \
    --nft-bundle "$here/guest/nft" --proxyd-socket "$FERRY_PROXYD_SOCK" \
    --netpol-socket "$FERRY_NETPOL_SOCK" --gpud-socket "$FERRY_GPUD_SOCK" \
    --cni "$here/bin/ferry-cni" \
    --cni-host-plugins "$here/ferry-cni/plugins/host" \
    --cni-guest-plugins "$here/ferry-cni/plugins/guest" \
    ${FERRY_CNI_CONFLIST:+--cni-conflist "$FERRY_CNI_CONFLIST"} \
    --cluster-cidr "$CLUSTER_CIDR" --node-index "$NODE_INDEX" \
    --relay-port "$RELAY_PORT" --peers "$PEERS" \
    --machine-switch "127.0.0.1:$MACHINE_RELAY_PORT" \
    --peers-file "$PEERS_FILE" --relay-endpoint "$LAN_IP:$RELAY_PORT" \
    $(image_mirror_flag) \
    >"$FERRY_RUN/logs/ferry-cri.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-cri.pid"

  # Ninety seconds, unless ferry-cri says it is waiting for its slice -- then
  # longer, because that wait is deliberately slow.
  #
  # A refused vmnet create renews the reservation it was refused by
  # (experiment 22), so the only way to outlast one is to ask rarely: two or
  # three asks, ninety-five seconds apart. That is longer than a startup wait
  # should normally be, and giving every failure the same budget would mean
  # four minutes of silence for a ferry-cri that was never going to start. So
  # the budget grows only once ferry-cri has said what it is doing.
  local ready= waited=0 limit=90
  while [ "$waited" -lt "$limit" ]; do
    if [ -S "$FERRY_SOCK" ] && grep -q "serving" "$FERRY_RUN/logs/ferry-cri.log" 2>/dev/null; then ready=1; break; fi
    running ferry-cri || break
    if grep -q "waiting for .*slice" "$FERRY_RUN/logs/ferry-cri.log" 2>/dev/null; then limit=260; fi
    sleep 1
    waited=$(( waited + 1 ))
  done
  # Show the whole failure, not the last five lines of it. ferry-cri explains
  # some of these at length -- a refused pod subnet takes a paragraph to say
  # properly -- and a truncated explanation is worse than none.
  if [ -z "$ready" ]; then
    bad "runtime failed to start"
    local log="$FERRY_RUN/logs/ferry-cri.log"
    if grep -q '^failed to prepare runtime' "$log" 2>/dev/null; then
      sed -n '/^failed to prepare runtime/,$p' "$log" | sed 's/^/    /'
    else
      tail -5 "$log" | sed 's/^/    /'
    fi
    return 1
  fi
  ok "runtime on $(grep -oE 'network .*' "$FERRY_RUN/logs/ferry-cri.log" | tail -1)"
  # Alone, ferry-cri takes another vmnet subnet rather than wait a minute or more
  # for its own slice to be released. That is survivable, but it is a different
  # pod network from the one 'ferry profile' names, and pods that were created
  # before it keep addresses on the old one until they are recreated. Said as a
  # warning, because an `ok` line with a new gateway in it is easy to read past.
  if grep -q "is still reserved by a recent run" "$FERRY_RUN/logs/ferry-cri.log" 2>/dev/null; then
    warn "$(grep -oE '[0-9./]+ is still reserved by a recent run; using [0-9./]+' "$FERRY_RUN/logs/ferry-cri.log" | tail -1)"
    echo "      Pods run off this profile's pod network ($CLUSTER_CIDR) until the next"
    echo "      restart that gets it back. Existing pods keep their old addresses"
    echo "      until they are recreated. Waiting a minute before 'ferry up' avoids it."
  fi

  # The API server must advertise the gateway of the subnet the runtime actually
  # obtained, which is not always the one requested -- vmnet networks can stay
  # claimed by an earlier run.
  local gateway; gateway="$(cat "$FERRY_RUN/cri/gateway" 2>/dev/null)"
  [ -n "$gateway" ] || { bad "runtime did not publish a pod gateway"; return 1; }
  # The runtime reserves an address for cluster DNS before any pod can take it,
  # so the kubelet can be told where DNS will be before CoreDNS exists.
  local dns; dns="$(cat "$FERRY_RUN/cri/dns" 2>/dev/null)"

  start_control_plane "$(cluster_version)" || return 1

  # kubectl exec arrives as SPDY, which ferry-streamer terminates before
  # handing the request to ferry-cri. It has to be up first, because ferry-cri
  # asks it for streaming URLs.
  if [ -x "$here/bin/ferry-streamer" ]; then
    "$here/bin/ferry-streamer" --listen "$FERRY_STREAM_ADDR" \
      --exec-socket "$FERRY_EXEC_SOCK" --control "$FERRY_STREAMER_SOCK" \
      --kubeconfig "$FERRY_HOME/admin.conf" \
      --node-name "$NODE_NAME" --relay-endpoint "$LAN_IP:$RELAY_PORT" \
      --peers-file "$PEERS_FILE" --gpud-socket "$FERRY_GPUD_SOCK" \
      >"$FERRY_RUN/logs/ferry-streamer.log" 2>&1 &
    echo $! > "$FERRY_RUN/ferry-streamer.pid"
    ferry_await 15 test -S "$FERRY_STREAMER_SOCK"
    [ -S "$FERRY_STREAMER_SOCK" ] && ok "streaming server on $FERRY_STREAM_ADDR" \
      || warn "streaming server did not start; kubectl exec will not work"
  else
    warn "ferry-streamer not built; kubectl exec will not work"
  fi

  cat > "$FERRY_RUN/kubelet.yaml" <<EOF
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
port: $(( 10250 + PORT_SHIFT ))
healthzPort: $(( 10248 + PORT_SHIFT ))
podLogsDir: $FERRY_RUN/podlogs
containerRuntimeEndpoint: unix://$FERRY_SOCK
imageServiceEndpoint: unix://$FERRY_SOCK
volumePluginDir: $FERRY_RUN/volume-plugins
kubeAPIQPS: $FERRY_KUBE_API_QPS
kubeAPIBurst: $FERRY_KUBE_API_BURST
# The upstream hard-eviction defaults are sized for small cloud nodes; on a
# laptop disk imagefs.available<15% means holding tens of gigabytes idle or the
# node taints itself NoSchedule.
evictionHard:
  memory.available: "$EVICT_MEMORY"
  nodefs.available: "$EVICT_DISK"
  imagefs.available: "$EVICT_DISK"
  nodefs.inodesFree: "5%"
# Image GC is keyed off the same percentage of the same disk, and imagefs here is
# the Mac's whole data volume, not a disk sized to the cluster: a Mac 90% full of
# photos looks like 90% images, so kubelet deletes every idle image every five
# minutes chasing a number images cannot move. A loaded image has no registry
# to come back from. Disk pressure is left to imagefs.available above.
imageGCHighThresholdPercent: 100
imageGCLowThresholdPercent: 99
maxPods: $MAX_PODS
cgroupsPerQOS: false
enforceNodeAllocatable: []
failSwapOn: false
readOnlyPort: 0
clusterDomain: $CLUSTER_DOMAIN
${dns:+clusterDNS: [$dns]}
# A pod is a VM here, and a VM takes longer to appear than a container does.
runtimeRequestTimeout: 10m
authentication:
  x509: {clientCAFile: $FERRY_HOME/pki/ca.crt}
  anonymous: {enabled: false}
  webhook: {enabled: true}
authorization: {mode: Webhook}
EOF

  start_kubelet "$NODE_NAME" "$FERRY_RUN" "$FERRY_HOME/kubelet.conf" \
    "$FERRY_RUN/kubelet.pid" "$FERRY_RUN/logs/kubelet.log" "" "$NODE_INDEX"

  export KUBECONFIG="$FERRY_HOME/admin.conf"
  for _ in $(seq 1 60); do
    [ "$(kubectl get node "$NODE_NAME" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ] && break
    running kubelet || break
    sleep 1
  done
  if [ "$(kubectl get node "$NODE_NAME" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ]; then
    ok "node $NODE_NAME Ready"
    ensure_mode_label "$NODE_NAME"
  else
    bad "node did not become Ready"; tail -5 "$FERRY_RUN/logs/kubelet.log"; return 1
  fi

  if [ -x "$here/bin/ferry-proxyd" ]; then
    : > "$FERRY_RUN/logs/ferry-proxyd.log"
    start_proxyd "$FERRY_HOME/admin.conf" "$gateway" \
      && ok "Service rules rendered by kube-proxy $(ferry_proxyd_version 2>/dev/null)" \
      || warn "ferry-proxyd did not start; Services will not route"
  fi

  start_netpol
  start_proxy
  start_storage
  # Before machines, so a cluster whose machines fail to start still shares
  # its images between nodes; start_machines starts it again with the subnet
  # ferry-node actually claimed.
  start_registry "$(machines_enabled && echo "$MACHINE_SUBNET")"
  advertise_gpu
  if [ -n "$dns" ]; then install_dns "$gateway" "$dns"; fi

  # Mode 2, for a cluster that asked for it. After the node is Ready, because
  # ferry-machined reads the Node list to work out each machine's pod CIDR.
  if machines_enabled; then
    if ! start_machines; then
      warn "machines did not start; mode 1 is unaffected"
      echo "      ferry machines status"
    fi
  fi

  echo
  bold "ferry is up"
  echo "  export KUBECONFIG=$FERRY_HOME/admin.conf"
  echo "  ferry kubeconfig --merge      to put it in ~/.kube/config instead"
  echo "  ferry token create            to add another Mac to this cluster"
}

# NetworkPolicy, enforced where the packets are.
#
# A policy is per pod, and every ferry pod is a virtual machine with its own
# kernel, so the rules are worked out here and applied there -- the same way
# Service rules already reach a pod. Without this, policies were accepted and
# silently ignored, which is worse than not supporting them.
start_netpol() {
  [ -x "$here/bin/ferry-netpol" ] || { warn "ferry-netpol not built; NetworkPolicies will be ignored"; return 0; }
  rm -f "$FERRY_NETPOL_SOCK"
  "$here/bin/ferry-netpol" --kubeconfig "$FERRY_HOME/admin.conf" \
    --socket "$FERRY_NETPOL_SOCK" --cluster-cidr "$CLUSTER_CIDR" \
    >"$FERRY_RUN/logs/ferry-netpol.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-netpol.pid"
  ferry_await 15 test -S "$FERRY_NETPOL_SOCK"
  [ -S "$FERRY_NETPOL_SOCK" ] && ok "NetworkPolicies enforced in the pods" \
    || warn "ferry-netpol did not start; NetworkPolicies will be ignored"
}

# The Mac's GPU, offered to pods over a socket.
#
# There is no GPU pass-through on Apple silicon: Virtualization.framework has no
# PCI passthrough and no compute device, and Metal is reachable only from a
# macOS process. So the work does not move into the pod -- ferry-gpud holds the
# GPU here, and a pod that asks for ferry.dev/gpu is handed a unix socket to it,
# relayed into its VM over vsock. See docs/GPU.md.
start_gpud() {
  [ -x "$here/bin/ferry-gpud" ] || { warn "ferry-gpud not built; ferry.dev/gpu will not be offered"; return 0; }
  rm -f "$FERRY_GPUD_SOCK"
  # The directory is the daemon's to create -- it makes it 0700, and doing it
  # here first would leave it 0755 until the daemon caught up.
  # Pod sockets from a previous run are stale the moment that process is gone.
  # ...and the record of who held them: this is a fresh cluster, so the daemon
  # must not restore grants for pods from the last one.
  [ -n "$FERRY_GPU_DIR" ] && rm -f "$FERRY_GPU_DIR"/*.sock "$FERRY_GPU_DIR/grants.json" 2>/dev/null || true
  "$here/bin/ferry-gpud" --control "$FERRY_GPUD_SOCK" \
    --socket-dir "$FERRY_GPU_DIR" --capacity "$GPU_CAPACITY" \
    --time-slice "$GPU_SLICE" \
    >"$FERRY_RUN/logs/ferry-gpud.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-gpud.pid"
  ferry_await 15 test -S "$FERRY_GPUD_SOCK"
  if [ -S "$FERRY_GPUD_SOCK" ]; then
    ok "GPU offered to pods: $(sed -n 's/.*device  *//p' "$FERRY_RUN/logs/ferry-gpud.log" | head -1)"
  else
    warn "ferry-gpud did not start; ferry.dev/gpu will not be offered"
  fi
}

# Advertise the GPU as a schedulable resource.
#
# No device plugin is involved. The kubelet merges into node.status.capacity
# rather than replacing it -- "avoid blindly overwriting the capacity in case
# opaque resources are being advertised" -- so this sticks, and the scheduler
# gates on it. The number is how many pods may hold the GPU at once, not how
# many GPUs there are; there is one.
advertise_gpu() { # node-name [kubeconfig]
  local node="${1:-$NODE_NAME}"
  [ -S "$FERRY_GPUD_SOCK" ] || return 0

  # Whichever credential this machine has. A joined node has no admin.conf --
  # only the certificate the cluster issued its kubelet.
  local cfg="${2:-}"
  if [ -z "$cfg" ]; then
    if [ -r "$FERRY_HOME/admin.conf" ]; then cfg="$FERRY_HOME/admin.conf"
    elif [ -r "$FERRY_RUN/kubelet.conf" ]; then cfg="$FERRY_RUN/kubelet.conf"
    else warn "no kubeconfig to advertise ferry.dev/gpu with"; return 0; fi
  fi

  # Written with curl rather than kubectl, and that is the whole fix.
  #
  # A node may update its own status -- its kubelet does nothing else all day --
  # but it may not *get* nodes/status, which the Node authorizer scopes to the
  # object rather than the subresource. kubectl fetches before it patches, even
  # for a merge patch, so it was refused at the first step on every joined node
  # and the GPU was only ever offered by the Mac that had the admin kubeconfig.
  #
  # Sending the patch directly asks for exactly the permission the node has.
  local server cert key
  server="$(sed -n 's|.*server: *||p' "$cfg" | head -1)"
  cert="$(sed -n 's|.*client-certificate: *||p' "$cfg" | head -1)"
  key="$(sed -n 's|.*client-key: *||p' "$cfg" | head -1)"
  [ -n "$server" ] || { warn "could not read the API server address from $cfg"; return 0; }

  local auth=()
  if [ -n "$cert" ] && [ -n "$key" ]; then
    auth=(--cert "$cert" --key "$key")
  else
    # admin.conf embeds its credentials, and kubectl is present wherever that is.
    command -v kubectl >/dev/null 2>&1 || { warn "no usable credential for ferry.dev/gpu"; return 0; }
    if KUBECONFIG="$cfg" kubectl patch node "$node" --subresource=status --type=merge \
         -p "{\"status\":{\"capacity\":{\"ferry.dev/gpu\":\"$GPU_CAPACITY\"}}}" >/dev/null 2>&1; then
      ok "node advertises ferry.dev/gpu: $GPU_CAPACITY"
    else
      warn "could not advertise ferry.dev/gpu on $node"
    fi
    return 0
  fi

  local code
  code="$(curl -sk --max-time 15 -o /dev/null -w '%{http_code}' "${auth[@]}" \
    -X PATCH -H "Content-Type: application/merge-patch+json" \
    -d "{\"status\":{\"capacity\":{\"ferry.dev/gpu\":\"$GPU_CAPACITY\"}}}" \
    "$server/api/v1/nodes/$node/status" 2>/dev/null)"
  if [ "$code" = "200" ]; then
    ok "node advertises ferry.dev/gpu: $GPU_CAPACITY"
  else
    warn "could not advertise ferry.dev/gpu on $node (HTTP ${code:-no response})"
  fi
}

# Take ferry.dev/gpu off the node. Best effort and deliberately quiet: the
# control plane may already be gone, which is not worth a warning during
# shutdown.
withdraw_gpu() {
  command -v kubectl >/dev/null 2>&1 || return 0
  [ -f "$FERRY_HOME/admin.conf" ] || return 0
  local op='[{"op":"remove","path":"/status/capacity/ferry.dev~1gpu"}]'
  KUBECONFIG="$FERRY_HOME/admin.conf" kubectl patch node "$NODE_NAME" \
    --subresource=status --type=json -p "$op" >/dev/null 2>&1 || true
}

# Somewhere for a PersistentVolumeClaim to live.
#
# A volume is a directory on this Mac, handed to the pod as a virtiofs share --
# the same mechanism every other ferry mount uses. That makes it local to one
# machine, so the volume carries node affinity and binding waits for the
# scheduler to choose a node.
# Mode 2's two daemons.
#
# ferry-node serve holds the one vmnet network and boots a VM for every spec
# that appears in the machines directory; ferry-machined watches Machine objects
# and writes those specs. The split is the one ferry already uses between
# ferry-streamer and ferry-cri: the thing that talks to Kubernetes is Go beside
# the control plane, and the thing that makes VMs is Swift with the
# virtualization entitlement.
#
# The network belongs to the process that created it, which is why serve is a
# server rather than a flag -- experiment 20 found that out the hard way.
# Say which mode a node on this Mac is, for a node that already exists.
#
# start_kubelet passes --node-labels, but the kubelet only applies those when it
# *creates* the Node object. A cluster that predates this label therefore never
# gets it: ferry's own node had been in etcd for days, so it came back Ready and
# unlabelled while a freshly made machine was labelled correctly, and
# `nodeSelector: {ferry.dev/mode: vm-per-pod}` matched nothing at all.
#
# So the label is also asserted here, once the node is Ready. --overwrite
# because the answer is not the node's to disagree about: a node ferry started
# runs ferry-cri, which is vm-per-pod by construction.
ensure_mode_label() { # node
  kube label node "$1" ferry.dev/mode=vm-per-pod --overwrite >/dev/null 2>&1 \
    || warn "could not label $1 ferry.dev/mode=vm-per-pod; nodeSelector will not match it"
  # Which Mac's disk this node's volumes are on. ferry-machined gives each
  # machine the same label, naming the Mac it runs on, and a directory volume
  # is pinned to that label rather than to one node: it is the same directory
  # on the Mac and in every machine the Mac runs, so its pod can move between
  # them. See ferry-storage.
  kube label node "$1" "ferry.dev/host=$NODE_NAME" --overwrite >/dev/null 2>&1 || true
}

start_machines() {
  machines_ready || return 1

  # The CRD and the DNS objects live in etcd, so `ferry down --purge` takes them
  # with the rest of the cluster while the enabled marker -- which is a file --
  # survives. Restarting then ran the controller against a cluster with no
  # Machine kind, logging errors forever at a cluster that looked fine. Both
  # applies are idempotent, so doing them on every start costs a moment and
  # removes the difference between a cluster that was enabled and one that was
  # enabled, purged and brought back.
  kube apply -f "$here/ferry-machined/crd.yaml" >/dev/null 2>&1 \
    || { bad "could not install the Machine CRD"; return 1; }
  install_machine_dns || return 1

  mkdir -p "$FERRY_HOME/machined" "$FERRY_RUN/machines"
  # Shared into every machine at boot, so it has to exist before the first one;
  # ferry-storage makes it too, but may not have run yet.
  mkdir -p "$FERRY_HOME/volumes"

  # The machine's disk barrier follows the cluster's durability, so mode 2
  # does not quietly keep a guarantee mode 1 gave up -- or lose one it kept.
  #
  # Keep these assignments directly above the command. A comment or a command
  # between them and it ends the line, and they become shell variables that
  # ferry-node never sees -- which is how FERRY_NODE_DISK_SYNC once stopped
  # reaching it without anything failing.
  #
  # The registry port is passed only when the registry is on, and blank
  # otherwise, so a FERRY_MACHINE_REGISTRY_PORT set on its own does not point
  # machines at a registry that is not running.
  FERRY_NODE_DISK_SYNC="$(durability_is_relaxed && echo none || echo fsync)" \
  FERRY_NODE_REGISTRY_PORT="$(machine_registry_enabled && echo "$MACHINE_REGISTRY_PORT")" \
  FERRY_NODE_USB="$(kernel_attaches_disks && echo 1)" \
  "$here/bin/ferry-node" serve \
    --dir "$FERRY_RUN/machines" --kernel "$KERNEL" \
    --ca "$FERRY_HOME/pki/ca.crt" \
    --api-server "https://$LAN_IP:$(( 6443 + PORT_SHIFT ))" \
    --subnet "$MACHINE_SUBNET" \
    --cluster-dns "$MACHINE_DNS_IP" \
    --cluster-cidr "$CLUSTER_CIDR" \
    --switch-port "$MACHINE_RELAY_PORT" --switch-peer "127.0.0.1:$RELAY_PORT" \
    --volumes "$FERRY_HOME/volumes" \
    >"$FERRY_RUN/logs/ferry-node.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-node.pid"
  local _
  for _ in $(seq 1 60); do
    grep -aq "network" "$FERRY_RUN/logs/ferry-node.log" 2>/dev/null && break
    running ferry-node || break
    sleep 0.5
  done
  if ! running ferry-node; then
    # vmnet's own words for "that subnet is still spoken for" are
    # `vmnet_return_t(rawValue: 1001)`, which tells nobody anything. ferry-cri
    # already explains this case in prose when it hits it; ferry-node reports
    # the raw status, so it is translated here rather than left to be
    # rediscovered. It is the ordinary consequence of restarting quickly: the
    # subnet is held for about a minute after the last run let it go.
    if grep -aq "1001" "$FERRY_RUN/logs/ferry-node.log" 2>/dev/null; then
      bad "the machine network $MACHINE_SUBNET is still held from a recent run"
      echo "    vmnet keeps a subnet for about a minute after the process using it"
      echo "    stops, so this usually clears on its own:"
      echo "        ferry machines enable      # once it does"
      echo "    Mode 1 is unaffected, and the Machines already declared come back"
      echo "    with it. FERRY_MACHINE_SUBNET picks a different one."
    else
      bad "ferry-node serve did not start"
      tail -5 "$FERRY_RUN/logs/ferry-node.log" 2>/dev/null | sed 's/^/    /'
    fi
    return 1
  fi
  # What ferry-node actually claimed, which is not always what it was asked for.
  actual_subnet=$(grep -a 'network' "$FERRY_RUN/logs/ferry-node.log" | head -1 | sed 's/.*network *//' | awk -F, '{print $1}' | tr -d ' ')
  ok "machine network $(grep -a 'network' "$FERRY_RUN/logs/ferry-node.log" | head -1 | sed 's/.*network //')"
  # Remembered so the next start asks for the one that worked, not the default.
  [ -n "$actual_subnet" ] && printf '%s' "$actual_subnet" > "$MACHINE_SUBNET_FILE"

  start_registry "${actual_subnet:-$MACHINE_SUBNET}"

  "$here/bin/ferry-machined" \
    --kubeconfig "$FERRY_HOME/admin.conf" --kernel "$KERNEL" \
    --image "$NODE_DISK" --state "$FERRY_HOME/machined" \
    --machines "$FERRY_RUN/machines" \
    --api-server "https://$LAN_IP:$(( 6443 + PORT_SHIFT ))" \
    --ca "$FERRY_HOME/pki/ca.crt" --host-node "$NODE_NAME" \
    >"$FERRY_RUN/logs/ferry-machined.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-machined.pid"
  sleep 1
  if running ferry-machined; then
    ok "machines reconciling -- kubectl apply -f <machine.yaml>"
  else
    bad "ferry-machined did not start"
    tail -5 "$FERRY_RUN/logs/ferry-machined.log" 2>/dev/null | sed 's/^/    /'
    return 1
  fi

  start_provisioner
}

# The images this Mac has, served to its nodes, its machines and the other
# Macs. See ferry-registry/main.go and peers.go.
#
# On every interface, answering only the machine subnet and loopback: the store
# holds whatever was built here, and there is no reason to offer it to the LAN.
# Not bound to the gateway, which machines reach it at, because vmnet only
# gives the Mac that address while a machine is attached -- binding it failed
# with "can't assign requested address" on every start, before the first
# machine had booted. Not fatal: nodes and machines without it fall through to
# the real registries, which is how they worked before it existed.
#
# The other Macs get a port of their own, over TLS, and both ends present the
# node's kubelet certificate: only a node of this cluster is answered there,
# and a pod has no such certificate. Which Macs they are comes from the peers
# file ferry-streamer already keeps.
#
# Started again when machines come up, to add their subnet, which is only known
# once ferry-node has claimed one.
start_registry() { # [machine-subnet]
  machine_registry_enabled || return 0
  [ -x "$here/bin/ferry-registry" ] || {
    warn "bin/ferry-registry is missing -- run 'ferry build'; loaded images stay on the node they were loaded on"
    return 0; }
  local kubeconfig="$FERRY_HOME/kubelet.conf"
  [ -f "$FERRY_RUN/kubelet.conf" ] && kubeconfig="$FERRY_RUN/kubelet.conf"
  if running ferry-registry; then
    local pid; pid="$(cat "$FERRY_RUN/ferry-registry.pid")"
    kill -TERM "$pid" 2>/dev/null
    ferry_await_exit "$pid" || kill -KILL "$pid" 2>/dev/null
    rm -f "$FERRY_RUN/ferry-registry.pid"
  fi
  mkdir -p "$REGISTRY_DIR"
  "$here/bin/ferry-registry" serve --store "$REGISTRY_DIR" \
    --listen "0.0.0.0:$MACHINE_REGISTRY_PORT" --allow "${1:-}" \
    --peer-listen "0.0.0.0:$REGISTRY_PEER_PORT" --kubeconfig "$kubeconfig" \
    --peers-file "$PEERS_FILE" --peer-port "$REGISTRY_PEER_PORT" --self "$LAN_IP" \
    >>"$FERRY_RUN/logs/ferry-registry.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-registry.pid"
  ferry_await 3 curl -sf "http://127.0.0.1:$MACHINE_REGISTRY_PORT/v2/"
  if running ferry-registry; then
    ok "registry on port $MACHINE_REGISTRY_PORT, other Macs on $REGISTRY_PEER_PORT ($(machine_registry_count) images)"
  else
    rm -f "$FERRY_RUN/ferry-registry.pid"
    warn "ferry-registry did not start; loaded images stay on the node they were loaded on"
    tail -2 "$FERRY_RUN/logs/ferry-registry.log" 2>/dev/null | sed 's/^/      /'
  fi
}

machine_registry_count() {
  "$here/bin/ferry-registry" list --store "$REGISTRY_DIR" 2>/dev/null | wc -l | tr -d ' '
}

# Karpenter, with ferry as its cloud provider: machines made for pods that have
# nowhere to run, and taken away when they are empty.
#
# This is what lets mode 2 stop asking anybody to size a node. Without it, using
# mode 2 means declaring a Machine and choosing its shape before knowing the
# workload -- which is the bargain ferry exists to avoid, and the reason mode 1
# is still the default.
#
# It runs here, natively, rather than as a pod in the cluster it provisions for.
# docs/MACHINES.md listed "Karpenter runs as a pod" as an argument against using
# it; Karpenter v1 is a library with no webhooks, and ferry already runs its
# controllers as macOS processes. Out of cluster there is no chicken and egg
# where the thing that makes nodes needs a node, and no Linux image to publish.
start_provisioner() {
  [ -x "$here/bin/ferry-karpenter" ] || {
    warn "ferry-karpenter not built; machines must be declared by hand"
    return 0; }

  # Karpenter's own CRDs, and the NodePool that points at ferry. Applied on
  # every start for the same reason the Machine CRD is: 'ferry down --purge'
  # takes them with the cluster while the enabled marker survives.
  # The CRDs before the objects that use them, and waited for.
  #
  # `kubectl apply -f <dir>` applies in alphabetical order, so a NodePool named
  # default-nodepool.yaml is sent before the CRD that defines its kind and the
  # whole apply fails. It then succeeds on the next attempt -- the CRDs from the
  # failed run are there by now -- which is the worst version of the bug,
  # because "run it twice" hides it.
  local dir="$here/manifests/machines/karpenter"
  if [ -d "$dir/crds" ]; then
    kube apply -f "$dir/crds" >/dev/null 2>&1 \
      || { warn "could not install Karpenter's CRDs; machines must be declared by hand"; return 0; }
    # Established, not merely created: the API server needs a moment before it
    # will accept an object of a kind it has just learned.
    kube wait --for condition=established --timeout=60s \
      crd/nodepools.karpenter.sh crd/nodeclaims.karpenter.sh \
      crd/ferrynodeclasses.ferry.dev >/dev/null 2>&1 \
      || { warn "Karpenter's CRDs did not establish; machines must be declared by hand"; return 0; }
    kube apply -f "$dir/default-nodepool.yaml" >/dev/null 2>&1 \
      || { warn "could not install the default NodePool; machines must be declared by hand"; return 0; }
  fi

  # Settings through the environment, the command line left to Karpenter.
  #
  # Its operator parses os.Args with its own flag set and exits on an argument
  # it does not recognise, so `--kubeconfig` of ferry's own does not collide --
  # it stops the process starting at all. KUBECONFIG is how controller-runtime
  # finds a cluster from outside one, which is what this is.
  #
  # Leader election off: it is one process on one Mac, and the lease it would
  # take is a cluster object ferry would then have to clean up.
  # --health-probe-port is shifted with every other port this profile uses.
  # Karpenter defaults it to 8081, which is not shifted, so a second ferry on
  # the same Mac finds it taken and the process panics on startup --
  # "bind: address already in use", reported as "ferry-karpenter did not
  # start; machines must be declared by hand", 4.6s into `machines enable`.
  # Found with a stray karpenter from an earlier run holding the port, which
  # is the same shape as the default-profile etcd that docs/BENCHMARKING.md
  # warns about.
  #
  # Nothing may come between these assignments and the command they prefix.
  # A comment here does not interrupt the line continuation -- it swallows
  # the rest of the line, so the assignments become an ordinary shell
  # statement and the binary runs with none of them in its environment. That
  # is exactly what happened when this comment was first written in the gap
  # below, and it silently dropped karpenter's machine limits and node disk.
  KUBECONFIG="$FERRY_HOME/admin.conf" \
  FERRY_MACHINE_LIMIT_CPUS="$MACHINE_LIMIT_CPUS" \
  FERRY_MACHINE_LIMIT_MEMORY_GI="$MACHINE_LIMIT_MEMORY_GI" \
  FERRY_MACHINE_MAX_MEMORY_GI="$MACHINE_LIMIT_MEMORY_GI" \
  FERRY_NODE_DISK="$NODE_DISK" \
  "$here/bin/ferry-karpenter" \
    --disable-leader-election \
    --metrics-port 0 \
    --health-probe-port "$(( 8081 + PORT_SHIFT ))" \
    >"$FERRY_RUN/logs/ferry-karpenter.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-karpenter.pid"
  sleep 2
  if running ferry-karpenter; then
    ok "provisioning on demand, up to $MACHINE_LIMIT_CPUS cpus and ${MACHINE_LIMIT_MEMORY_GI}Gi of machines"
    echo "      a pod with nodeSelector ferry.dev/mode=shared makes the node it needs"
  else
    warn "ferry-karpenter did not start; machines must be declared by hand"
    tail -3 "$FERRY_RUN/logs/ferry-karpenter.log" 2>/dev/null | sed 's/^/      /'
  fi
}

# Everything mode 2 needs before it can start, checked in the order that gives
# the most useful answer first.
machines_ready() {
  local binary
  for binary in ferry-machined ferry-node; do
    [ -x "$here/bin/$binary" ] || {
      bad "bin/$binary is missing -- run 'ferry build'"
      return 1; }
  done
  [ -d "$NODE_IMAGE_LAYOUT" ] || {
    bad "no node image at $NODE_IMAGE_LAYOUT"
    if is_release; then
      echo "    This release was packaged without one. Mode 2 needs a release built"
      echo "    with 'ferry node-image'; mode 1 is unaffected."
    else
      echo "    Build it: ferry node-image   (slow, needs docker)"
    fi
    return 1; }
  # Unpacked from the layout the release carries, and re-unpacked when that
  # layout changes. Doing it here rather than at install time keeps the cost off
  # every Mac that never uses mode 2.
  #
  # The stamp is what makes `ferry node-image` mean anything on a Mac that has
  # already run mode 2 once. This used to unpack only when $NODE_DISK was
  # missing, so rebuilding the node image left the old disk in place and the
  # next machine booted the image the user thought they had just replaced --
  # silently, because everything still works, just not with their changes in it.
  local stamp="$NODE_DISK.layout"
  local want; want="$(node_layout_id)"
  if [ ! -f "$NODE_DISK" ] || [ "$(cat "$stamp" 2>/dev/null)" != "$want" ]; then
    # Not while ferry-machined is running. This function is reached before the
    # "already running" check below, so re-running 'ferry machines enable' after
    # 'ferry node-image' would replace the file the controller clones every new
    # machine's disk from, and a machine created during the rebuild would be
    # cloned from a partial one. It boots to nothing and the size check that
    # guards a machine's disk cannot tell.
    if [ -f "$NODE_DISK" ] && running ferry-machined; then
      warn "the node image changed, but machines are running; keeping the current node disk"
      echo "    Replacing it now would hand a half-written file to any machine"
      echo "    created while it is being written. Take machines down first:"
      echo "        ferry machines disable && ferry machines enable"
      return 0
    fi
    local rebuilt=no
    if [ -f "$NODE_DISK" ]; then
      rebuilt=yes
      echo "  the node image changed; unpacking it again (~400MB)"
    else
      echo "  unpacking the node image (once, ~400MB)"
    fi
    # Unpacked beside the real path and moved into place, so a failure -- a bad
    # layout, or $HOME with less than ~400MB left -- leaves the working disk
    # exactly where it was. ferry-node removes --out before it writes, so
    # unpacking straight onto $NODE_DISK would destroy the only copy first and
    # then fail, with the layout that just failed as the only way back.
    local tmp="$NODE_DISK.unpacking.$$"
    rm -f "$tmp"
    "$here/bin/ferry-node" build --layout "$NODE_IMAGE_LAYOUT" --out "$tmp" \
      >"$FERRY_RUN/logs/ferry-node-build.log" 2>&1 || {
        bad "could not unpack the node image"
        tail -5 "$FERRY_RUN/logs/ferry-node-build.log" 2>/dev/null | sed 's/^/    /'
        rm -f "$tmp"
        [ -f "$NODE_DISK" ] && echo "    The node disk already there was left alone."
        return 1; }
    mv -f "$tmp" "$NODE_DISK" || {
      bad "could not put the unpacked node disk at $NODE_DISK"
      rm -f "$tmp"
      return 1; }
    # After the move: a crash between the two leaves the stamp naming the old
    # layout, which asks for another unpack rather than trusting a disk nobody
    # confirmed.
    printf '%s' "$want" > "$stamp"
    ok "node disk at $NODE_DISK"
    # Only new machines. ferry-machined adopts an existing Machine's disk as it
    # is rather than re-cloning it, so a machine declared before this rebuild
    # keeps booting the old image until it is deleted and applied again.
    if [ "$rebuilt" = yes ]; then
      echo "      machines that already exist keep their own disk; delete and"
      echo "      re-apply a Machine to put it on this image"
    fi
  fi
}

# Identifies the OCI layout the node disk was unpacked from. index.json carries
# the manifest digest, so it changes whenever the image does and not otherwise.
node_layout_id() {
  shasum -a 256 "$NODE_IMAGE_LAYOUT/index.json" 2>/dev/null | awk '{print $1}'
}

start_storage() {
  [ -x "$here/bin/ferry-storage" ] || { warn "ferry-storage not built; PersistentVolumeClaims will stay Pending"; return 0; }
  "$here/bin/ferry-storage" --kubeconfig "$FERRY_HOME/admin.conf" \
    --node-name "$NODE_NAME" --root "$FERRY_HOME/volumes" \
    $(kernel_attaches_disks && echo "--block-class $BLOCK_CLASS") \
    >"$FERRY_RUN/logs/ferry-storage.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-storage.pid"
  for _ in $(seq 1 30); do
    grep -q "serving" "$FERRY_RUN/logs/ferry-storage.log" 2>/dev/null && break
    sleep 0.5
  done
  if grep -q "serving" "$FERRY_RUN/logs/ferry-storage.log" 2>/dev/null; then
    ok "PersistentVolumeClaims bind to $FERRY_HOME/volumes"
    kernel_attaches_disks && machines_enabled \
      && ok "$BLOCK_CLASS: ReadWriteOnce claims that are disks on machines too, chown and all"
  else
    warn "ferry-storage did not start; see $FERRY_RUN/logs/ferry-storage.log"
  fi
}

# CoreDNS forwards names it does not serve. It must not forward to itself, so
# it takes the resolvers the Mac itself uses.
host_resolvers() {
  local servers
  servers="$(scutil --dns 2>/dev/null | awk '/nameserver\[[0-9]+\]/ {print $3}' | sort -u | grep -v '^127\.' | head -3 | tr '\n' ' ')"
  [ -n "$servers" ] || servers="1.1.1.1 8.8.8.8"
  echo "$servers"
}

install_dns() { # gateway dns-address
  local gateway="$1" dns="$2"
  # The same address the API server advertises and its certificate covers.
  local advertise="$gateway"
  [ "$LAN_IP" != "127.0.0.1" ] && advertise="$LAN_IP"
  local rendered="$FERRY_RUN/coredns.yaml"
  sed -e "s|__CLUSTER_DOMAIN__|$CLUSTER_DOMAIN|g" \
      -e "s|__UPSTREAM_DNS__|$(host_resolvers)|g" \
      -e "s|__COREDNS_IMAGE__|$COREDNS_IMAGE|g" \
      `# CoreDNS talks to the API server directly rather than through the` \
      `# kubernetes Service, so it has an address of its own to be told. It has` \
      `# to be one the API server's certificate covers, which the pod network` \
      `# gateway is not -- that address belongs to whichever subnet this node` \
      `# happens to have. The advertised address is in the certificate and is` \
      `# what every other client already uses.` \
      -e "s|__APISERVER_HOST__|$advertise|g" \
      -e "s|__APISERVER_PORT__|$(( 6443 + PORT_SHIFT ))|g" \
      "$here/manifests/coredns.yaml" > "$rendered"

  KUBECONFIG="$FERRY_HOME/admin.conf" kubectl apply -f "$rendered" >/dev/null 2>&1 \
    || { warn "could not apply CoreDNS"; return 0; }

  # Wait on this rollout rather than on readyReplicas.
  #
  # The cluster's objects outlive a restart -- they are in etcd, and 'ferry down'
  # stops processes rather than deleting anything. So at this point the previous
  # CoreDNS is still recorded as ready, and the apply above has just started
  # replacing it, because the pod network gateway is part of the manifest and
  # can differ from the last run. Polling readyReplicas sees that stale 1 and
  # stops immediately, and by the time it is checked again the old pod has gone
  # and the new one has not arrived -- so ferry announced a broken cluster DNS
  # that was in fact seconds from ready.
  #
  # 'rollout status' waits for the generation that was just applied, which is
  # the question actually being asked.
  if KUBECONFIG="$FERRY_HOME/admin.conf" kubectl rollout status deployment/coredns \
       -n kube-system --timeout=180s >/dev/null 2>&1; then
    ok "cluster DNS at $dns"
  else
    warn "CoreDNS did not become ready; pods will start without cluster DNS"
    echo "  Check with: ferry kubeconfig && kubectl -n kube-system logs deploy/coredns"
  fi
}

# Services route inside each pod when the guest kernel can do NAT: ferry-cri
# pushes the ruleset into pods, which program their own kernels. That needs no
# privilege on the Mac and keeps traffic pod to pod.
#
# The host proxy below is the fallback for a guest kernel without NAT. It has to
# bind ClusterIPs locally and listen on 443 for the kubernetes Service, both of
# which need root, and every Service connection then passes through the Mac.
start_proxy() {
  [ -x "$here/bin/ferry-proxy" ] || { warn "ferry-proxy not built; NodePort and LoadBalancer will not work"; return 0; }

  # ClusterIPs are handled inside each pod when the guest kernel can NAT, which
  # needs no privilege. Without such a kernel they fall back to this process,
  # which binds them on the Mac and does need root.
  # Aggregated APIs -- metrics.k8s.io and anything else served by a pod rather
  # than by the API server -- are reached by the API server itself, which is a
  # macOS process and is not on the pod network. Binding ClusterIPs on the Mac is
  # the way to give it a route there, and that needs root, so it is asked for
  # rather than assumed.
  local cluster_ips="${FERRY_HOST_CLUSTER_IPS:-false}" extra=""
  if [ "$KERNEL" = "$NAT_KERNEL" ] && [ -x "$here/bin/ferry-proxyd" ] && [ "$cluster_ips" != true ]; then
    ok "Services route inside pods (no host proxy, no root)"
  elif [ "$cluster_ips" = true ]; then
    echo "  Binding ClusterIPs on the Mac as well, so the API server can reach"
    echo "  aggregated APIs such as metrics.k8s.io. This is what needs sudo."
  else
    cluster_ips=true
    echo "  The guest kernel cannot do NAT, so ClusterIPs fall back to a host proxy."
    echo "  Build a NAT-capable kernel with 'ferry kernel' to avoid this."
  fi

  # NodePort and LoadBalancer are the outside edge of a Service and always live
  # on the Mac, whichever way ClusterIPs are handled. Neither needs privilege,
  # 80 and 443 included: a LoadBalancer listens on the wildcard, which macOS
  # lets anyone bind below 1024, and answers only at $LAN_IP and loopback.
  #
  # The edge also holds outside clients to NetworkPolicy, by the address they
  # connected from. A pod sees all of them arrive from this Mac, which it has to
  # exempt for the kubelet's probes, so this is the only place that can.
  local lb="$LAN_IP"
  [ "$lb" = "127.0.0.1" ] && lb=""

  if [ "$cluster_ips" = true ]; then
    if ! sudo -n true 2>/dev/null; then
      echo "  ferry needs sudo once to bind ClusterIPs and listen on port 443."
      sudo -v || { warn "no sudo; ClusterIPs will not route (pods and DNS still work)"; return 0; }
    fi
    sudo "$here/bin/ferry-proxy" --kubeconfig "$FERRY_HOME/admin.conf" \
      --cluster-ips --node-ports --node-name "$NODE_NAME" \
      --host-ports "$FERRY_RUN/cri/hostports" --netpol-socket "$FERRY_NETPOL_SOCK" \
      ${lb:+--load-balancer-ip "$lb"} \
      >"$FERRY_RUN/logs/ferry-proxy.log" 2>&1 &
    sleep 2
    local pid; pid="$(pgrep -f "$here/bin/ferry-proxy --kubeconfig $FERRY_HOME/admin.conf" | head -1)"
  else
    "$here/bin/ferry-proxy" --kubeconfig "$FERRY_HOME/admin.conf" \
      --node-ports --node-name "$NODE_NAME" \
      --host-ports "$FERRY_RUN/cri/hostports" --netpol-socket "$FERRY_NETPOL_SOCK" \
      ${lb:+--load-balancer-ip "$lb"} \
      >"$FERRY_RUN/logs/ferry-proxy.log" 2>&1 &
    local pid=$!
  fi

  if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
    echo "$pid" > "$FERRY_RUN/ferry-proxy.pid"
    if [ -n "$lb" ]; then
      ok "NodePort on this Mac, LoadBalancer at $lb"
    else
      ok "NodePort on this Mac"
    fi
  else
    warn "ferry-proxy did not start; see $FERRY_RUN/logs/ferry-proxy.log"
  fi
}

# Another node on this Mac.
#
# A node here is a kubelet and a runtime, not a machine and not a container --
# the Mac is already the machine. So a second one costs two processes and a set
# of ports, and the pods it runs are virtual machines exactly like the first
# node's. Their addresses come from this node's own /24 inside the cluster /16,
# and they reach the first node's pods across ferry's switch.
cmd_node_add() {
  local name="${1:-}"
  [ -n "$name" ] || { bad "usage: ferry node add <name>"; return 2; }
  running ferry-cri || { bad "ferry is not up; run 'ferry up' first"; return 1; }

  # Find the first free index. Node 0 is the one 'ferry up' started.
  #
  # Free across the whole cluster, not just this Mac: an index is a /24 of the
  # cluster CIDR, and a Mac that joined took one without this Mac's pid files
  # knowing. Scanning locally alone is how two Macs end up handing out the same
  # pod addresses. The local scan is the fallback for a cluster whose API is not
  # answering, where one node on one Mac is the only thing that can be true.
  local index
  index="$(free_node_index)" || {
    index=1
    while [ -f "$FERRY_RUN/node-$index.pid" ]; do index=$((index + 1)); done
  }
  [ "$index" -le "$FERRY_MAX_NODES" ] || {
    bad "too many nodes; a profile has room for $FERRY_MAX_NODES"; return 1; }

  # Named after the profile, like every other socket ferry opens. Without the
  # suffix two checkouts' node 1 share /tmp/ferry-cri-1.sock, and the 'rm -f'
  # below deletes the other one's live socket on the way past.
  local sock="/tmp/ferry-cri$SUFFIX-$index.sock"
  local exec_sock="/tmp/ferry-exec$SUFFIX-$index.sock"
  local streamer_sock="/tmp/ferry-str$SUFFIX-$index.sock"
  local relay=$((RELAY_PORT + index))

  # One block of three consecutive ports, from lib/ports.sh -- which is also
  # where the reasoning about which three lives, and what tests/ports-test.sh
  # checks against every other port ferry binds.
  local kubelet_port healthz_port stream_port
  read -r kubelet_port healthz_port stream_port \
    <<<"$(ferry_node_ports "$PORT_SHIFT" "$index")"
  local stream_addr="127.0.0.1:$stream_port"
  local run="$FERRY_RUN/node-$index"

  bold "adding node $name"
  mkdir -p "$run"/{kubelet,pki,podlogs,containerlogs,volume-plugins,cri}
  rm -f "$sock" "$exec_sock" "$streamer_sock"

  # No --machine-switch here, deliberately. An extra node on this Mac shares the
  # one 'ferry-node serve', and that process relays to a single switch -- this
  # Mac's first one. Pointing this node at it would carry frames one way only:
  # its pods could reach a machine, and the machine's reply would arrive at the
  # first node's switch and stop there, because a switch does not re-flood what
  # a peer sent it. One direction is worse than none, since it looks like packet
  # loss rather than a missing feature. So pods on an added node do not reach
  # machines; pods on the first node do. Fixing it means the machines' switch
  # holding a peer per node on the Mac rather than one.
  FERRY_VERSION="$(ferry_runtime_version)" "$here/bin/ferry-cri" \
    --endpoint "$sock" --state "$run/cri" --kernel "$KERNEL" \
    --pod-subnet auto --pod-cpus "$POD_CPUS" --pod-memory-mib "$POD_MEMORY_MIB" \
    --exec-socket "$exec_sock" --streamer-control "$streamer_sock" \
    --nft-bundle "$here/guest/nft" --proxyd-socket "$FERRY_PROXYD_SOCK" \
    --netpol-socket "$FERRY_NETPOL_SOCK" --gpud-socket "$FERRY_GPUD_SOCK" \
    --cni "$here/bin/ferry-cni" \
    --cni-host-plugins "$here/ferry-cni/plugins/host" \
    --cni-guest-plugins "$here/ferry-cni/plugins/guest" \
    ${FERRY_CNI_CONFLIST:+--cni-conflist "$FERRY_CNI_CONFLIST"} \
    --cluster-cidr "$CLUSTER_CIDR" --node-index "$index" \
    --relay-port "$relay" --peers-file "$PEERS_FILE" \
    --relay-endpoint "$LAN_IP:$relay" \
    $(image_mirror_flag) \
    >"$FERRY_RUN/logs/node-$index-cri.log" 2>&1 &
  echo $! > "$FERRY_RUN/node-$index.pid"
  local ready= waited=0 limit=90
  while [ "$waited" -lt "$limit" ]; do
    [ -S "$sock" ] && grep -q "serving" "$FERRY_RUN/logs/node-$index-cri.log" 2>/dev/null && { ready=1; break; }
    grep -q "waiting for .*slice" "$FERRY_RUN/logs/node-$index-cri.log" 2>/dev/null && limit=260
    sleep 1
    waited=$(( waited + 1 ))
  done
  [ -n "$ready" ] || { bad "the runtime for $name did not start"; tail -5 "$FERRY_RUN/logs/node-$index-cri.log"; return 1; }
  ok "runtime on 10.244.$index.0/24, switch udp/$relay"

  "$here/bin/ferry-streamer" --listen "$stream_addr" \
    --exec-socket "$exec_sock" --control "$streamer_sock" \
    --kubeconfig "$FERRY_HOME/admin.conf" \
    --node-name "$name" --relay-endpoint "$LAN_IP:$relay" \
    --peers-file "$PEERS_FILE" \
    >"$FERRY_RUN/logs/node-$index-streamer.log" 2>&1 &
  echo $! > "$FERRY_RUN/node-$index-streamer.pid"
  ferry_await 15 test -S "$streamer_sock"

  # The kubelet's config differs from node 0's only in where things live and
  # which ports it holds; everything that makes a kubelet work on darwin is the
  # same, so it is derived rather than written out again.
  sed -e "s|$FERRY_RUN/podlogs|$run/podlogs|" \
      -e "s|unix://$FERRY_SOCK|unix://$sock|g" \
      -e "s|$FERRY_RUN/volume-plugins|$run/volume-plugins|" \
      -e "s|^readOnlyPort: 0|readOnlyPort: 0\nport: $kubelet_port\nhealthzPort: $healthz_port|" \
      "$FERRY_RUN/kubelet.yaml" > "$run/kubelet.yaml"

  start_kubelet "$name" "$run" "$FERRY_HOME/kubelet.conf" \
    "$FERRY_RUN/node-$index-kubelet.pid" "$FERRY_RUN/logs/node-$index-kubelet.log" "" "$index"

  export KUBECONFIG="$FERRY_HOME/admin.conf"
  for _ in $(seq 1 90); do
    [ "$(kubectl get node "$name" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ] && break
    sleep 1
  done
  if [ "$(kubectl get node "$name" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ]; then
    ok "node $name Ready"
    # Same reason as the Mac's own node: a name reused from an earlier cluster
    # keeps the Node object, and its labels, from before.
    ensure_mode_label "$name"
    echo
    kubectl get nodes
  else
    bad "node $name did not become Ready"; tail -5 "$FERRY_RUN/logs/node-$index-kubelet.log"; return 1
  fi
}

cmd_node_rm() {
  local name="${1:-}"
  [ -n "$name" ] || { bad "usage: ferry node rm <name>"; return 2; }
  export KUBECONFIG="$FERRY_HOME/admin.conf"
  local index
  for index in $(seq 1 "$FERRY_MAX_NODE_SCAN"); do
    [ -f "$FERRY_RUN/node-$index.pid" ] || continue
    grep -q "hostname-override=$name" "$FERRY_RUN/logs/node-$index-kubelet.log" 2>/dev/null && break
    pgrep -f "hostname-override=$name" >/dev/null && break
  done
  pkill -f "hostname-override=$name" 2>/dev/null
  for suffix in "" -streamer -kubelet; do
    local pidfile="$FERRY_RUN/node-$index$suffix.pid"
    [ -f "$pidfile" ] && { kill -TERM "$(cat "$pidfile")" 2>/dev/null; rm -f "$pidfile"; }
  done
  kubectl delete node "$name" >/dev/null 2>&1
  # A node added again under this name is a new node, and starts at the
  # cluster's version rather than whatever this one was left on. It also stops
  # holding that version in the store.
  ferry_forget_node_version "$name"
  ok "node $name removed"
}

# --- the join token -------------------------------------------------------
#
# Joining needs two secrets and one fact: the bootstrap token's id and secret,
# and the hash of the CA to pin the discovery fetch against. Passing those as
# three flags made 'ferry join' a four-line command, which is a four-line
# command nobody can paste into a chat window without it wrapping -- and one
# whose --ca-hash people were always going to be tempted to drop.
#
# So they travel as one opaque string, the way k3s' does:
#
#   F10<64 hex of the CA's public key>::<id>.<secret>
#
# F10 is a version marker, so a later token that carries something else can be
# told apart from this one rather than silently misparsed. The separator is ::
# because neither half can contain it: the hash is hex and the credential is
# [a-z0-9] by construction.
#
# The hash is not a secret -- it is a fingerprint of a public key, published in
# kube-public for anyone to read. It rides along because the joining Mac has to
# pin the CA it fetches over an unverified connection, and a token that carries
# the pin is a token that cannot be used without it.
ferry_token_encode() { # ca-hash-hex id secret
  printf 'F10%s::%s.%s\n' "$1" "$2" "$3"
}

# Prints "<ca-hash-hex> <id.secret>", or nothing if this is not one of ours.
ferry_token_decode() { # token
  case "$1" in
    F10*::*.*) : ;;
    *) return 1 ;;
  esac
  local rest="${1#F10}"
  local hash="${rest%%::*}" credential="${rest#*::}"
  # A truncated paste is the common failure and it must not read as a valid
  # token with a short hash, which would then fail to match the real CA and
  # report the wrong problem.
  [ "${#hash}" -eq 64 ] || return 1
  case "$hash" in *[!0-9a-f]*) return 1 ;; esac
  case "$credential" in *.*) : ;; *) return 1 ;; esac
  printf '%s %s\n' "$hash" "$credential"
}

# A token another Mac can join with.
#
# Kubernetes already has a way to admit a node it has never met: a bootstrap
# token lets the kubelet ask for a certificate, and the control plane signs it.
# ferry uses that rather than inventing anything -- the token is a Secret, the
# approval is upstream RBAC, and the certificate the node ends up with is a real
# one, not a copied credential.
cmd_token_create() {
  export KUBECONFIG="$FERRY_HOME/admin.conf"
  kubectl get nodes >/dev/null 2>&1 || { bad "ferry is not up"; return 1; }

  local id secret
  id="$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 6)"
  secret="$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 16)"

  kubectl create -f - >/dev/null 2>&1 <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: bootstrap-token-$id
  namespace: kube-system
type: bootstrap.kubernetes.io/token
stringData:
  token-id: "$id"
  token-secret: "$secret"
  expiration: "$(date -u -v+24H '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u -d '+24 hours' '+%Y-%m-%dT%H:%M:%SZ')"
  usage-bootstrap-authentication: "true"
  usage-bootstrap-signing: "true"
  auth-extra-groups: system:bootstrappers:ferry
EOF

  # Let a bootstrapping node ask for a certificate, and let the control plane
  # approve the ask automatically. Without the second binding a joining node
  # waits forever on a CSR nobody looks at.
  kubectl create clusterrolebinding ferry-bootstrap \
    --clusterrole=system:node-bootstrapper \
    --group=system:bootstrappers:ferry >/dev/null 2>&1
  kubectl create clusterrolebinding ferry-autoapprove \
    --clusterrole=system:certificates.k8s.io:certificatesigningrequests:nodeclient \
    --group=system:bootstrappers:ferry >/dev/null 2>&1
  kubectl create clusterrolebinding ferry-autorenew \
    --clusterrole=system:certificates.k8s.io:certificatesigningrequests:selfnodeclient \
    --group=system:nodes >/dev/null 2>&1
  # Every node renders its own Service rules, so every node has to be able to
  # read Services and EndpointSlices. system:node-proxier is the role upstream
  # already has for this; the node's own certificate is the credential.
  kubectl create clusterrolebinding ferry-node-proxier \
    --clusterrole=system:node-proxier \
    --group=system:nodes >/dev/null 2>&1

  # Let a node that has not joined yet read the node list.
  #
  # Every node owns one /24 of the cluster CIDR, chosen by its --node-index, and
  # two nodes on the same index means two Macs handing out the same pod
  # addresses. Until now the operator picked that number by hand and the token
  # printed one that was correct at the moment it was printed -- so a token used
  # twice, or used after another Mac joined, partitioned the pod network
  # silently.
  #
  # A joining Mac can pick a free index itself if it can see which are taken.
  # That is a read of the node list, and a bootstrap token is already an
  # authenticated identity, so it gets exactly that and nothing else.
  kubectl create clusterrole ferry-node-index \
    --verb=list --resource=nodes >/dev/null 2>&1
  kubectl create clusterrolebinding ferry-node-index \
    --clusterrole=ferry-node-index \
    --group=system:bootstrappers:ferry >/dev/null 2>&1

  # A joining Mac trusts nothing yet, so it cannot fetch the CA over a verified
  # connection -- and the CA is not on the wire either, because the API server
  # serves only its own certificate. So the CA is published where anyone can read
  # it and the token carries a hash of it: the fetch is unverified, the contents
  # are not. This is how kubeadm does discovery, and for the same reason.
  kubectl create configmap cluster-info -n kube-public \
    --from-file=ca.crt="$FERRY_HOME/pki/ca.crt" >/dev/null 2>&1
  kubectl create role ferry-cluster-info -n kube-public \
    --verb=get --resource=configmaps --resource-name=cluster-info >/dev/null 2>&1
  kubectl create rolebinding ferry-cluster-info -n kube-public \
    --role=ferry-cluster-info --user=system:anonymous >/dev/null 2>&1

  local hash token server
  hash="$(openssl x509 -pubkey -in "$FERRY_HOME/pki/ca.crt" \
          | openssl pkey -pubin -outform der 2>/dev/null \
          | openssl dgst -sha256 -hex | awk '{print $NF}')"
  token="$(ferry_token_encode "$hash" "$id" "$secret")"
  server="$LAN_IP:$(( 6443 + PORT_SHIFT ))"

  bold "join token"
  echo
  echo "  On the other Mac:"
  echo
  echo "    curl -sfL $FERRY_INSTALL_URL | \\"
  echo "      FERRY_URL=$server FERRY_TOKEN=$token sh -"
  echo
  echo "  Or, if that Mac already has ferry:"
  echo
  echo "    ferry join --server $server --token $token"
  echo
  echo "  Good for 24 hours, and reusable -- each Mac claims a free slice of"
  echo "  $CLUSTER_CIDR for its own pods when it joins."
}

# Join this Mac to a cluster running on another.
cmd_join() {
  local server= token= ca_hash= node_name= index=
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) server="$2"; shift 2 ;;
      --token) token="$2"; shift 2 ;;
      --ca-hash) ca_hash="$2"; shift 2 ;;
      --node-name) node_name="$2"; shift 2 ;;
      --node-index) index="$2"; shift 2 ;;
      *) bad "unknown option $1"; return 2 ;;
    esac
  done
  [ -n "$server" ] && [ -n "$token" ] || {
    bad "usage: ferry join --server <host:6443> --token <token from 'ferry token create'>"
    return 2; }

  # ferry builds "https://$server" itself, so a server given with a scheme
  # produces https://https://mac1:6443 and fails with "could not read
  # cluster-info", which sends people to look at their token. Half the places
  # this address is typed are prose -- an installer environment variable, a
  # README -- and https:// in front of a host:port is what anyone would write.
  case "$server" in
    https://*) server="${server#https://}" ;;
    http://*)  server="${server#http://}" ;;
  esac
  server="${server%/}"

  # A one-piece token carries the CA hash with it. The three-flag form still
  # works, because a token minted by an older ferry is still a valid bootstrap
  # token and refusing it would strand a cluster mid-upgrade.
  local decoded
  if decoded="$(ferry_token_decode "$token")"; then
    ca_hash="sha256:${decoded%% *}"
    token="${decoded#* }"
  elif [ -z "$ca_hash" ]; then
    bad "that does not look like a token from 'ferry token create'"
    echo "    A token looks like F10<64 hex>::<id>.<secret>. If you have the older"
    echo "    three-part form, pass it as --token <id.secret> --ca-hash sha256:<hash>."
    return 2
  fi
  node_name="${node_name:-$(hostname -s | tr '[:upper:]' '[:lower:]')}"

  # An installed release carries these; a checkout has to have built them.
  for binary in ferry-cri kubelet ferry-streamer; do
    [ -x "$here/bin/$binary" ] || {
      bad "bin/$binary is missing -- run 'ferry build', or install a release: curl -sfL $FERRY_INSTALL_URL | sh -"
      return 1; }
  done
  [ -f "$KERNEL" ] || {
    bad "no guest kernel at $KERNEL -- run 'ferry kernel', or install a release: curl -sfL $FERRY_INSTALL_URL | sh -"
    return 1; }

  # macOS grants access to the local network per launching session, and an SSH
  # session ends when the command returns. A node started over SSH therefore runs
  # perfectly until that moment and then cannot reach the cluster at all, with
  # "no route to host" against an address that answers ping and answers curl.
  # Measured: zero failures for three minutes with the session held open, and
  # failures within twenty seconds of it closing.
  if [ -n "${SSH_CONNECTION:-}" ] && [ -z "${FERRY_ALLOW_SSH_JOIN:-}" ]; then
    bad "this looks like an SSH session, and a node started from one stops being"
    echo "    able to reach the cluster as soon as the session ends."
    echo
    echo "    Run 'ferry join' from a Terminal window on this Mac instead. If the"
    echo "    first pod cannot reach the network, approve the local network prompt"
    echo "    macOS shows the first time."
    echo
    echo "    To override anyway: FERRY_ALLOW_SSH_JOIN=1 ferry join ..."
    return 1
  fi

  bold "joining $server as $node_name"
  mkdir -p "$FERRY_HOME/pki" "$FERRY_RUN"/{kubelet,pki,podlogs,containerlogs,volume-plugins,logs,cri}

  # Fetch the cluster's CA without trusting the connection, then refuse it unless
  # it hashes to what the token said. The connection being unverified does not
  # matter: a server that hands over the wrong CA fails the check.
  # sed and printf rather than a JSON parser: a machine joining a cluster should
  # need nothing but what macOS ships, and the one field wanted here sits on a
  # single line with escaped newlines.
  local encoded
  encoded="$(curl -sk --max-time 20 \
    "https://$server/api/v1/namespaces/kube-public/configmaps/cluster-info" \
    | sed -n 's/^ *"ca\.crt": "\(.*\)"$/\1/p' | head -1)"
  [ -n "$encoded" ] && printf '%b' "$encoded" > "$FERRY_RUN/fetched-ca.crt"
  if [ ! -s "$FERRY_RUN/fetched-ca.crt" ]; then
    bad "could not read cluster-info from $server (was the token made by 'ferry token create'?)"
    return 1
  fi
  local h
  h="$(openssl x509 -pubkey -in "$FERRY_RUN/fetched-ca.crt" 2>/dev/null \
       | openssl pkey -pubin -outform der 2>/dev/null \
       | openssl dgst -sha256 -hex | awk '{print $NF}')"
  if [ "sha256:$h" != "$ca_hash" ]; then
    bad "the CA at $server hashes to sha256:$h, not $ca_hash -- refusing to join"
    rm -f "$FERRY_RUN/fetched-ca.crt"
    return 1
  fi
  mv "$FERRY_RUN/fetched-ca.crt" "$FERRY_HOME/pki/ca.crt"
  ok "verified the cluster CA against the token's hash"

  cat > "$FERRY_RUN/bootstrap.conf" <<EOF
apiVersion: v1
kind: Config
clusters:
- cluster: {certificate-authority: $FERRY_HOME/pki/ca.crt, server: "https://$server"}
  name: ferry
contexts:
- context: {cluster: ferry, user: bootstrap}
  name: ferry
current-context: ferry
users:
- name: bootstrap
  user: {token: "$token"}
EOF

  # Which /24 of the cluster CIDR this Mac's pods come from.
  #
  # Asked for now, with the bootstrap credential, because the answer has to be
  # right before ferry-cri starts handing out addresses -- by the time the
  # kubelet has its own certificate the runtime is already running on whatever
  # slice it was told.
  if [ -z "$index" ]; then
    index="$(free_node_index "$FERRY_RUN/bootstrap.conf")" || {
      bad "could not work out which pod network slice is free on $server"
      echo
      echo "    Every Mac owns one /24 of $CLUSTER_CIDR, and two on the same one"
      echo "    hand out the same pod addresses. ferry reads the other nodes'"
      echo "    ferry.dev/node-index labels to find a free one -- but nodes that"
      echo "    joined before those labels existed do not carry one, and it will"
      echo "    not guess where guessing can partition the network."
      echo
      echo "    Check what is in use, then pick one no node holds:"
      echo "        kubectl get nodes -L ferry.dev/node-index"
      echo "        ferry join --server $server --token <token> --node-index <n>"
      return 1; }
    ok "claiming node index $index, so these pods come from $(node_slice "$index")"
  fi

  NODE_NAME="$node_name"
  NODE_INDEX="$index"
  RELAY_PORT=$((RELAY_PORT))
  clear_stopped
  echo worker > "$FERRY_HOME/role"
  start_worker "$node_name" "$index" || return 1
}

# The /24 of the cluster CIDR an index owns. For saying so out loud; ferry-cri
# does the real arithmetic.
node_slice() { # index
  local base="${CLUSTER_CIDR%%/*}"
  printf '%s.%s.%s.0/24\n' "$(echo "$base" | cut -d. -f1)" "$(echo "$base" | cut -d. -f2)" "$1"
}

# The lowest index no node in the cluster holds, and no node on this Mac holds.
#
# Both halves are needed and neither is enough. The cluster knows what other
# Macs took, through the ferry.dev/node-index label each kubelet registers with.
# This Mac knows what its own 'ferry node add' nodes took, including ones whose
# kubelet has not registered yet -- a node that is starting has a pid file and
# no node object, and handing its index to someone else is exactly the race this
# has to avoid.
#
# Nodes that predate the label are counted as index 0, which is what they are:
# a single-Mac cluster's 'ferry up' node.
free_node_index() { # [kubeconfig]
  local listing taken index
  # custom-columns rather than jsonpath: an unlabelled node prints "<none>",
  # where jsonpath prints nothing at all and the empty field disappears into the
  # separators around it. The distinction matters -- an unlabelled node is a
  # node holding index 0, not a node holding none.
  listing="$(KUBECONFIG="${1:-$(kube_config)}" kubectl get nodes --no-headers \
              -o 'custom-columns=I:.metadata.labels.ferry\.dev/node-index' 2>/dev/null)" \
    || return 1
  [ -n "$listing" ] || return 1

  # A node only gets this label when its kubelet *creates* the node object, so
  # every node in a cluster that predates the label stays unlabelled for the
  # life of that node -- restarting the kubelet does not add it.
  #
  # One unlabelled node is readable: it is the 'ferry up' node, which is index
  # 0. Two or more are not. Counting them all as 0 would report 1 as the lowest
  # free index in a cluster whose second Mac already owns 1, and hand a joining
  # Mac a /24 that is in use -- which is precisely the silent partition this
  # function exists to stop, reintroduced by the code meant to stop it. So it
  # declines to guess, and the caller asks for --node-index.
  local unlabelled
  unlabelled="$(echo "$listing" | grep -c '<none>')"
  [ "$unlabelled" -gt 1 ] && return 1

  taken=" $(echo "$listing" | sed 's/<none>/0/' | tr '\n' ' ')"
  for index in $(seq 0 200); do
    case "$taken" in *" $index "*) continue ;; esac
    # Ones this Mac has started but the cluster has not seen yet. A node whose
    # kubelet is still coming up has a pid file and no node object, and handing
    # its index to a second node is exactly the race this exists to avoid.
    [ -f "$FERRY_RUN/node-$index.pid" ] && continue
    [ "$index" = 0 ] && [ -f "$FERRY_RUN/ferry-cri.pid" ] && continue
    echo "$index"; return 0
  done
  return 1
}

# The parts of a node that are not the control plane: a runtime, a streamer and
# a kubelet. Used by 'ferry join'; 'ferry up' starts these itself because it has
# a control plane to start first.
start_worker() {
  local name="$1" index="$2"
  rm -f "$FERRY_SOCK" "$FERRY_EXEC_SOCK" "$FERRY_STREAMER_SOCK"

  # A joining Mac has its own GPU, so it runs its own daemon and advertises its
  # own capacity -- unlike 'node add', which is another node on this Mac and
  # shares the one that is already running.
  start_gpud

  FERRY_VERSION="$(ferry_runtime_version)" "$here/bin/ferry-cri" \
    --endpoint "$FERRY_SOCK" --state "$FERRY_RUN/cri" --kernel "$KERNEL" \
    --pod-subnet auto --pod-cpus "$POD_CPUS" --pod-memory-mib "$POD_MEMORY_MIB" \
    --exec-socket "$FERRY_EXEC_SOCK" --streamer-control "$FERRY_STREAMER_SOCK" \
    --nft-bundle "$here/guest/nft" --proxyd-socket "$FERRY_PROXYD_SOCK" \
    --netpol-socket "$FERRY_NETPOL_SOCK" --gpud-socket "$FERRY_GPUD_SOCK" \
    --cni "$here/bin/ferry-cni" \
    --cni-host-plugins "$here/ferry-cni/plugins/host" \
    --cni-guest-plugins "$here/ferry-cni/plugins/guest" \
    ${FERRY_CNI_CONFLIST:+--cni-conflist "$FERRY_CNI_CONFLIST"} \
    --cluster-cidr "$CLUSTER_CIDR" --node-index "$index" \
    --relay-port "$RELAY_PORT" --peers-file "$PEERS_FILE" \
    --machine-switch "127.0.0.1:$MACHINE_RELAY_PORT" \
    --relay-endpoint "$LAN_IP:$RELAY_PORT" \
    $(image_mirror_flag) \
    >"$FERRY_RUN/logs/ferry-cri.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-cri.pid"
  # Same budget rule as cmd_up, and it matters more here: a Mac joining a
  # cluster always has peers, so it always waits for its slice rather than
  # falling back to another subnet.
  local ready= waited=0 limit=90
  while [ "$waited" -lt "$limit" ]; do
    [ -S "$FERRY_SOCK" ] && grep -q "serving" "$FERRY_RUN/logs/ferry-cri.log" 2>/dev/null && { ready=1; break; }
    grep -q "waiting for .*slice" "$FERRY_RUN/logs/ferry-cri.log" 2>/dev/null && limit=260
    sleep 1
    waited=$(( waited + 1 ))
  done
  [ -n "$ready" ] || { bad "the runtime did not start"; tail -5 "$FERRY_RUN/logs/ferry-cri.log"; return 1; }
  ok "runtime on 10.244.$index.0/24, switch udp/$RELAY_PORT"

  cat > "$FERRY_RUN/kubelet.yaml" <<EOF
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
port: $(( 10250 + PORT_SHIFT ))
healthzPort: $(( 10248 + PORT_SHIFT ))
podLogsDir: $FERRY_RUN/podlogs
containerRuntimeEndpoint: unix://$FERRY_SOCK
imageServiceEndpoint: unix://$FERRY_SOCK
volumePluginDir: $FERRY_RUN/volume-plugins
kubeAPIQPS: $FERRY_KUBE_API_QPS
kubeAPIBurst: $FERRY_KUBE_API_BURST
evictionHard:
  memory.available: "$EVICT_MEMORY"
  nodefs.available: "$EVICT_DISK"
  imagefs.available: "$EVICT_DISK"
  nodefs.inodesFree: "5%"
imageGCHighThresholdPercent: 100
imageGCLowThresholdPercent: 99
maxPods: $MAX_PODS
cgroupsPerQOS: false
enforceNodeAllocatable: []
failSwapOn: false
readOnlyPort: 0
clusterDomain: $CLUSTER_DOMAIN
clusterDNS: [10.244.0.2]
runtimeRequestTimeout: 10m
authentication:
  x509: {clientCAFile: $FERRY_HOME/pki/ca.crt}
  anonymous: {enabled: false}
  webhook: {enabled: true}
authorization: {mode: Webhook}
EOF

  start_kubelet "$name" "$FERRY_RUN" "$FERRY_RUN/kubelet.conf" \
    "$FERRY_RUN/kubelet.pid" "$FERRY_RUN/logs/kubelet.log" "$FERRY_RUN/bootstrap.conf" "$index"

  for _ in $(seq 1 120); do
    [ -f "$FERRY_RUN/kubelet.conf" ] && break
    sleep 1
  done
  if [ -f "$FERRY_RUN/kubelet.conf" ]; then
    ok "got a certificate from the cluster"
  else
    bad "the kubelet never got a certificate"; tail -8 "$FERRY_RUN/logs/kubelet.log"; return 1
  fi

  # Only now: the streamer authenticates as this node, and the credential it
  # needs is the one the kubelet has just been issued. Started any earlier it
  # has nothing to present, and the node never advertises where its switch is.
  "$here/bin/ferry-streamer" --listen "$FERRY_STREAM_ADDR" \
    --exec-socket "$FERRY_EXEC_SOCK" --control "$FERRY_STREAMER_SOCK" \
    --kubeconfig "$FERRY_RUN/kubelet.conf" \
    --node-name "$name" --relay-endpoint "$LAN_IP:$RELAY_PORT" \
    --peers-file "$PEERS_FILE" --gpud-socket "$FERRY_GPUD_SOCK" \
    >"$FERRY_RUN/logs/ferry-streamer.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-streamer.pid"
  ferry_await 15 test -S "$FERRY_STREAMER_SOCK"
  ok "advertising this node's switch at $LAN_IP:$RELAY_PORT"

  # The node object exists now, so its GPU capacity can go on it.
  advertise_gpu "$name" "$FERRY_RUN/kubelet.conf"

  # Service rules are rendered per node, so a worker runs its own ferry-proxyd.
  # Like the streamer it authenticates as the node, so it also waits for the
  # certificate. ferry-cri is already asking for a ruleset and simply keeps
  # asking until this answers.
  if [ -x "$here/bin/ferry-proxyd" ]; then
    local gateway; gateway="$(cat "$FERRY_RUN/cri/gateway" 2>/dev/null || echo "$LAN_IP")"
    : > "$FERRY_RUN/logs/ferry-proxyd.log"
    start_proxyd "$FERRY_RUN/kubelet.conf" "$gateway" "$name" \
      && ok "Service rules rendered by kube-proxy $(ferry_proxyd_version 2>/dev/null)" \
      || warn "ferry-proxyd did not start; Services will not route on this node"
  else
    warn "bin/ferry-proxyd is missing; Services will not route on this node"
  fi

  # Node ports and claims are per node too: a pod scheduled here needs its
  # volume made here, and a connection arriving here needs forwarding here.
  local lb="$LAN_IP"; [ "$lb" = "127.0.0.1" ] && lb=""
  if [ -x "$here/bin/ferry-proxy" ]; then
    "$here/bin/ferry-proxy" --kubeconfig "$FERRY_RUN/kubelet.conf" \
      --node-ports --node-name "$name" \
      --host-ports "$FERRY_RUN/cri/hostports" \
      ${lb:+--load-balancer-ip "$lb"} \
      >"$FERRY_RUN/logs/ferry-proxy.log" 2>&1 &
    echo $! > "$FERRY_RUN/ferry-proxy.pid"
    ok "NodePort on this Mac${lb:+, LoadBalancer at $lb}"
  fi
  if [ -x "$here/bin/ferry-storage" ]; then
    "$here/bin/ferry-storage" --kubeconfig "$FERRY_RUN/kubelet.conf" \
      --node-name "$name" --root "$FERRY_HOME/volumes" --default=false \
      $(kernel_attaches_disks && echo "--block-class $BLOCK_CLASS") \
      >"$FERRY_RUN/logs/ferry-storage.log" 2>&1 &
    echo $! > "$FERRY_RUN/ferry-storage.pid"
    ok "PersistentVolumeClaims bind to $FERRY_HOME/volumes"
  fi
  # After the certificate, which is what the other Macs' registries check.
  start_registry "$(machines_enabled && echo "$MACHINE_SUBNET")"

  echo
  bold "joined as $name"
  echo "  its pods will be 10.244.$index.x and reach the other nodes' pods directly"
}

# --- upgrades -------------------------------------------------------------
#
# Moving a running cluster from one Kubernetes to another, which until now was
# not possible at all: `ferry build --kubernetes-version` changed what a *new*
# cluster was built from and nothing moved an existing one.
#
# The shape is upstream's, because the constraints are upstream's. The control
# plane goes first and alone, then each node is drained, its kubelet replaced,
# and the node brought back -- a kubelet may lag the API server by three minors
# and may never lead it by one. Between those two steps the cluster is running
# mixed versions on purpose, which is the supported state and the whole reason
# the order is what it is.
#
# Two things about ferry make this easier than it is elsewhere. etcd's data
# directory lives in FERRY_HOME and `ferry down` leaves it alone, so a control
# plane upgrade is a restart of four processes against the same data. And a
# node's runtime carries no Kubernetes version at all -- ferry-cri is ferry's
# own code -- so the kubelet can be replaced without stopping the runtime, and
# the pod VMs that drain did not move stay up across it.
#
# Each node runs its kubelet out of its own version in the store and records
# which, so nodes on one Mac move one at a time like nodes anywhere else, and a
# control plane upgrade touches no node at all -- 'apply' moves only the control
# plane's links. ferry-proxyd, being one per Mac, moves with the Mac's own node.

# kubectl, against whichever credentials this Mac has.
#
# The control plane Mac has admin.conf. A Mac that joined has only its kubelet's
# certificate, which by design cannot evict another pod, so draining from there
# needs an admin kubeconfig copied over.
KUBECONF=""
kube_config() {
  [ -n "$KUBECONF" ] && { echo "$KUBECONF"; return; }
  if [ -n "${FERRY_KUBECONFIG:-}" ]; then KUBECONF="$FERRY_KUBECONFIG"
  elif [ -f "$FERRY_HOME/admin.conf" ]; then KUBECONF="$FERRY_HOME/admin.conf"
  else KUBECONF="${KUBECONFIG:-}"; fi
  echo "$KUBECONF"
}
kube() { KUBECONFIG="$(kube_config)" kubectl "$@"; }

# Is there a cluster to talk to? Asked without saying anything, for the paths
# that carry on regardless -- 'plan' against a cluster that is down still has
# most of its answer, and printing a failure there would be reporting a problem
# that is not one.
have_cluster() {
  local conf; conf="$(kube_config)"
  [ -n "$conf" ] && [ -f "$conf" ] || return 1
  kube get --raw /version >/dev/null 2>&1
}

require_cluster() {
  have_cluster && return 0
  local conf; conf="$(kube_config)"
  if [ -n "$conf" ] && [ -f "$conf" ]; then
    bad "the cluster is not answering; is it up? (ferry status)"
    return 1
  fi
  bad "no kubeconfig on this Mac"
  if [ -f "$FERRY_RUN/kubelet.conf" ]; then
    echo "    This Mac joined a cluster, so it has only its kubelet's certificate,"
    echo "    and a kubelet may not evict another node's pods. Copy the admin"
    echo "    kubeconfig from the control plane Mac and point ferry at it:"
  else
    echo "    Expected one at $FERRY_HOME/admin.conf. If the cluster is elsewhere:"
  fi
  echo
  echo "        FERRY_KUBECONFIG=/path/to/admin.conf ferry upgrade ..."
  return 1
}

apiserver_version() {
  kube get --raw /version 2>/dev/null \
    | sed -n 's/.*"gitVersion": *"\([^"]*\)".*/\1/p' | head -1
}

node_kubelet_version() { # node
  kube get node "$1" -o jsonpath='{.status.nodeInfo.kubeletVersion}' 2>/dev/null
}

# Every node this Mac runs, as "index name" lines.
#
# Index 0 is the node 'ferry up' or 'ferry join' started; the rest come from
# 'ferry node add'. The name is read from a file written at start time rather
# than recovered from a log line: a log can be rotated or truncated, and an
# argument list does not outlive the process that had it.
local_nodes() {
  if [ -f "$FERRY_RUN/node-name" ]; then echo "0 $(cat "$FERRY_RUN/node-name")"
  elif running kubelet; then echo "0 $NODE_NAME"
  fi
  local index name run
  for index in $(seq 1 "$FERRY_MAX_NODE_SCAN"); do
    [ -f "$FERRY_RUN/node-$index-kubelet.pid" ] || continue
    run="$FERRY_RUN/node-$index"
    if [ -f "$run/node-name" ]; then
      name="$(cat "$run/node-name")"
    else
      name="$(grep -o 'hostname-override=[^ ]*' "$FERRY_RUN/logs/node-$index-kubelet.log" 2>/dev/null \
              | head -1 | cut -d= -f2)"
    fi
    [ -n "$name" ] && echo "$index $name"
  done
}

local_node_index() { # name -> index, or nothing if this node is not on this Mac
  local index nodename
  while read -r index nodename; do
    [ "$nodename" = "$1" ] && { echo "$index"; return 0; }
  done <<< "$(local_nodes)"
  return 1
}

stop_kubelet() { # pidfile
  [ -f "$1" ] || return 0
  local pid; pid="$(cat "$1")"; rm -f "$1"
  kill -TERM "$pid" 2>/dev/null || return 0
  for _ in $(seq 1 40); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.5; done
  kill -KILL "$pid" 2>/dev/null
}

node_ready() { # name
  [ "$(kube get node "$1" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ]
}

# Ready is not enough to read a version from.
#
# A node object keeps the old kubelet's status until the new one posts its own,
# so a Ready observed in the first moments after a restart can still be the
# previous kubelet's -- and reading nodeInfo then reports the version that was
# just replaced. The first run of this upgraded a node correctly and then said
# it had not, because it asked too early. Wait for the version to change, which
# is the thing actually being waited for.
wait_node_version() { # name version seconds
  local _
  for _ in $(seq 1 "$3"); do
    if node_ready "$1" && [ "$(node_kubelet_version "$1")" = "$2" ]; then return 0; fi
    sleep 1
  done
  return 1
}

# Start the kubelet for one node, wherever that node's state lives.
#
# Node 0 and the extra nodes differ only in which directory they keep and which
# credential they present; everything that makes a kubelet work on darwin is in
# the config file. Written once here so that restarting a kubelet during an
# upgrade brings back exactly the process that was there, rather than a fourth
# transcription of the same argument list.
#
# The binary comes out of the node's own version in the store, not bin/kubelet.
# With no version given it is the one the node last ran, so a restart is a
# restart and never an upgrade; 'ferry upgrade node' is the only thing that
# passes one. See lib/upgrade.sh.
start_kubelet() { # name run-dir kubeconfig pidfile logfile [bootstrap-kubeconfig] [node-index] [version]
  local name="$1" run="$2" kubeconfig="$3" pidfile="$4" logfile="$5" bootstrap="${6:-}"
  local index="${7:-}" version="${8:-}"
  [ -n "$version" ] || version="$(ferry_node_start_version "$name")"
  local kubelet="$here/bin/kubelet"
  [ -n "$version" ] && [ -x "$(ferry_version_dir "$version")/kubelet" ] \
    && kubelet="$(ferry_version_dir "$version")/kubelet"
  # The node publishes which /24 of the cluster CIDR it owns, so the next Mac to
  # join can pick one that is free instead of being told a number by hand. The
  # label is registered by the kubelet itself, at the moment the node object is
  # created, which is the only point early enough to be race-free.
  #
  # It also says which mode it is. docs/MACHINES.md specifies
  # `nodeSelector: {ferry.dev/mode: shared}` as how a pod chooses between a
  # kernel of its own and a shared one -- and that selector matched nothing,
  # because no node carried the label on either side. A Mac node is always
  # vm-per-pod: that is what ferry-cri does.
  FERRY_CONTAINER_LOGS_DIR="$run/containerlogs" \
  "$kubelet" \
    --config="$run/kubelet.yaml" \
    ${bootstrap:+--bootstrap-kubeconfig="$bootstrap"} \
    --kubeconfig="$kubeconfig" \
    --node-labels="ferry.dev/mode=vm-per-pod${index:+,ferry.dev/node-index=$index}" \
    --hostname-override="$name" --root-dir="$run/kubelet" \
    --cert-dir="$run/pki" --v="${FERRY_KUBELET_V:-2}" >"$logfile" 2>&1 &
  echo $! > "$pidfile"
  echo "$name" > "$run/node-name"
  if [ -n "$version" ]; then
    echo "$version" > "$run/kubelet-version"
    ferry_record_node_version "$name" "$version"
  fi
}

# kube-proxy's rule generation for this Mac's pods, at a version in the store.
#
# One per Mac, however many nodes it runs, so its version is the Mac's: the one
# it last ran, or node 0's when it has none. It used to run bin/ferry-proxyd,
# which nothing upgraded -- 'ferry upgrade nodes' replaced every kubelet and
# left kube-proxy on the version the Mac first came up with, with no skew check
# ever applied to it.
start_proxyd() { # kubeconfig node-ip [node-name] [version]
  local kubeconfig="$1" node_ip="$2" name="${3:-}" version="${4:-}"
  if [ -z "$version" ]; then
    version="$(ferry_proxyd_version 2>/dev/null)" \
      && [ -x "$(ferry_version_dir "$version")/ferry-proxyd" ] || version=""
  fi
  if [ -z "$version" ]; then
    local node0; node0="$(cat "$FERRY_RUN/node-name" 2>/dev/null || echo "$NODE_NAME")"
    version="$(ferry_node_start_version "$node0" 2>/dev/null)"
  fi
  local proxyd
  proxyd="$(ferry_version_dir "$version")/ferry-proxyd"
  [ -x "$proxyd" ] || proxyd="$here/bin/ferry-proxyd"
  [ -x "$proxyd" ] || return 1
  rm -f "$FERRY_PROXYD_SOCK"
  "$proxyd" --kubeconfig "$kubeconfig" ${name:+--node-name "$name"} \
    --node-ip "$node_ip" --socket "$FERRY_PROXYD_SOCK" \
    >>"$FERRY_RUN/logs/ferry-proxyd.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-proxyd.pid"
  echo "$node_ip" > "$FERRY_RUN/ferry-proxyd.node-ip"
  [ -n "$version" ] && ferry_record_proxyd_version "$version"
  ferry_await 15 test -S "$FERRY_PROXYD_SOCK"
  [ -S "$FERRY_PROXYD_SOCK" ]
}

# Where one node's kubelet keeps its things, as shell assignments to eval.
# Quoted, because these are paths and the caller evals them.
node_layout() { # index
  if [ "$1" = 0 ]; then
    # A Mac that joined keeps its credential in the run directory and has a
    # bootstrap config beside it; one running a control plane uses FERRY_HOME's.
    printf 'run=%q\n' "$FERRY_RUN"
    printf 'pidfile=%q\n' "$FERRY_RUN/kubelet.pid"
    printf 'logfile=%q\n' "$FERRY_RUN/logs/kubelet.log"
    if [ -f "$FERRY_RUN/kubelet.conf" ]; then
      printf 'kubeconfig=%q\n' "$FERRY_RUN/kubelet.conf"
      printf 'bootstrap=%q\n' "$FERRY_RUN/bootstrap.conf"
    else
      printf 'kubeconfig=%q\n' "$FERRY_HOME/kubelet.conf"
      printf 'bootstrap=\n'
    fi
  else
    printf 'run=%q\n' "$FERRY_RUN/node-$1"
    printf 'pidfile=%q\n' "$FERRY_RUN/node-$1-kubelet.pid"
    printf 'logfile=%q\n' "$FERRY_RUN/logs/node-$1-kubelet.log"
    printf 'kubeconfig=%q\n' "$FERRY_HOME/kubelet.conf"
    printf 'bootstrap=\n'
  fi
}

# --- etcd snapshots -------------------------------------------------------

# There is one etcd member and one copy of the cluster's state. Every switch
# that could touch it takes a snapshot first, because a control plane that has
# started once at a newer version may have written storage the older one cannot
# read, and at that point flipping the binaries back is not a rollback -- it is
# an API server that will not start, with the only copy of the data underneath
# it.
etcd_snapshot() { # label -> prints the path
  local dir="$FERRY_HOME/backups"
  mkdir -p "$dir"
  local path; path="$dir/$(date -u +%Y%m%dT%H%M%SZ)-$1.db"
  if ! "$here/bin/etcdctl" --endpoints="127.0.0.1:$(( 2379 + PORT_SHIFT ))" \
        snapshot save "$path" >/dev/null 2>&1; then
    rm -f "$path"
    return 1
  fi
  echo "$path"
}

# Restore a snapshot over the data directory. etcd must be stopped.
#
# Run with whichever etcd is linked *now*, so a rollback restores with the
# version it is rolling back to -- a 3.5 etcd cannot read a directory a 3.6 one
# has migrated, which is the case this exists for. etcd 3.6 removed `etcdctl
# snapshot restore` in favour of etcdutl, so prefer that and fall back.
etcd_restore() { # snapshot
  local tool="$here/bin/etcdutl"
  [ -x "$tool" ] || tool="$here/bin/etcdctl"
  local peer="http://127.0.0.1:$(( 2380 + PORT_SHIFT ))"
  rm -rf "$FERRY_HOME/etcd.restoring"
  # The revision moves forward, not back, and everything before it reads as
  # compacted.
  #
  # A snapshot's revision is older than the one every watcher in the cluster
  # last saw -- measured on a rollback here, 1338 against 1682 -- and a watch
  # resumed from a revision etcd has not reached yet simply waits until it
  # gets there, then carries on from there: every kubelet, every ferry-proxyd,
  # every controller keeps the world as it was before the restore and never
  # hears that it changed. Restored nodes showed pods Running that no longer
  # existed and kept them that way. Bumped and compacted, every watch is told
  # its revision is gone and lists again, which is what upstream documents
  # for restoring a cluster that has clients. A billion is its figure: more
  # writes than could have happened since any snapshot ferry keeps.
  "$tool" snapshot restore "$1" \
    --data-dir "$FERRY_HOME/etcd.restoring" \
    --name default --initial-cluster "default=$peer" \
    --initial-advertise-peer-urls "$peer" \
    --bump-revision 1000000000 --mark-compacted >/dev/null 2>&1 || return 1
  # The directory being replaced is moved aside, not deleted. If the restore
  # turns out to be the wrong call there is still something to go back to.
  [ -d "$FERRY_HOME/etcd" ] \
    && mv "$FERRY_HOME/etcd" "$FERRY_HOME/etcd.replaced-$(date -u +%Y%m%dT%H%M%SZ)"
  mv "$FERRY_HOME/etcd.restoring" "$FERRY_HOME/etcd"
}

# --- plan -----------------------------------------------------------------

# Everything that can be checked without touching the cluster.
#
# Run by 'plan' on its own and by 'apply' before it does anything. The order is
# cheapest first: a release that does not exist should be found in a second,
# not after twenty minutes of compiling a kubelet for it.
#
# Returns 0 to go ahead, 1 when the upgrade must not happen, and 2 when there is
# simply nothing to do -- which is not a failure and must not be reported as
# one.
upgrade_preflight() { # from to
  local from="$1" to="$2" fatal=0

  # An installed release cannot move Kubernetes, and the reason is the kubelet.
  # The control plane and etcd are downloads, so those would be fine; the
  # kubelet is compiled here from a patched Kubernetes tree, and a release
  # carries neither the tree nor a toolchain to build it with.
  #
  # This is checked first because the alternative is finding out several minutes
  # in, from build-kubelet.sh, after a snapshot has already been taken.
  #
  # It is also not much of a limitation: moving Kubernetes by installing a newer
  # ferry is how k3s works too, and a release pins one Kubernetes on purpose --
  # the kubelet, ferry-proxyd, the control plane and etcd are built and tested
  # together.
  if is_release; then
    bad "this is an installed ferry $(ferry_release_version), which cannot build a kubelet"
    echo
    echo "    A release carries one Kubernetes, built and tested as a set. To move"
    echo "    to another, install a ferry release that carries it:"
    echo "        curl -sfL $FERRY_INSTALL_URL | sh -"
    echo
    echo "    Or build from source, where any version is a build input:"
    echo "        git clone https://github.com/imaustink/ferry && cd ferry"
    echo "        ./ferry upgrade plan $to"
    return 1
  fi

  if ! ferry_version_valid "$to"; then
    bad "$to is not a version like v1.34.0"; return 1
  fi
  if [ "$from" = "$to" ]; then
    ok "already at $to"; return 2
  fi
  local reason; reason="$(ferry_skew_reason "$from" "$to")"
  if [ -n "$reason" ]; then bad "$reason"; return 1; fi
  ok "$from to $to is a supported step"

  local cp; cp="$(ferry_control_plane_version "$to")"
  local etcd_to; etcd_to="$(ferry_etcd_version "$to")"
  local etcd_from; etcd_from="$(ferry_etcd_version "$from")"

  # Is there a darwin control plane for it at all? This is the check that most
  # often says no, because kwok-ci builds some patch releases and not others.
  if curl -fsI --max-time 20 -o /dev/null \
      "https://github.com/kwok-ci/k8s/releases/download/${cp}-kwok.0-darwin-arm64/kube-apiserver" 2>/dev/null; then
    ok "control plane $cp is published for darwin/arm64"
  else
    bad "kwok-ci/k8s has no darwin/arm64 build of $cp"
    echo "      ferry pins one control plane per minor in lib/versions.sh. Name a"
    echo "      release that exists instead:"
    echo "        K8S_CONTROL_PLANE_VERSION=vX.Y.Z ferry upgrade apply $to"
    fatal=1
  fi

  if curl -fsI --max-time 20 -o /dev/null \
      "https://github.com/etcd-io/etcd/releases/download/$etcd_to/etcd-$etcd_to-darwin-arm64.zip" 2>/dev/null; then
    ok "etcd $etcd_to is published for darwin/arm64"
  else
    bad "no darwin/arm64 etcd $etcd_to; override with ETCD_VERSION=vX.Y.Z"
    fatal=1
  fi

  # The tag has to exist before there is any point cloning it.
  if git ls-remote --tags --exit-code \
      https://github.com/kubernetes/kubernetes.git "refs/tags/$to" >/dev/null 2>&1; then
    ok "kubernetes has a $to tag to build the kubelet from"
  else
    bad "kubernetes has no tag $to"
    fatal=1
  fi

  # The patches are the real risk and cannot be checked from here. They are
  # whole files plus a dozen textual seams, and build-kubelet.sh asserts every
  # seam it edits -- so a version whose source has drifted fails during the
  # build, before anything has been switched. Saying so is the honest answer.
  if [ "$(ferry_version_mm "$from")" != "$(ferry_version_mm "$to")" ]; then
    warn "$to is a new minor, so its kubelet is built from patches/kubelet-$(ferry_version_mm "$to")"
    echo "      build-kubelet.sh checks the constructors that directory records in"
    echo "      SIGNATURES against the tree, and fails on any seam whose file has"
    echo "      moved. That happens during the build, which runs before anything"
    echo "      is switched, so a drifted tree costs time and not a cluster."
  fi

  if [ "$etcd_from" != "$etcd_to" ]; then
    local fm tm
    fm="$(ferry_version_mm "$etcd_from")"; tm="$(ferry_version_mm "$etcd_to")"
    if [ "$fm" != "$tm" ]; then
      warn "etcd $etcd_from to $etcd_to crosses a minor: the data directory is migrated"
      echo "      etcd does not support going back down afterwards by swapping the"
      echo "      binary. 'ferry upgrade rollback' restores the snapshot taken here,"
      echo "      which means losing anything written after this point."
    else
      ok "etcd $etcd_from to $etcd_to, same minor"
    fi
  fi

  local free; free="$(df -g "$HOME" | tail -1 | awk '{print $4}')"
  if [ "$free" -ge 25 ]; then ok "${free}G free disk"
  else warn "${free}G free disk; a kubernetes source tree and build want about 25G"; fi

  # What the running cluster says, when there is one to ask. Last, because it is
  # the only part that needs the cluster, and a plan against a cluster that is
  # down still has everything above.
  if have_cluster; then
    upgrade_cluster_checks "$to" || fatal=1
  fi

  return "$fatal"
}

# Checks that need the live cluster: every node's kubelet and this Mac's
# kube-proxy against the new API server, and whether anything is still asking
# for an API the new one removes.
#
# The node check used to cover only the nodes this Mac runs, and only in
# 'plan', as a warning -- so 'apply' would happily move the API server three
# minors past a kubelet on another Mac, which then could not talk to it at all.
# Every node is read from the API, which is the one place that knows all of
# them, and a node that would fall outside the skew stops the upgrade.
upgrade_cluster_checks() { # to
  local to="$1" fatal=0
  ok "cluster is up, API server reports $(apiserver_version)"

  local name version reason count=0 bad_nodes=0
  while read -r name version; do
    [ -n "$name" ] || continue
    count=$(( count + 1 ))
    reason="$(ferry_kubelet_skew_reason "$version" "$to")"
    if [ -n "$reason" ]; then
      bad "node $name: $reason"
      bad_nodes=$(( bad_nodes + 1 ))
    fi
  done <<< "$(kube get nodes -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.status.nodeInfo.kubeletVersion}{"\n"}{end}' 2>/dev/null)"
  if [ "$bad_nodes" -gt 0 ]; then
    echo "      Upgrade those nodes first, each from the Mac that runs it:"
    echo "        ferry upgrade node <name> --to <a version within three minors of $to>"
    fatal=1
  elif [ "$count" -gt 0 ]; then
    ok "all $count nodes' kubelets stay inside the skew against $to"
  fi

  # kube-proxy has the kubelet's rule against the API server. It reports its
  # version to nobody, so only this Mac's is known here.
  local proxyd
  if proxyd="$(ferry_proxyd_version 2>/dev/null)"; then
    reason="$(ferry_kubelet_skew_reason "$proxyd" "$to")"
    if [ -n "$reason" ]; then
      bad "ferry-proxyd (kube-proxy) on this Mac: ${reason/a kubelet/kube-proxy}"
      fatal=1
    else
      ok "ferry-proxyd $proxyd stays inside kube-proxy's skew against $to"
    fi
  fi

  local metrics removed
  if metrics="$(kube get --raw /metrics 2>/dev/null)"; then
    removed="$(printf '%s\n' "$metrics" | ferry_removed_apis "$to")"
    if [ -n "$removed" ]; then
      bad "something is still asking for APIs that $to no longer serves:"
      printf '%s\n' "$removed" | sed 's/^/        /'
      echo "      The objects are safe -- the API server converts them -- but the"
      echo "      clients asking will get 404s. 'kubectl get --raw /metrics | grep"
      echo "      apiserver_requested_deprecated_apis' says which. Move them to the"
      echo "      replacement first, or go ahead regardless:"
      echo "        FERRY_ALLOW_REMOVED_APIS=1 ferry upgrade apply $to"
      [ "${FERRY_ALLOW_REMOVED_APIS:-}" = 1 ] || fatal=1
    else
      ok "nothing has asked this API server for an API $to removes"
    fi
  fi
  return "$fatal"
}

cmd_upgrade_plan() {
  local to="${1:-}"
  [ -n "$to" ] || { bad "usage: ferry upgrade plan <vX.Y.Z>"; return 2; }
  local from; from="$(cluster_version)"

  bold "upgrade plan $from -> $to"
  echo
  upgrade_preflight "$from" "$to"
  case "$?" in
    0) : ;;
    2) return 0 ;;
    *) echo; bold "not ready"; return 1 ;;
  esac
  have_cluster || warn "the cluster is not up; 'apply' will build and switch the binaries anyway"

  local etcd_from etcd_to
  etcd_from="$(ferry_store_etcd "$from")"; etcd_to="$(ferry_etcd_version "$to")"
  echo
  bold "what apply would do"
  echo "  1. build the kubelet and ferry-proxyd for $to, and fetch its control"
  echo "     plane and etcd. Nothing running is touched; a failure here costs"
  echo "     time only."
  echo "  2. snapshot etcd to $FERRY_HOME/backups."
  if [ "$etcd_from" = "$etcd_to" ]; then
    echo "  3. leave etcd $etcd_to running, since $to pairs with the same one."
    if [ -x "$here/bin/ferry-handover" ]; then
      echo "  4. hand the API server's port from the $from API server to the $to one."
      echo "     Connections made during the switch wait for it, for a second or"
      echo "     so, rather than being refused. The controller manager and"
      echo "     scheduler restart behind it."
    else
      echo "  4. stop the $from API server and start the $to one. Clients are"
      echo "     refused for about two seconds. (Build ferry-handover to avoid"
      echo "     that: ferry build.)"
    fi
  else
    echo "  3. stop the control plane and etcd, since etcd moves from $etcd_from"
    echo "     to $etcd_to, and start them again at $to. The API is unreachable"
    echo "     for a few seconds."
  fi
  echo "  5. verify the API server answers at $to. If it does not, put $from back."
  echo
  echo "  No node is touched: kubelets and ferry-proxyd keep running $from, and"
  echo "  running pods are not disturbed. Roll the nodes when you like:"
  echo "      ferry upgrade nodes"
  echo "  A kubelet may lag the API server by three minors, so there is no hurry"
  echo "  and no need to do it in one sitting."
}

# --- apply ----------------------------------------------------------------

cmd_upgrade_apply() {
  # Deliberately not seeded from $1: 'apply --yes' with no version would
  # otherwise take "--yes" for the version it is upgrading to.
  local to="" assume_yes=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) assume_yes=1; shift ;;
      -*) bad "usage: ferry upgrade apply <vX.Y.Z> [--yes]"; return 2 ;;
      *) to="$1"; shift ;;
    esac
  done
  [ -n "$to" ] || { bad "usage: ferry upgrade apply <vX.Y.Z> [--yes]"; return 2; }

  local from; from="$(cluster_version)"
  bold "upgrade $from -> $to"
  echo
  upgrade_preflight "$from" "$to"
  case "$?" in
    0) : ;;
    2) return 0 ;;
    *) echo; bold "not ready"; return 1 ;;
  esac
  echo

  if [ -z "$assume_yes" ]; then
    echo "  The control plane restarts at $to. Nodes and running pods are not"
    echo "  touched. Continue? [y/N] "
    local answer; read -r answer
    case "$answer" in y|Y|yes) : ;; *) echo "  nothing done"; return 1 ;; esac
    echo
  fi

  # 1. Build first, always. Everything below this point is reversible; a build
  #    that fails before it has not changed anything at all.
  bold "building $to"
  build_kubernetes_binaries "$to" || { bad "build failed; nothing was changed"; return 1; }
  ferry_version_complete "$to" || { bad "the build did not produce a complete $to"; return 1; }
  ok "$to is in the store"
  echo

  # An upgrade of a cluster that is not running is just a build plus a note of
  # where to start next time. Only the control plane's links move: each node
  # starts at the version it last ran, and is moved by 'ferry upgrade node'.
  if ! running ferry-cri || ! have_cluster; then
    # shellcheck disable=SC2086 # a list of names
    ferry_activate_version "$to" $FERRY_CONTROL_PLANE_BINARIES
    ferry_write_cluster_version "$to" "$(ferry_control_plane_version "$to")" "$(ferry_etcd_version "$to")"
    warn "the cluster is not up, so nothing was restarted"
    echo "      'ferry up' will start its control plane at $to, and each node at"
    echo "      the version it last ran. Then: ferry upgrade nodes"
    return 0
  fi

  # 2. Snapshot.
  bold "snapshotting etcd"
  local snapshot
  if snapshot="$(etcd_snapshot "$from-to-$to")"; then
    ok "$snapshot ($(du -h "$snapshot" | cut -f1))"
  else
    bad "could not snapshot etcd, and an upgrade without one cannot be undone"
    echo "    Check 'ferry logs etcd'. To go ahead regardless:"
    echo "        FERRY_SKIP_SNAPSHOT=1 ferry upgrade apply $to"
    [ "${FERRY_SKIP_SNAPSHOT:-}" = 1 ] || return 1
    snapshot=""
  fi
  echo

  # 3 and 4. Switch. The kubelets and ferry-cri stay up throughout: a kubelet
  # reconnects to an API server that went away, and the pods are VMs the
  # runtime owns, not something the control plane holds open.
  bold "switching the control plane"
  upgrade_switch "$from" "$to"
  local rc=$?
  if [ "$rc" = 0 ]; then
    local api; api="$(apiserver_version)"
    if [ -n "$api" ] && [ "$(ferry_version_mm "$api")" = "$(ferry_version_mm "$to")" ]; then
      ferry_write_cluster_version "$to" "$(ferry_control_plane_version "$to")" "$(ferry_etcd_version "$to")"
      ok "API server answering at $api"
      echo
      bold "control plane is $to"
      echo "  Nodes are still on the kubelet they had, which is supported. Roll"
      echo "  them when you like:"
      echo
      echo "      ferry upgrade nodes"
      echo
      [ -n "$snapshot" ] && echo "  If it goes wrong: ferry upgrade rollback"
      return 0
    fi
    bad "the control plane started but reports ${api:-nothing}, not $to"
  elif [ "$rc" = 3 ]; then
    # The new API server never bound, and the old one never stopped serving.
    # shellcheck disable=SC2086 # a list of names
    ferry_activate_version "$from" $FERRY_CONTROL_PLANE_BINARIES
    bad "the $to API server did not start; $from is still serving, and nothing was switched"
    echo "    Its log: $FERRY_HOME/logs/kube-apiserver.log"
    return 1
  fi

  # 5. It did not come up. Put back what was there.
  echo
  bold "rolling back to $from"
  upgrade_restore "$to" "$from" "$snapshot"
  return 1
}

# Move the running control plane from one version to another against the same
# data directory. Only the control plane's links move; no node is touched.
#
# etcd restarts only when the version it pairs with changes -- MANIFEST's etcd
# field, what the store actually fetched. Every minor from v1.34 to v1.37 pairs
# with the same one, so for them this leaves it alone, which takes its restart
# out of the outage and the API server's wait for it with it.
#
# With etcd left running and ferry-handover built, the API server is handed
# over rather than stopped: see control-plane/up.sh.
upgrade_switch() { # from to
  local ef et
  ef="$(ferry_store_etcd "$1")"; et="$(ferry_store_etcd "$2")"
  # shellcheck disable=SC2086 # a list of names
  ferry_activate_version "$2" $FERRY_CONTROL_PLANE_BINARIES
  if [ "$ef" = "$et" ] && [ -f "$FERRY_HOME/etcd.pid" ] && kill -0 "$(cat "$FERRY_HOME/etcd.pid")" 2>/dev/null; then
    ok "etcd $et is the same for $1 and $2; left running"
    if [ -x "$here/bin/ferry-handover" ]; then
      FERRY_KEEP_ETCD=1 FERRY_HANDOVER=1 start_control_plane "$2"
    else
      warn "ferry-handover is not built, so the API server stops before its replacement starts"
      FERRY_KEEP_ETCD=1 start_control_plane "$2"
    fi
    return
  fi
  [ "$ef" != "$et" ] && ok "etcd $ef to $et, so etcd restarts too"
  STATE="$FERRY_HOME" "$here/control-plane/down.sh" >/dev/null 2>&1
  ok "stopped $1"
  start_control_plane "$2"
}

# Put the control plane back at an earlier version: the failure path of 'apply'
# and the whole of 'rollback', which are the same operation arrived at from
# different directions.
#
# Whether the data directory comes back from the snapshot is
# ferry_rollback_restore_reason's call; see lib/upgrade.sh. When it does, etcd
# stops too, since a data directory cannot be replaced under a running one.
upgrade_restore() { # from to snapshot [keep-data]
  local from="$1" version="$2" snapshot="$3" keep="${4:-}"
  ferry_version_complete "$version" || {
    bad "the store has no $version to go back to; nothing to restore"; return 1; }

  local reason
  reason="$(ferry_rollback_restore_reason "$from" "$version" "$(ferry_store_etcd "$from")" "$(ferry_store_etcd "$version")")"
  local started=1
  if [ -n "$reason" ] && [ -n "$snapshot" ] && [ -f "$snapshot" ] && [ -z "$keep" ]; then
    STATE="$FERRY_HOME" "$here/control-plane/down.sh" >/dev/null 2>&1
    # shellcheck disable=SC2086 # a list of names
    ferry_activate_version "$version" $FERRY_CONTROL_PLANE_BINARIES
    if etcd_restore "$snapshot"; then ok "restored $snapshot"
    else bad "could not restore $snapshot; the data directory is untouched"; fi
    start_control_plane "$version" || started=""
  else
    upgrade_switch "$from" "$version" || started=""
  fi

  if [ -n "$started" ]; then
    ferry_write_cluster_version "$version" "$(ferry_control_plane_version "$version")" \
      "$(ferry_etcd_version "$version")"
    ok "back on $version"
    return 0
  fi
  bad "$version did not start either"
  echo "    The control plane is down. Logs: ferry logs control-plane"
  [ -n "$snapshot" ] && echo "    The snapshot from before the upgrade is at $snapshot"
  return 1
}

cmd_upgrade_rollback() {
  local assume_yes="" keep=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) assume_yes=1; shift ;;
      --keep-data) keep=1; shift ;;
      *) bad "usage: ferry upgrade rollback [--yes] [--keep-data]"; return 2 ;;
    esac
  done
  local to; to="$(ferry_previous_field kubernetes 2>/dev/null)"
  local from; from="$(cluster_version)"
  [ -n "$to" ] || { bad "this cluster has not been upgraded, so there is nothing to roll back to"; return 1; }

  bold "rollback $from -> $to"
  # version.previous is whatever the cluster was before its last change, and
  # after a rollback that is the newer version. Going there is an upgrade, and
  # has apply's checks; rollback would skip them.
  if [ "$from" != "$to" ] && [ -z "$(ferry_skew_reason "$from" "$to")" ]; then
    bad "$to is newer than $from, so going there is an upgrade, not a rollback"
    echo "    ferry upgrade apply $to"
    return 1
  fi
  ferry_version_complete "$to" || {
    bad "the store no longer has $to"
    echo "    Build it back first: ferry build --kubernetes-version $to"
    return 1; }

  # The most recent snapshot taken on the way up is the one to come back to.
  local snapshot
  snapshot="$(find "$FERRY_HOME/backups" -name "*-$to-to-$from.db" 2>/dev/null | sort | tail -1)"
  local etcd_to etcd_from
  etcd_to="$(ferry_store_etcd "$to")"; etcd_from="$(ferry_store_etcd "$from")"
  local reason; reason="$(ferry_rollback_restore_reason "$from" "$to" "$etcd_from" "$etcd_to")"

  if [ -n "$reason" ]; then
    if [ -z "$snapshot" ]; then
      if [ "$(ferry_version_mm "$etcd_to")" != "$(ferry_version_mm "$etcd_from")" ]; then
        bad "going back to $to means going back to etcd $etcd_to, which cannot read"
        echo "    the data directory etcd $etcd_from migrated -- and the snapshot from"
        echo "    the upgrade is gone. There is no way back that keeps the data."
        return 1
      fi
      if [ -z "$keep" ]; then
        bad "$reason, and the snapshot from the upgrade is gone"
        echo "    Starting $to on what $from has written may work and may not: it"
        echo "    reads objects at the storage versions it knows and cannot read the"
        echo "    rest. To try it anyway, keeping everything written since:"
        echo "        ferry upgrade rollback --keep-data"
        return 1
      fi
      warn "$reason; keeping the data directory, as asked"
    elif [ -n "$keep" ]; then
      if [ "$(ferry_version_mm "$etcd_to")" != "$(ferry_version_mm "$etcd_from")" ]; then
        bad "--keep-data cannot apply across an etcd minor: etcd $etcd_to cannot read it"
        return 1
      fi
      warn "$reason; keeping the data directory, as asked, rather than restoring"
    else
      local taken; taken="$(date -r "$snapshot" '+%Y-%m-%d %H:%M:%S')"
      warn "$reason."
      echo "      So the cluster goes back to the snapshot taken on the way up, at"
      echo "      $taken. Everything written to the API since is lost: objects"
      echo "      created, changed or deleted after that moment -- and a pod whose"
      echo "      object is gone is stopped by its kubelet, then recreated by its"
      echo "      controller if it has one. To keep what was written instead, and"
      echo "      take the chance that $to reads it:"
      echo "          ferry upgrade rollback --keep-data"
      if [ -z "$assume_yes" ]; then
        echo "  Restore it? [y/N] "
        local answer; read -r answer
        case "$answer" in y|Y|yes) : ;; *) echo "  nothing done"; return 1 ;; esac
      fi
    fi
  else
    ok "$from to $to stays inside $(ferry_version_mm "$to"), so the data directory is kept"
  fi

  # Rolling back is itself a change worth being able to undo.
  if running ferry-cri && have_cluster; then
    local now
    now="$(etcd_snapshot "$from-before-rollback")" && ok "snapshotted $from at $now"
  fi
  echo
  upgrade_restore "$from" "$to" "$snapshot" "$keep" || return 1
  echo
  echo "  Nodes that were moved to $from have a kubelet newer than the API"
  echo "  server now, which is the one skew Kubernetes does not allow. Roll them"
  echo "  back, and soon:"
  echo
  echo "      ferry upgrade nodes"
}

# --- nodes ----------------------------------------------------------------

# Restart this Mac's ferry-proxyd at a version, on the same arguments it has.
restart_proxyd() { # version
  local version="$1"
  [ -x "$(ferry_version_dir "$version")/ferry-proxyd" ] || {
    warn "the store has no ferry-proxyd for $version; kube-proxy stays at $(ferry_proxyd_version 2>/dev/null || echo 'what it was')"
    return 1; }
  local node_ip conf name=""
  node_ip="$(cat "$FERRY_RUN/ferry-proxyd.node-ip" 2>/dev/null || cat "$FERRY_RUN/cri/gateway" 2>/dev/null)"
  if [ -f "$FERRY_RUN/kubelet.conf" ]; then
    conf="$FERRY_RUN/kubelet.conf"; name="$(cat "$FERRY_RUN/node-name" 2>/dev/null)"
  else
    conf="$FERRY_HOME/admin.conf"
  fi
  # Pods keep the rules they were last given while it is gone, and ferry-cri
  # asks again until the new one answers; nothing in the data path waits on it.
  stop_kubelet "$FERRY_RUN/ferry-proxyd.pid"
  start_proxyd "$conf" "$node_ip" "$name" "$version"
}

cmd_upgrade_node() {
  # Not seeded from $1, for the same reason 'apply' is not: 'node --force'
  # would otherwise try to drain a node called "--force".
  local name="" force="" target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      --to) [ -n "${2:-}" ] || { bad "--to needs a version"; return 2; }; target="$2"; shift 2 ;;
      --to=*) target="${1#*=}"; shift ;;
      -*) bad "usage: ferry upgrade node <name> [--to vX.Y.Z] [--force]"; return 2 ;;
      *) name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || { bad "usage: ferry upgrade node <name> [--to vX.Y.Z] [--force]"; return 2; }
  if [ -n "$target" ] && ! ferry_version_valid "$target"; then
    bad "--to $target is not a version like v1.34.0"; return 2
  fi
  require_cluster || return 1

  local index
  index="$(local_node_index "$name")" || {
    bad "$name is not a node this Mac runs"
    echo "    Nodes on this Mac:"
    local n
    while read -r _ n; do [ -n "$n" ] && echo "      $n"; done <<< "$(local_nodes)"
    echo
    echo "    A node on another Mac is upgraded from that Mac: copy the new"
    echo "    binaries there and run 'ferry upgrade node $name' on it."
    return 1; }

  # By default, to the cluster's own version: what 'apply' just moved the
  # control plane to, or what 'rollback' just took it back to.
  [ -n "$target" ] || target="$(ferry_default_node_version)"
  [ -n "$target" ] || { bad "nothing is built; run 'ferry build' first"; return 1; }
  local api; api="$(apiserver_version)"
  local current; current="$(node_kubelet_version "$name")"

  bold "upgrading node $name: ${current:-unknown} -> $target"
  if [ "$current" = "$target" ]; then
    # Recorded too, for a node started before nodes kept a record: it is
    # running the right kubelet, and draining it to write that down would be
    # an upgrade for the sake of bookkeeping.
    ferry_record_node_version "$name" "$target"
    ok "already at $target"
    [ "$index" = 0 ] && upgrade_proxyd_to "$target" "$api"
    return 0
  fi

  local reason; reason="$(ferry_kubelet_skew_reason "$target" "$api")"
  [ -n "$reason" ] && { bad "$reason"; return 1; }
  ok "$target against an API server at $api is inside the supported skew"

  # A version nothing has built yet is built now, before the node is drained,
  # so a build that fails costs time and not a cordoned node.
  if [ ! -x "$(ferry_version_dir "$target")/kubelet" ]; then
    is_release && { bad "the store has no kubelet $target, and a release cannot build one"; return 1; }
    echo "  building kubelet $target"
    build_kubernetes_binaries "$target" || { bad "build failed; $name was not touched"; return 1; }
  fi

  # Drain. Eviction rather than deletion, so PodDisruptionBudgets are honoured
  # -- which is upstream's machinery and works here unchanged, because the API
  # server is upstream's.
  #
  # Except CoreDNS, on the control plane Mac's own node. It claims the address
  # ferry reserves for cluster DNS, which belongs to that node's pod subnet and
  # no other, and every kubelet is told to use it -- so evicted, it comes back
  # on another node at another address and cluster DNS is gone until something
  # happens to put it back. Found by draining node 0 with a second node beside
  # it. Left in place it keeps answering: the runtime holds its VM across the
  # kubelet swap, as it does for anything the drain does not move.
  local keep=""
  [ "$index" = 0 ] && [ -f "$FERRY_HOME/admin.conf" ] && [ ! -f "$FERRY_RUN/kubelet.conf" ] \
    && keep="k8s-app!=kube-dns"
  local note=""
  [ -n "$keep" ] && note=" (leaving CoreDNS, which holds the DNS address of this node)"
  echo "  draining $name$note"
  if ! kube drain "$name" --ignore-daemonsets --delete-emptydir-data \
        ${keep:+--pod-selector="$keep"} \
        ${force:+--force} --timeout="${FERRY_DRAIN_TIMEOUT:-300s}" 2>&1 | sed 's/^/    /'; then
    bad "drain failed"
    echo "    Pods with no controller are not evicted without --force, which"
    echo "    deletes them outright rather than moving them:"
    echo "        ferry upgrade node $name --force"
    kube uncordon "$name" >/dev/null 2>&1
    return 1
  fi
  ok "drained"

  # Replace. The runtime keeps running: it holds the pod VMs and carries no
  # Kubernetes version of its own, so anything drain left in place -- a
  # DaemonSet pod, a mirror pod -- stays up across the swap.
  local run kubeconfig bootstrap pidfile logfile
  eval "$(node_layout "$index")"
  stop_kubelet "$pidfile"
  ok "kubelet stopped, runtime left up"

  start_kubelet "$name" "$run" "$kubeconfig" "$pidfile" "$logfile" "$bootstrap" "$index" "$target"
  if wait_node_version "$name" "$target" 120; then
    ok "node Ready, kubelet $target"
  else
    if node_ready "$name"; then
      bad "$name is Ready but reports $(node_kubelet_version "$name"), not $target"
    else
      bad "$name did not come back Ready"
    fi
    tail -10 "$logfile" | sed 's/^/    /'
    echo "    The node is still cordoned. Fix it and uncordon: kubectl uncordon $name"
    return 1
  fi

  kube uncordon "$name" >/dev/null 2>&1 && ok "uncordoned"
  # kube-proxy is per Mac and moves with the Mac's own node.
  [ "$index" = 0 ] && upgrade_proxyd_to "$target" "$api"
  return 0
}

# Move this Mac's ferry-proxyd to a version, if it is not there already and
# kube-proxy's skew allows it -- the kubelet's rule, against the same API server.
upgrade_proxyd_to() { # version apiserver-version
  [ -f "$FERRY_RUN/ferry-proxyd.pid" ] || return 0
  local have; have="$(ferry_proxyd_version 2>/dev/null)"
  [ "$have" = "$1" ] && return 0
  local reason; reason="$(ferry_kubelet_skew_reason "$1" "$2")"
  if [ -n "$reason" ]; then warn "ferry-proxyd left at ${have:-its version}: ${reason/a kubelet/kube-proxy}"; return 0; fi
  if restart_proxyd "$1"; then ok "ferry-proxyd (kube-proxy) ${have:-unknown} -> $1"
  else warn "ferry-proxyd did not come back at $1; Services on this Mac stay on their last rules"; fi
}

cmd_upgrade_nodes() {
  local args=() target="" a
  for a in "$@"; do args+=("$a"); done
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) target="${2:-}"; shift 2 || shift ;;
      --to=*) target="${1#*=}"; shift ;;
      *) shift ;;
    esac
  done
  require_cluster || return 1
  [ -n "$target" ] || target="$(ferry_default_node_version)"
  bold "rolling every node on this Mac to $target"
  echo

  local index name failed=0
  while read -r index name; do
    [ -n "$name" ] || continue
    # </dev/null so nothing inside can eat the node list this loop is reading.
    cmd_upgrade_node "$name" ${args[@]+"${args[@]}"} </dev/null || { failed=1; break; }
    echo
  done <<< "$(local_nodes)"

  if [ "$failed" = 1 ]; then
    bad "stopped at the first node that did not come back"
    echo "    The rest are untouched and still running their old kubelet, which"
    echo "    is a supported state. Fix this one before going on."
    return 1
  fi
  bold "every node on this Mac is $target"
  # Nodes this Mac does not run, that are not at the target yet. The local ones
  # have to be excluded by name rather than by version: this Mac's nodes were
  # just upgraded, and listing one of them here as a node "on another Mac" is
  # both wrong and a direct contradiction of the line above.
  local others
  others="$( { local_nodes | awk '{print "L", $2}'
               kube get nodes -o jsonpath='{range .items[*]}{"N "}{.metadata.name}{" "}{.status.nodeInfo.kubeletVersion}{"\n"}{end}' 2>/dev/null; } \
             | awk -v t="$target" '
                 $1 == "L" { mine[$2] = 1; next }
                 $1 == "N" && !mine[$2] && $3 != t { print "      " $2 " (" $3 ")" }')"
  if [ -n "$others" ]; then
    echo
    echo "  Nodes on other Macs are still behind. Each is upgraded from its own"
    echo "  Mac, because each has its own checkout and its own binaries:"
    echo "$others"
  fi
}

# --- status ---------------------------------------------------------------

cmd_upgrade_status() {
  bold "versions"
  local cluster; cluster="$(ferry_cluster_field kubernetes 2>/dev/null || echo "-")"
  local active; active="$(ferry_active_version)"
  echo "  cluster       $cluster (control plane $(ferry_cluster_field control-plane 2>/dev/null || echo -), etcd $(ferry_cluster_field etcd 2>/dev/null || echo -))"
  echo "  this checkout ${active:-nothing built}"
  local previous; previous="$(ferry_previous_field kubernetes 2>/dev/null || echo "")"
  [ -n "$previous" ] && echo "  rollback to   $previous"

  # What each node on this Mac was last started as, which is what it will be
  # started as again.
  local index name v nodes; nodes="$(local_nodes)"
  if [ -n "$nodes" ]; then
    while read -r index name; do
      [ -n "$name" ] || continue
      v="$(ferry_node_version "$name" 2>/dev/null || echo "-")"
      printf '  node          %s kubelet %s\n' "$name" "$v"
    done <<< "$nodes"
  fi
  v="$(ferry_proxyd_version 2>/dev/null)" && echo "  kube-proxy    ferry-proxyd $v"

  echo
  bold "in the store"
  local version line refs; refs="$(ferry_store_referenced 2>/dev/null)"
  for version in $(ferry_version_list); do
    line="  $version"
    [ "$version" = "$active" ] && line="$line  <- bin/ points here"
    ferry_version_complete "$version" || line="$line  (incomplete)"
    printf '%s\n' "$refs" | grep -qx "$version" || line="$line  (unused)"
    echo "$line"
  done
  [ -z "$(ferry_version_list)" ] && echo "  nothing; run 'ferry build'"

  if have_cluster; then
    echo
    bold "nodes"
    kube get nodes -o custom-columns='NAME:.metadata.name,VERSION:.status.nodeInfo.kubeletVersion,READY:.status.conditions[?(@.type=="Ready")].status' 2>/dev/null \
      | sed 's/^/  /'
  fi

  local backups; backups="$(find "$FERRY_HOME/backups" -name '*.db' 2>/dev/null | sort | tail -5)"
  if [ -n "$backups" ]; then
    echo
    bold "recent etcd snapshots"
    echo "$backups" | sed 's|^|  |'
  fi
}

# Remove the versions in the store that nothing uses.
#
# "Uses" is ferry_store_referenced: the cluster, where rollback would go, what
# bin/ points at, the version every node on this Mac last ran and this Mac's
# ferry-proxyd. Taking any of those breaks a restart or a rollback. A version a
# process is running from right now is kept as well, whatever the records say.
cmd_upgrade_prune() {
  local yes=""
  case "${1:-}" in
    -y|--yes) yes=1 ;;
    "") : ;;
    *) bad "usage: ferry upgrade prune [--yes]"; return 2 ;;
  esac
  local running; running="$(ps -axo args= 2>/dev/null | grep -o "$(ferry_versions_dir)/v[^/]*/" | sort -u)"
  local v candidates=()
  for v in $(ferry_store_unreferenced); do
    if printf '%s\n' "$running" | grep -qF "$(ferry_version_dir "$v")/"; then
      warn "$v is unreferenced but a process is running from it; kept"
      continue
    fi
    candidates+=("$v")
  done
  if [ "${#candidates[@]}" -eq 0 ]; then ok "every version in the store is in use"; return 0; fi
  for v in "${candidates[@]}"; do
    echo "  $v  $(du -sh "$(ferry_version_dir "$v")" 2>/dev/null | cut -f1)"
  done
  if [ -z "$yes" ]; then
    echo "  Nothing removed. To remove these: ferry upgrade prune --yes"
    return 0
  fi
  for v in "${candidates[@]}"; do rm -rf "$(ferry_version_dir "$v")" && ok "removed $v"; done
}

cmd_upgrade() {
  case "${1:-status}" in
    plan)     shift; cmd_upgrade_plan "$@" ;;
    apply)    shift; cmd_upgrade_apply "$@" ;;
    node)     shift; cmd_upgrade_node "$@" ;;
    nodes)    shift; cmd_upgrade_nodes "$@" ;;
    rollback) shift; cmd_upgrade_rollback "$@" ;;
    status)   shift; cmd_upgrade_status "$@" ;;
    prune)    shift; cmd_upgrade_prune "$@" ;;
    *) bad "usage: ferry upgrade <plan|apply|node|nodes|rollback|status|prune>"; return 2 ;;
  esac
}

# Things everybody wants and nobody should have to hunt for. The mechanism is in
# lib/addons.sh; this is only the verbs.
# shellcheck source=lib/addons.sh
. "$here/lib/addons.sh"
cmd_addons() {
  local action="${1:-list}"; shift 2>/dev/null || true
  export KUBECONFIG="$FERRY_HOME/admin.conf" LAN_IP NODE_NAME FERRY_HOME

  case "$action" in
    list|ls) addon_list ;;
    enable|disable)
      local no_wait="" names=() arg
      for arg in "$@"; do
        case "$arg" in --no-wait) no_wait=--no-wait ;; *) names+=("$arg") ;; esac
      done
      [ "${#names[@]}" -gt 0 ] || { bad "usage: ferry addons $action <name>... [--no-wait]"; return 2; }
      kubectl get --raw /readyz >/dev/null 2>&1 || { bad "ferry is not up"; return 1; }
      local name failed=0
      for name in "${names[@]}"; do
        if [ "$action" = enable ]; then addon_enable "$name" $no_wait || failed=1
        else addon_disable "$name" || failed=1; fi
      done
      return "$failed" ;;
    images)
      [ -n "${1:-}" ] || { bad "usage: ferry addons images <name>"; return 2; }
      bold "images in $1"; addon_images "$1" ;;
    *) bad "usage: ferry addons [list|enable <name>...|disable <name>...|images <name>]"; return 2 ;;
  esac
}

# Build an image here, with no Docker anywhere.
#
# The builder is buildkit, running as an ordinary pod -- which is to say as a
# virtual machine with its own kernel, so it gets the namespaces and the
# overlayfs it wants without anything on the Mac being relaxed for it. The
# client is buildctl on the Mac, talking to the pod at the address Kubernetes
# knows it by: the Mac is on the pod's vmnet subnet (docs/POD-NETWORK.md), so
# there is no port to forward and no proxy in the path.
#
# Sizing is not a detail. A pod inherits 2 CPUs and 512 MiB, and a builder that
# takes the default builds `npm install` in 16.8 s where the same buildkit on 8
# CPUs takes 7.6 s -- experiment 25 measured that gap and mistook it for an
# argument about architecture for most of an afternoon. So the builder is sized
# deliberately, at half the machine by default.
#
# It stays up between builds, because its layer cache is what makes the second
# build fast, and at ~330 MiB of lazily-backed guest memory that is a cheap
# thing to keep. `ferry image build --stop` ends it.
FERRY_BUILDER_POD="${FERRY_BUILDER_POD:-ferry-builder}"
FERRY_BUILDER_NS="${FERRY_BUILDER_NS:-kube-system}"
FERRY_BUILDKIT_IMAGE="${FERRY_BUILDKIT_IMAGE:-moby/buildkit:v0.29.0}"

# Certificates for the builder, so that reaching it is not the same as using it.
#
# buildkitd has to listen on the pod's real address: the Mac talks to pods over
# the pod network and there is no other path to it -- `kubectl port-forward`
# dials the pod's address too, so binding to the pod's localhost only makes it
# unreachable from everywhere including here. That address is one every pod on
# the cluster shares, and a privileged build daemon that anything can drive is
# a way to run as root in a VM with the whole build cache in it.
#
# A NetworkPolicy says the right thing and is not enough on its own. ferry
# enforces policy with nftables in the pod's own kernel, and the stock guest
# kernel has no nftables -- `nft` there fails with "cache initialization
# failed", the same reason ClusterIPs need a host proxy until you build a
# kernel with `ferry kernel`. So on a default install the policy is inert. It
# is applied anyway, because it is correct and it does enforce on a kernel that
# can, but it cannot be the only thing standing between a workload and this.
#
# Mutual TLS does not care what the guest kernel can do. The daemon requires a
# client certificate, the Mac has the only one, and the exposure goes from
# "every pod on the network" to "whoever can read $FERRY_HOME/pki/builder".
#
# The certificates are ferry's own, not the cluster's: reusing the Kubernetes
# CA for a service Kubernetes does not know about would make one CA's
# compromise mean more than it has to.
ferry_builder_pki_dir() { echo "$FERRY_HOME/pki/builder"; }

# The name the client asks for, and the only name the server certificate
# carries.
#
# It is not a resolvable name and does not need to be: the pod's address is
# what gets dialled, and `buildctl --tlsservername` says what to verify against
# once connected. A certificate pinned to an address instead would have to be
# reissued every time the builder pod is recreated, which is every time it is
# resized.
FERRY_BUILDER_CN="${FERRY_BUILDER_CN:-ferry-builder}"

ferry_builder_pki() {
  local dir; dir="$(ferry_builder_pki_dir)"
  # Reissue when anything is missing or the server certificate has expired, so
  # a builder that has not been started in a year still starts.
  if [ -f "$dir/client.key" ] && [ -f "$dir/server.key" ] && [ -f "$dir/ca.crt" ] \
     && openssl x509 -in "$dir/server.crt" -checkend 0 >/dev/null 2>&1; then
    return 0
  fi

  mkdir -p "$dir"
  chmod 700 "$dir"
  echo "  issuing builder certificates"

  # Ten years: this is a local development CA whose private key sits next to the
  # certificates it signed, so a short lifetime buys nothing and an expiry in
  # the middle of a working day costs something.
  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -keyout "$dir/ca.key" -out "$dir/ca.crt" \
    -subj "/CN=ferry builder CA" >/dev/null 2>&1 || return 1

  # The server. The SAN is what --tlsservername will be checked against; the
  # CN is ignored by modern verifiers and is set to match only for readability.
  openssl req -newkey rsa:2048 -nodes \
    -keyout "$dir/server.key" -out "$dir/server.csr" \
    -subj "/CN=$FERRY_BUILDER_CN" >/dev/null 2>&1 || return 1
  openssl x509 -req -in "$dir/server.csr" -days 3650 \
    -CA "$dir/ca.crt" -CAkey "$dir/ca.key" -CAcreateserial \
    -extfile <(printf 'subjectAltName=DNS:%s\nextendedKeyUsage=serverAuth\n' "$FERRY_BUILDER_CN") \
    -out "$dir/server.crt" >/dev/null 2>&1 || return 1

  # The client. buildkitd requires one because it is given a CA to verify
  # against, which is what turns TLS into authentication rather than encryption.
  openssl req -newkey rsa:2048 -nodes \
    -keyout "$dir/client.key" -out "$dir/client.csr" \
    -subj "/CN=ferry" >/dev/null 2>&1 || return 1
  openssl x509 -req -in "$dir/client.csr" -days 3650 \
    -CA "$dir/ca.crt" -CAkey "$dir/ca.key" -CAcreateserial \
    -extfile <(printf 'extendedKeyUsage=clientAuth\n') \
    -out "$dir/client.crt" >/dev/null 2>&1 || return 1

  rm -f "$dir/server.csr" "$dir/client.csr"
  chmod 600 "$dir"/*.key
}

# Half the machine, rounded down, and never less than two.
#
# Half rather than all of it because the Mac is still running the cluster, the
# control plane and whatever the person is doing while they wait. Measured on a
# 16-core Mac, 8 CPUs matched Docker Desktop's whole 16-CPU VM on every
# workload, so the other half buys nothing worth having.
ferry_builder_cpus() {
  local total; total="$(sysctl -n hw.ncpu 2>/dev/null || echo 4)"
  local half=$(( total / 2 ))
  [ "$half" -lt 2 ] && half=2
  echo "$half"
}

# A quarter of the machine's memory, between 2 and 8 GiB.
#
# Guest memory is lazily backed, so this is a ceiling the builder is allowed to
# reach rather than an allocation taken from the Mac -- an idle builder sized at
# 4 GiB was measured at 330 MiB of host footprint. The cap is there because a
# ceiling is not entirely free: Apple's kernel config allocates a struct page
# per 4 KiB of it at boot.
ferry_builder_memory_gib() {
  local bytes; bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 8589934592)"
  local quarter=$(( bytes / 1073741824 / 4 ))
  [ "$quarter" -lt 2 ] && quarter=2
  [ "$quarter" -gt 8 ] && quarter=8
  echo "$quarter"
}

ferry_kubectl() { KUBECONFIG="$FERRY_HOME/admin.conf" kubectl -n "$FERRY_BUILDER_NS" "$@"; }

ferry_builder_ip() {
  ferry_kubectl get pod "$FERRY_BUILDER_POD" -o jsonpath='{.status.podIP}' 2>/dev/null
}

# The client half of the connection, used by every buildctl call here.
#
# --tlsservername is what lets one certificate outlive the pod: it is checked
# against the SAN instead of the address, and the address changes whenever the
# builder is recreated.
ferry_buildctl_tls() {
  local pki; pki="$(ferry_builder_pki_dir)"
  printf '%s\n' \
    --tlscacert "$pki/ca.crt" \
    --tlscert "$pki/client.crt" \
    --tlskey "$pki/client.key" \
    --tlsservername "$FERRY_BUILDER_CN"
}

ferry_builder_answers() {
  local ip; ip="$(ferry_builder_ip)"
  [ -n "$ip" ] || return 1
  local tls=(); while IFS= read -r a; do tls+=("$a"); done < <(ferry_buildctl_tls)
  buildctl --addr "tcp://$ip:1234" "${tls[@]}" debug workers >/dev/null 2>&1
}

# Bring the builder up if it is not already, and wait until it answers.
#
# Polled at 50 ms because it is ready in about 700 ms and half-second ticks
# would charge most of a second for something that has already happened.
ferry_builder_up() {
  if ferry_builder_answers; then return 0; fi

  local cpus mem
  cpus="${FERRY_BUILDER_CPUS:-$(ferry_builder_cpus)}"
  mem="${FERRY_BUILDER_MEMORY_GIB:-$(ferry_builder_memory_gib)}"

  # Recreate rather than patch: a pod's resources are the VM's size and cannot
  # be changed under it.
  ferry_kubectl delete pod "$FERRY_BUILDER_POD" --ignore-not-found --wait=true >/dev/null 2>&1

  ferry_builder_pki || { bad "could not issue builder certificates"; return 1; }
  local pki; pki="$(ferry_builder_pki_dir)"
  # Recreated from the files on every start, so rotating them is deleting the
  # directory and building again.
  ferry_kubectl delete secret "$FERRY_BUILDER_POD-tls" --ignore-not-found >/dev/null 2>&1
  ferry_kubectl create secret generic "$FERRY_BUILDER_POD-tls" \
    --from-file=ca.crt="$pki/ca.crt" \
    --from-file=tls.crt="$pki/server.crt" \
    --from-file=tls.key="$pki/server.key" >/dev/null 2>&1 \
    || { bad "could not store the builder certificates"; return 1; }

  echo "  starting the builder ($cpus cpu, ${mem} GiB)"
  # The policy goes on with the pod, in one apply, so there is no window where
  # the builder is up and unprotected.
  ferry_kubectl apply -f - >/dev/null <<YAML || { bad "could not create the builder pod"; return 1; }
# Nothing in the cluster may talk to the builder.
#
# buildkitd listens on tcp://0.0.0.0:1234 with no TLS and no authentication,
# and it is privileged -- anything that can reach it can run arbitrary builds
# as root inside the builder VM. That is fine for the client it is meant for
# and not fine for the rest of the cluster, which can reach it: the Mac is on
# the pod subnet natively, so pods and host share one flat network and there
# is no proxy in between to say no.
#
# An ingress policy selecting nothing denies every pod. The Mac keeps working
# without being named, because ferry-netpol exempts a pod's own node's address
# on the pod network from ingress policy before any rule is consulted
# (writeIngressGuards in ferry-netpol/compile.go) -- it has to, or a kubelet
# probe could not reach a pod that denies ingress. So "deny all pods, allow the
# developer" is the empty policy, and nothing here has to know the gateway's
# address.
#
# This is enforcement in the builder's own kernel, not advice: ferry-netpol
# compiles it to nftables and ferry-cri loads it into that pod
# (docs/NETWORK-POLICY.md). If ferry-netpol is not running the policy is inert,
# which is the same exposure as before it existed rather than a new one.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: $FERRY_BUILDER_POD
  labels:
    app.kubernetes.io/name: ferry-builder
    app.kubernetes.io/managed-by: ferry
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: ferry-builder
  policyTypes: [Ingress]
---
apiVersion: v1
kind: Pod
metadata:
  name: $FERRY_BUILDER_POD
  labels:
    app.kubernetes.io/name: ferry-builder
    app.kubernetes.io/managed-by: ferry
spec:
  # Nothing in the cluster should evict the thing the person is waiting on.
  priorityClassName: system-node-critical
  containers:
    - name: buildkitd
      image: $FERRY_BUILDKIT_IMAGE
      imagePullPolicy: IfNotPresent
      # --tlscacert is what makes this authentication and not just encryption:
      # given a CA, buildkitd requires a client certificate signed by it. The
      # Mac holds the only one.
      args:
        - --addr
        - tcp://0.0.0.0:1234
        - --tlscacert
        - /certs/ca.crt
        - --tlscert
        - /certs/tls.crt
        - --tlskey
        - /certs/tls.key
      securityContext:
        privileged: true
      ports:
        - containerPort: 1234
      volumeMounts:
        - name: tls
          mountPath: /certs
          readOnly: true
      resources:
        limits:
          cpu: "$cpus"
          memory: ${mem}Gi
  volumes:
    - name: tls
      secret:
        secretName: $FERRY_BUILDER_POD-tls
YAML

  local i=0
  while [ "$i" -lt 1200 ]; do
    ferry_builder_answers && return 0
    sleep 0.05
    i=$((i + 1))
  done
  bad "the builder did not come up; see 'kubectl -n $FERRY_BUILDER_NS logs $FERRY_BUILDER_POD'"
  return 1
}

cmd_image_build() {
  local tag="" dockerfile="" context="" no_cache="" progress=auto
  local -a build_args=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --stop)
        ferry_kubectl delete pod "$FERRY_BUILDER_POD" --ignore-not-found >/dev/null 2>&1
        ferry_kubectl delete networkpolicy "$FERRY_BUILDER_POD" --ignore-not-found >/dev/null 2>&1
        # The secret goes too: it holds the server key, and leaving it in the
        # cluster after the thing that used it is gone is how a key outlives
        # anyone's memory of it. The Mac's copy under $FERRY_HOME/pki/builder
        # stays, so the next build reuses the same CA rather than reissuing.
        ferry_kubectl delete secret "$FERRY_BUILDER_POD-tls" --ignore-not-found >/dev/null 2>&1
        ok "builder stopped"
        return 0 ;;
      -t|--tag)
        [ $# -ge 2 ] || { bad "-t needs a name, such as myapp:dev"; return 2; }
        tag="$2"; shift 2 ;;
      -f|--file)
        [ $# -ge 2 ] || { bad "-f needs a path to a Dockerfile"; return 2; }
        dockerfile="$2"; shift 2 ;;
      --build-arg)
        [ $# -ge 2 ] || { bad "--build-arg needs KEY=VALUE"; return 2; }
        build_args+=(--opt "build-arg:$2"); shift 2 ;;
      --no-cache) no_cache=1; shift ;;
      --quiet|-q) progress=quiet; shift ;;
      -h|--help)
        echo "usage: ferry image build [-t <name:tag>] [-f <Dockerfile>] [--build-arg K=V]"
        echo "                         [--no-cache] [--quiet] [<context>]"
        echo "       ferry image build --stop"
        return 0 ;;
      -*) bad "unknown flag $1"; return 2 ;;
      *)  context="$1"; shift ;;
    esac
  done

  context="${context:-.}"
  [ -d "$context" ] || { bad "no such build context: $context"; return 1; }
  context="$(cd "$context" && pwd)"
  dockerfile="${dockerfile:-$context/Dockerfile}"
  [ -f "$dockerfile" ] || { bad "no Dockerfile at $dockerfile"; return 1; }

  [ -S "$FERRY_EXEC_SOCK" ] || { bad "ferry is not up"; return 1; }

  # buildctl is the one thing ferry does not carry. It is small, and it is the
  # same client the rest of the world uses.
  command -v buildctl >/dev/null 2>&1 || {
    bad "buildctl is not installed"
    echo "    ferry runs the builder; the client comes from buildkit:"
    echo "        brew install buildkit"
    return 1
  }

  # An untagged image loads as untagged@sha256:..., which nothing can write in
  # a pod spec. Naming it is not optional, so there is a default.
  [ -n "$tag" ] || tag="$(basename "$context"):latest"

  bold "building $tag"
  ferry_builder_up || return 1

  local ip; ip="$(ferry_builder_ip)"
  local staging; staging="$(mktemp -d "${TMPDIR:-/tmp}/ferry-build.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -rf '$staging'" RETURN
  local layout="$staging/image.tar"

  local -a tls=(); while IFS= read -r a; do tls+=("$a"); done < <(ferry_buildctl_tls)
  local -a args=(
    --addr "tcp://$ip:1234" "${tls[@]}" build
    --frontend dockerfile.v0
    --local "context=$context"
    --local "dockerfile=$(dirname "$dockerfile")"
    --opt "filename=$(basename "$dockerfile")"
    --progress "$progress"
    --output "type=oci,name=$tag,dest=$layout"
  )
  [ -n "$no_cache" ] && args+=(--no-cache)
  [ ${#build_args[@]} -gt 0 ] && args+=("${build_args[@]}")

  buildctl "${args[@]}" || { bad "build failed"; return 1; }

  # Straight into the image store ferry-cri serves pods from, by the same path
  # `ferry image load` uses -- so the image is present before the next `kubectl
  # apply`, with no registry in between.
  cmd_image_load "$layout" >/dev/null || { bad "built, but could not load it"; return 1; }
  ok "built and loaded $tag"
  echo
  echo "    image: $tag"
  echo "    Pods must not try to fetch it: set"
  echo "      imagePullPolicy: IfNotPresent   (or Never)"
}

# Run an image you just built.
#
# Everything else in ferry comes from a registry, which is fine for busybox and
# useless for the thing you are working on. 'minikube image load' and 'kind load
# docker-image' exist for this, and until now ferry had no answer at all.
#
# What arrives can be an OCI layout directory, an archive of one, or the name of
# an image Docker or Podman is holding -- in the last case ferry asks that tool
# to export it first. The image keeps the name it already has, so a manifest
# saying `myapp:dev` still says that.
# The same images for every other node, through this Mac's registry: machines,
# the other nodes on this Mac, and nodes on other Macs, which ask it over the
# peer port. See start_registry.
#
# Also when the registry is running but the variable is not set in this shell:
# the setting belongs to `ferry up`, and a load from another terminal that
# quietly skipped the other nodes would be the bug this exists to fix, again.
machine_registry_add() { # layout
  machine_registry_enabled || running ferry-registry || return 0
  [ -x "$here/bin/ferry-registry" ] || {
    warn "not shared with other nodes: bin/ferry-registry is missing -- run 'ferry build'"
    return 0; }
  local name out="$FERRY_RUN/registry-add.out" err="$FERRY_RUN/registry-add.err"
  if "$here/bin/ferry-registry" add --store "$REGISTRY_DIR" "$1" >"$out" 2>"$err"; then
    while read -r name; do [ -n "$name" ] && ok "shared with every node as $name"; done < "$out"
  else
    warn "not shared with other nodes: $(tail -1 "$err")"
  fi
  rm -f "$out" "$err"
}

# The other nodes on this Mac, loaded directly.
#
# The registry would serve them on their first pull, but a pod that says
# `imagePullPolicy: Never` never pulls, and on a node that had not loaded the
# image that was ErrImageNeverPull. They are on this Mac and their stores are a
# socket away, so each is handed the layout too: Never then works on every
# node here, and the cost is one unpack per node, which a pull would pay anyway.
load_into_added_nodes() { # layout
  local index sock reply
  for index in $(seq 1 "$FERRY_MAX_NODE_SCAN"); do
    [ -f "$FERRY_RUN/node-$index.pid" ] || continue
    sock="/tmp/ferry-exec$SUFFIX-$index.sock"
    [ -S "$sock" ] || continue
    reply="$(printf '{"op":"loadimage","path":"%s"}\n' "$1" | nc -U "$sock" 2>/dev/null)"
    case "$reply" in
      *'"images"'*) ok "loaded into node $index too" ;;
      *) warn "node $index did not take it; it will pull it from the registry instead" ;;
    esac
  done
}

cmd_image_load() {
  local what="${1:-}"
  [ -n "$what" ] || { bad "usage: ferry image load <name|archive.tar|oci-directory>"; return 2; }
  [ -S "$FERRY_EXEC_SOCK" ] || { bad "ferry is not up"; return 1; }

  local staging; staging="$(mktemp -d "${TMPDIR:-/tmp}/ferry-load.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -rf '$staging'" RETURN

  local layout=
  if [ -d "$what" ]; then
    layout="$what"
  elif [ -f "$what" ]; then
    tar -xf "$what" -C "$staging" 2>/dev/null || { bad "could not unpack $what"; return 1; }
    layout="$staging"
  else
    # A name: ask whichever tool has it to hand over an OCI archive. Docker's
    # plain 'save' format is not one, so the flag is not optional.
    local exported="$staging/image.tar"
    if command -v docker >/dev/null 2>&1 && docker image inspect "$what" >/dev/null 2>&1; then
      echo "  exporting $what from docker"
      # Only the node's platform. With the containerd image store, a plain save
      # of anything multi-platform writes the whole index -- seventeen manifests
      # for busybox -- but blobs only for the platform that was pulled, and the
      # archive is then missing most of what it says it holds. --platform is
      # Docker 28 and later; older ones get the plain save and ferry-cri picks
      # the platform out of the index.
      docker save --platform linux/arm64 --output "$exported" "$what" >/dev/null 2>&1 \
        || docker save --output "$exported" "$what" >/dev/null 2>&1 \
        || { bad "docker save failed"; return 1; }
    elif command -v podman >/dev/null 2>&1 && podman image exists "$what" 2>/dev/null; then
      echo "  exporting $what from podman"
      podman save --format oci-archive --output "$exported" "$what" >/dev/null 2>&1 \
        || { bad "podman save failed"; return 1; }
    else
      bad "no such file, directory, or local image: $what"
      return 1
    fi
    mkdir -p "$staging/layout"
    tar -xf "$exported" -C "$staging/layout" 2>/dev/null || { bad "could not unpack the export"; return 1; }
    layout="$staging/layout"
  fi

  # An OCI layout says so. Anything else will fail inside ferry-cri with a less
  # helpful message, so it is worth saying here.
  if [ ! -f "$layout/oci-layout" ] || [ ! -f "$layout/index.json" ]; then
    bad "$what is not an OCI layout (no oci-layout/index.json)"
    echo "    Docker's default 'save' format is not one. Export with:"
    echo "      docker save <name> | ...   # docker 25+ with the containerd store"
    echo "      podman save --format oci-archive <name> -o image.tar"
    return 1
  fi

  # ferry-cri owns the image store, so the load happens there. One JSON line in,
  # one back, over the socket it already listens on.
  echo "  loading into the image store"
  local reply
  reply="$(printf '{"op":"loadimage","path":"%s"}\n' "$layout" | nc -U "$FERRY_EXEC_SOCK" 2>/dev/null)"

  case "$reply" in
    *'"images"'*)
      # {"images":["a","b"]} -> one name per line, without reaching for a parser.
      echo "$reply" \
        | sed -e 's/.*"images":\[//' -e 's/\].*//' -e 's/","/\n/g' -e 's/"//g' -e 's|\\/|/|g' \
        | while read -r name; do [ -n "$name" ] && ok "loaded $name"; done
      load_into_added_nodes "$layout"
      machine_registry_add "$layout"
      echo
      echo "  Pods must not try to fetch it again: set"
      if machine_registry_enabled || running ferry-registry; then
        # Never means a kubelet does not pull, and pulling from a registry is
        # how a machine, or a node on another Mac, gets the image.
        echo "    imagePullPolicy: IfNotPresent   (Never works on this Mac's nodes only:"
        echo "                                     machines and other Macs pull it from here)"
      else
        echo "    imagePullPolicy: IfNotPresent   (or Never)"
      fi
      ;;
    *'"error"'*)
      bad "$(echo "$reply" | sed -n 's/.*"error":"\(.*\)".*/\1/p')" ;;
    *)
      bad "ferry-cri did not answer; see 'ferry logs ferry-cri'" ;;
  esac
}

# What this checkout is using, and why.
#
# Worth being able to ask: when two clusters are running on one Mac the first
# question is always which one you are talking to.
cmd_profile() {
  bold "profile $PROFILE"
  echo "  kubernetes  $(ferry_cluster_field kubernetes 2>/dev/null || ferry_active_version || echo 'not built')"
  echo "  state       $FERRY_HOME"
  echo "  runtime     $FERRY_RUN"
  echo "  node name   $NODE_NAME"
  echo "  pod network $CLUSTER_CIDR"
  # What the running cluster actually got, which is not always the above: see
  # the fallback in ferry-cri's prepare().
  local gateway; gateway="$(cat "$FERRY_RUN/cri/gateway" 2>/dev/null)"
  if running ferry-cri && [ -n "$gateway" ] && ! ip_in_cidr "$gateway" "$CLUSTER_CIDR"; then
    warn "running off it, on ${gateway%.*}.0/24 -- its slice was still reserved at 'ferry up'"
  fi
  echo "  api server  https://$(lan_address):$(( 6443 + PORT_SHIFT ))"
  echo "  kubelet     $(( 10250 + PORT_SHIFT ))"
  echo "  streaming   $FERRY_STREAM_ADDR"
  echo "  pod switch  udp/$RELAY_PORT"
  echo "  node ports  $(( 30000 + PROFILE_INDEX * 200 ))-$(( 30199 + PROFILE_INDEX * 200 ))"
  echo
  if [ "$PROFILE" = default ]; then
    echo "  This is the main checkout, so nothing is renamed or moved."
  else
    echo "  This is a worktree, so it has its own state, ports and pod network"
    echo "  and will not disturb a cluster running from another checkout."
  fi
  echo "  Set FERRY_PROFILE to override."
}

# Wait for a pid to go, polling finely.
#
# Every teardown loop here used `sleep 0.5`, so a process that exits in 15ms
# still cost half a second to notice, and seven of them made a teardown that
# was mostly rounding. 50ms keeps the same overall patience -- the timeout is
# still ten seconds -- and stops charging for it.
# Wait until a command succeeds, polling finely.
#
#   ferry_await [timeout_s] command...
#
# The startup half of ferry_await_gone. Every socket this script waits for
# during `ferry up` appears in tens of milliseconds and was polled for at
# half-second ticks, so five of them turned about 150ms of real waiting into
# roughly 2.6 seconds of startup. The timeout is optional and leads.
ferry_await() {
  local limit=15
  case "${1:-}" in ''|*[!0-9]*) ;; *) limit="$1"; shift ;; esac
  local i=0 ticks; ticks=$(( limit * 20 ))
  while [ "$i" -lt "$ticks" ]; do
    "$@" >/dev/null 2>&1 && return 0
    sleep 0.05
    i=$((i + 1))
  done
  return 1
}

# Wait until a command stops succeeding, polling finely. The sibling of
# ferry_await_exit for the teardown conditions that are not a pid -- a helper
# that reports whether something is running, or a status file that a server
# removes when its machine has gone.
#
#   ferry_await_gone [timeout_s] command...
#
# The timeout is optional and leads; anything else is the command.
ferry_await_gone() {
  local limit=10
  case "${1:-}" in ''|*[!0-9]*) ;; *) limit="$1"; shift ;; esac
  local i=0 ticks; ticks=$(( limit * 20 ))
  while [ "$i" -lt "$ticks" ]; do
    "$@" >/dev/null 2>&1 || return 0
    sleep 0.05
    i=$((i + 1))
  done
  return 1
}

ferry_await_exit() { # pid [timeout_s]
  local pid="$1" limit="${2:-10}" i=0 ticks
  ticks=$(( limit * 20 ))
  while [ "$i" -lt "$ticks" ]; do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.05
    i=$((i + 1))
  done
  return 1
}

cmd_down() {
  local purge=""
  case "${1:-}" in
    --purge) purge=1 ;;
    "") : ;;
    *) bad "usage: ferry down [--purge]"; return 2 ;;
  esac
  bold "stopping ferry"
  # Written before anything is stopped, so the login agent's watch loop cannot
  # see the processes go and exit non-zero before it knows this was deliberate.
  mark_stopped
  # ferry-proxy runs as root, so stopping it does too.
  if [ -f "$FERRY_RUN/ferry-proxy.pid" ]; then
    local proxy_pid; proxy_pid="$(cat "$FERRY_RUN/ferry-proxy.pid")"
    sudo kill -TERM "$proxy_pid" 2>/dev/null \
      && ok "Service proxy stopped"
    rm -f "$FERRY_RUN/ferry-proxy.pid"
    # Waited for rather than slept through, but briefly and then forced.
    #
    # This was `sleep 1`. Replacing it with an ordinary wait made teardown
    # four times *worse*: ferry-proxy does not exit on SIGTERM at all -- the
    # `sudo pkill` further down is what has always actually ended it -- so the
    # wait sat out its full timeout every time. The point of the pause is that
    # the listener has released its ports before the next `ferry up`, which a
    # kill achieves and patience does not.
    # A tenth of a second of courtesy, then the kill that was always going to
    # happen -- ferry-proxy has never once exited on SIGTERM, so this is a
    # gesture towards a version that might. It was a quarter second and that
    # was 42% of what a teardown had left.
    # No courtesy on --purge: nothing it could flush is being kept.
    [ -n "$purge" ] || for _ in 1 2; do
      kill -0 "$proxy_pid" 2>/dev/null || break; sleep 0.05
    done
    sudo kill -KILL "$proxy_pid" 2>/dev/null
  fi
  # Extra nodes first: each is a kubelet, a runtime and a streamer of its own.
  local index
  for index in $(seq 1 "$FERRY_MAX_NODE_SCAN"); do
    [ -f "$FERRY_RUN/node-$index.pid" ] || continue
    for suffix in -kubelet -streamer ""; do
      local pidfile="$FERRY_RUN/node-$index$suffix.pid"
      [ -f "$pidfile" ] || continue
      local pid; pid="$(cat "$pidfile")"; rm -f "$pidfile"
      kill -TERM "$pid" 2>/dev/null || continue
      ferry_await_exit "$pid" || kill -KILL "$pid" 2>/dev/null
    done
    rm -f "/tmp/ferry-cri$SUFFIX-$index.sock" "/tmp/ferry-exec$SUFFIX-$index.sock" \
          "/tmp/ferry-str$SUFFIX-$index.sock"
    ok "node $index stopped"
  done

  # Mode 2 first: a machine is a VM holding pods, and it should go down before
  # the control plane it reports to does.
  stop_machines

  # Signalled in order, then waited for together.
  #
  # The order the signals go out in matters -- the kubelet should hear about it
  # before the runtime it is talking to -- but the waits do not have to be
  # serial, and they were. Seven components at about 70ms each is half a
  # second of watching processes that had already been told to go, and it was
  # the largest thing left between ferry's teardown and kind's `docker rm -f`.
  #
  # ferry-cri must still finish releasing its vmnet network before another run
  # can claim the same subnet, so it is waited for -- just not on its own.
  local stopping=() stopnames=() component pidfile pid
  for component in kubelet ferry-cri ferry-streamer ferry-proxyd ferry-netpol ferry-storage ferry-gpud ferry-registry; do
    pidfile="$FERRY_RUN/$component.pid"
    [ -f "$pidfile" ] || continue
    pid="$(cat "$pidfile")"
    rm -f "$pidfile"
    kill -TERM "$pid" 2>/dev/null || continue
    stopping+=("$pid"); stopnames+=("$component")
  done
  # On --purge the control plane is killed outright and its data directory
  # removed, and nothing between here and there needs an API server. So it
  # goes down alongside the components rather than after them, which takes its
  # ~100ms off the total instead of adding it.
  local cp_job=""
  if [ -n "$purge" ]; then
    STATE="$FERRY_HOME" "$here/control-plane/down.sh" --purge >/dev/null 2>&1 &
    cp_job=$!
  fi

  local i=0
  while [ "$i" -lt "${#stopping[@]}" ]; do
    ferry_await_exit "${stopping[$i]}" || kill -KILL "${stopping[$i]}" 2>/dev/null
    ok "${stopnames[$i]} stopped"
    i=$((i + 1))
  done
  # A listener that outlives its pid file holds the node port against the next
  # run, and the symptom -- "address already in use" buried in a log -- is a poor
  # way to find that out. Matched on this profile's kubeconfig: every checkout runs
  # one, and a bare name here stopped every other profile's ferry-proxy too.
  pkill -f "bin/ferry-proxy --kubeconfig $FERRY_HOME/admin.conf" 2>/dev/null
  sudo pkill -f "bin/ferry-proxy --kubeconfig $FERRY_HOME/admin.conf" 2>/dev/null

  # After the streamer, which would otherwise put it straight back, and before
  # the control plane, which has to be up to accept the patch.
  #
  # Not on --purge: the node object goes with etcd a moment later, so the
  # patch is a write to something being deleted -- and the API server may
  # already be on its way down, above.
  [ -n "$purge" ] || withdraw_gpu

  # --purge reaches down.sh, which then stops the API server and etcd without
  # a graceful drain: their data directory is deleted a few milliseconds
  # later, so draining it is two to five seconds spent flushing state that is
  # about to be removed. See control-plane/down.sh.
  #
  # On --purge that was started above and has been running while the
  # components were reaped; here it is only collected.
  if [ -n "$cp_job" ]; then
    wait "$cp_job" 2>/dev/null
    ok "control plane stopped"
  else
    STATE="$FERRY_HOME" "$here/control-plane/down.sh" >/dev/null 2>&1 \
      && ok "control plane stopped"
  fi
  # --purge drops etcd's data, which is the cluster. The recorded version goes
  # with it: what is left is not a cluster at an older version, it is no
  # cluster, and the next 'ferry up' should start at whatever is built rather
  # than insisting on what used to be here.
  if [ -n "$purge" ]; then
    rm -f "$FERRY_HOME/version" "$FERRY_HOME/version.previous"
    # A Machine's disk is removed by ferry-machined's finalizer, which runs when
    # the object is deleted through the API. --purge does not delete objects, it
    # deletes etcd -- so every Machine vanishes without its finalizer ever
    # running, and the disk it owned is left behind with nothing that references
    # it and no command that removes it. They are ~550 MiB each and they
    # accumulate: a checkout used for a few dozen machines had 19 GiB of them.
    # Purging the cluster has to take them, because nothing else ever will.
    [ -n "${FERRY_HOME:-}" ] && [ "$FERRY_HOME" != "/" ] && [ "$FERRY_HOME" != "$HOME" ] \
      && rm -rf "${FERRY_HOME:?}/machined"
    ok "cluster data purged"
  fi
  # The peers file is deliberately not removed: it is what tells the next
  # 'ferry up' that this cluster has other nodes, before there is an API server
  # to ask. 'ferry node rm' and a fresh join rewrite it.
  rm -f "$FERRY_SOCK" "$FERRY_EXEC_SOCK" "$FERRY_STREAMER_SOCK" "$FERRY_PROXYD_SOCK" "$FERRY_NETPOL_SOCK"
}

# kube-proxy and CoreDNS for machines.
#
# Both are pinned to `ferry.dev/mode: shared` so they never land on the Mac
# node, where kube-proxy would be a pod VM programming a node kernel that does
# not exist and CoreDNS would be a second copy serving an audience that cannot
# reach it.
#
# Applied at 'machines enable' rather than at 'ferry up': they are only useful
# once there is somewhere for them to run, and until a machine exists they would
# sit Pending against a selector nothing matches.
install_machine_dns() {
  local rendered="$FERRY_RUN/machines-dns.yaml"
  mkdir -p "$FERRY_RUN"
  local advertise="$LAN_IP"
  [ "$advertise" = "127.0.0.1" ] && advertise="$(cat "$FERRY_RUN/cri/gateway" 2>/dev/null || echo 127.0.0.1)"

  # The `---` between them is load-bearing. A YAML file need not end with a
  # document separator, so concatenating two of them runs the last document of
  # the first into the first document of the second: the kube-proxy DaemonSet
  # and the CoreDNS ServiceAccount merge into one object that is neither, and
  # kube-proxy is silently never created. What that looks like from outside is
  # machines whose pods cannot resolve anything, with a manifest that applies
  # without error.
  { cat "$here/manifests/machines/kube-proxy.yaml"; echo "---"
    cat "$here/manifests/machines/coredns.yaml"; } \
    | sed -e "s|__CLUSTER_DOMAIN__|$CLUSTER_DOMAIN|g" \
          -e "s|__UPSTREAM_DNS__|$(host_resolvers)|g" \
          -e "s|__COREDNS_IMAGE__|$COREDNS_IMAGE|g" \
          -e "s|__KUBE_PROXY_IMAGE__|$MACHINE_KUBE_PROXY_IMAGE|g" \
          -e "s|__CLUSTER_CIDR__|$CLUSTER_CIDR|g" \
          -e "s|__DNS_SERVICE_IP__|$MACHINE_DNS_IP|g" \
          -e "s|__APISERVER_HOST__|$advertise|g" \
          -e "s|__APISERVER_PORT__|$(( 6443 + PORT_SHIFT ))|g" \
    > "$rendered"

  # The Service may already exist at a different address, and a ClusterIP is
  # immutable -- so an apply that would move it fails, rather than silently
  # leaving machines pointed at an address nothing serves.
  local existing
  existing="$(kube get service kube-dns -n kube-system -o jsonpath='{.spec.clusterIP}' 2>/dev/null || true)"
  if [ -n "$existing" ] && [ "$existing" != "$MACHINE_DNS_IP" ]; then
    bad "kube-dns already exists at $existing, not $MACHINE_DNS_IP"
    echo "    A Service's ClusterIP cannot be changed. Either set"
    echo "    FERRY_MACHINE_DNS_IP=$existing, or delete the Service and re-enable:"
    echo "        kubectl -n kube-system delete service kube-dns"
    return 1
  fi

  kube apply -f "$rendered" >/dev/null 2>&1 \
    || { bad "could not apply kube-proxy and CoreDNS for machines"; return 1; }
  ok "kube-proxy and cluster DNS for machines ($MACHINE_DNS_IP)"
  echo "      they stay Pending until a machine exists to run them on"
}

# --- mode 2 -----------------------------------------------------------------
cmd_machines_enable() {
  require_cluster || return 1
  bold "turning on machines (mode 2)"
  machines_ready || return 1

  if running ferry-machined; then
    warn "machines are already running"
  else
    start_machines || return 1
  fi
  : > "$MACHINES_MARKER"
  echo
  bold "machines are on"
  echo "  They come back with the cluster; 'ferry machines disable' turns them off."
  echo
  # No node.labels in this example. That is MACHINES.md's design rather than
  # what was built: the CRD has no node field, so a structural schema prunes it
  # without a word and the labels would quietly do nothing. ferry-machined
  # applies ferry.dev/mode=shared itself once the node registers.
  echo "  Declare one:"
  echo "    kubectl apply -f - <<'EOF'"
  echo "    apiVersion: ferry.dev/v1alpha1"
  echo "    kind: Machine"
  echo "    metadata: {name: worker-0}"
  echo "    spec: {cpus: 2, memory: 2Gi}"
  echo "    EOF"
  echo
  echo "    kubectl get machines"
  echo "    kubectl get nodes -L ferry.dev/mode"
  echo
  echo "  Pods choose with nodeSelector: {ferry.dev/mode: shared}"
}

cmd_machines_disable() {
  bold "turning off machines"
  # The marker first, so a crash between here and the kills does not leave a
  # cluster that restarts machines its operator just turned off.
  rm -f "$MACHINES_MARKER"
  stop_machines
  echo
  echo "  Machine objects and the CRD are left alone; deleting a Machine is how"
  echo "  its node and disk go away. The node image and $NODE_DISK are kept."
}

stop_machines() {
  local component pidfile pid

  # Ask the machines to stop before killing the server that hosts them.
  #
  # Their VMs do go when ferry-node exits -- a machine goes NotReady within
  # seconds of it -- so this is not about leaked VMs. It is about how they go: a
  # guest whose host process is killed loses whatever it had not flushed, and a
  # node VM runs containerd with a real filesystem underneath it. ferry already
  # takes this care with ferry-cri, waiting for it rather than killing it.
  #
  # A spec file in the machines directory is the request for a machine and
  # removing it is the request to stop one, so this asks through the channel
  # ferry-machined already uses rather than hunting for VM processes. The
  # Machine objects stay in etcd, so the next start brings them back.
  #
  # It also makes the next start quicker, which it did not used to. ferry-node
  # releases the machine network on the way out now, so an immediate restart
  # takes the same subnet straight back -- measured at five seconds, against a
  # minute or more of status 1001 before. See experiment 22 for why asking
  # again was the worst possible response to that.
  if running ferry-node && [ -d "$FERRY_RUN/machines" ]; then
    # ferry-machined first, or it writes the spec files straight back.
    # The provisioner first of all: it exists to replace machines that go
    # away, so stopping the machines while it watches is asking it to make
    # them again.
    if running ferry-karpenter; then
      kill -TERM "$(cat "$FERRY_RUN/ferry-karpenter.pid")" 2>/dev/null
      ferry_await_gone running ferry-karpenter
      rm -f "$FERRY_RUN/ferry-karpenter.pid"
    fi
    if running ferry-machined; then
      kill -TERM "$(cat "$FERRY_RUN/ferry-machined.pid")" 2>/dev/null
      ferry_await_gone running ferry-machined
    fi
    if ls "$FERRY_RUN/machines"/*.json >/dev/null 2>&1; then
      rm -f "$FERRY_RUN/machines"/*.json
      # Long enough for a guest to shut down and vmnet to be given back; a
      # machine that has not gone by then is stopped with its server anyway.
      ferry_await_gone 30 ls "$FERRY_RUN/machines"/*.status.json
      ok "machines stopped"
    fi
  fi

  for component in ferry-karpenter ferry-machined ferry-node; do
    pidfile="$FERRY_RUN/$component.pid"
    [ -f "$pidfile" ] || continue
    pid="$(cat "$pidfile")"; rm -f "$pidfile"
    kill -TERM "$pid" 2>/dev/null || continue
    # ferry-node has to release its vmnet network before another run can claim
    # the same subnet, exactly as ferry-cri does.
    ferry_await_exit "$pid" || kill -KILL "$pid" 2>/dev/null
    ok "$component stopped"
  done
}

cmd_machines_status() {
  bold "machines (mode 2)"
  if machines_enabled; then ok "enabled for this cluster"
  else bad "not enabled -- ferry machines enable"; fi
  for component in ferry-machined ferry-node; do
    if running "$component"; then ok "$component (pid $(cat "$FERRY_RUN/$component.pid"))"
    else bad "$component"; fi
  done
  # Telling someone on a release to run 'ferry node-image' is telling them to
  # run a command that refuses on a release. What to do differs by where you
  # are, so the answer does too.
  if [ -d "$NODE_IMAGE_LAYOUT" ]; then
    ok "node image $NODE_IMAGE_LAYOUT"
  elif is_release; then
    bad "no node image -- this release was packaged without one"
    echo "      mode 2 needs a release built with it; mode 1 is unaffected"
  else
    bad "no node image -- ferry node-image   (slow, needs docker)"
  fi
  [ -f "$NODE_DISK" ] && ok "node disk $NODE_DISK ($(du -h "$NODE_DISK" | awk '{print $1}') used)" \
    || echo "  node disk not unpacked yet; the first 'machines enable' does it"
  echo "  network   $MACHINE_SUBNET"
  if running ferry-registry; then
    ok "registry, $(machine_registry_count) images -- ferry logs ferry-registry"
  elif machine_registry_enabled; then
    bad "ferry-registry is not running; loaded images stay on the node they were loaded on"
  else
    echo "  registry  off (FERRY_MACHINE_REGISTRY=0) -- machines see only what registries serve"
  fi
  if have_cluster; then
    echo
    kube get machines 2>/dev/null || echo "  no Machine CRD installed yet"
  fi
}

cmd_machines() {
  case "${1:-status}" in
    enable|on)   shift; cmd_machines_enable ;;
    disable|off) shift; cmd_machines_disable ;;
    status)      shift; cmd_machines_status ;;
    ls|list)     shift; kube get machines ;;
    *) bad "usage: ferry machines [enable|disable|status|ls]"; return 2 ;;
  esac
}

# --- starting at login ----------------------------------------------------
#
# k3s installs a systemd unit and the cluster is simply there after a reboot.
# The macOS equivalent is a LaunchAgent, and it has to be an *Agent* rather than
# a Daemon for reasons that are not cosmetic:
#
#   - Virtualization.framework will not create a VM from a process outside a
#     user session, so a LaunchDaemon running before login cannot start a pod.
#   - macOS grants local network access per session. ferry already knows what
#     that costs: 'ferry join' refuses to run over SSH because a node started
#     from a session that ends loses the network a few seconds later. A
#     LaunchAgent lives in the login session, which is a session that stays.
#
# So the cluster comes up at login rather than at boot. On a Mac that is logged
# in and stays logged in -- which is what a Mac running a cluster is -- the
# difference is invisible. On one that reboots to the login window, the cluster
# waits there, and that is the honest behaviour rather than a daemon that starts
# and cannot make a VM.
#
# The agent is per profile, so a worktree's cluster and the main one do not
# fight over one plist.
service_label()  { echo "dev.ferry.${PROFILE}"; }
service_plist()  { echo "$HOME/Library/LaunchAgents/$(service_label).plist"; }

cmd_service_install() {
  local quiet=""
  [ "${1:-}" = --quiet ] && quiet=1
  local plist; plist="$(service_plist)"
  mkdir -p "$(dirname "$plist")"

  # launchd gives an agent almost no environment, and ferry shells out to
  # kubectl, openssl and curl. kubectl is the one that matters: cmd_up waits on
  # the node going Ready with it, and installs CoreDNS with it. Without it on
  # PATH the login-started cluster times out waiting for a node that is actually
  # fine, and comes up with no DNS -- reported as a failure nowhere near its
  # cause.
  #
  # So the directory kubectl is actually in is recorded, not guessed. The
  # installer puts it beside the launcher, and falls back to ~/.local/bin
  # whenever /usr/local/bin is not writable, which is stock macOS.
  local launcher="$here/ferry" path kubectl_dir=""
  kubectl_dir="$(command -v kubectl 2>/dev/null)"
  [ -n "$kubectl_dir" ] && kubectl_dir="$(cd "$(dirname "$kubectl_dir")" && pwd)"
  path="$(dirname "$launcher")"
  [ -n "$kubectl_dir" ] && path="$path:$kubectl_dir"
  [ -n "${FERRY_BIN_DIR:-}" ] && path="$path:$FERRY_BIN_DIR"
  path="$path:$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

  if [ -z "$kubectl_dir" ]; then
    warn "kubectl is not on your PATH; the login-started cluster will not find one either"
  fi

  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(service_label)</string>
  <key>ProgramArguments</key>
  <array>
    <string>$launcher</string>
    <string>service</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$path</string>
    <key>FERRY_PROFILE</key><string>$PROFILE</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- Restart a cluster that died, but not one that was stopped on purpose.
       launchd cannot tell those apart -- both end with the processes gone --
       so 'ferry service run' decides, and exits 0 when 'ferry down' left its
       marker behind. An agent that came back from 'ferry down' could never be
       turned off. -->
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>$FERRY_HOME/logs/service.log</string>
  <key>StandardErrorPath</key><string>$FERRY_HOME/logs/service.log</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
PLIST
  mkdir -p "$FERRY_HOME/logs"
  [ -n "$quiet" ] || ok "wrote $plist"

  # bootstrap loads the job, and RunAtLoad starts it -- so this does start a
  # cluster, and pretending otherwise is how the installer ended up racing
  # itself. 'ferry service run' is written to cope: it holds a cluster that is
  # already up rather than failing on it, so registering the agent before,
  # during or after 'ferry up' all converge on one running cluster.
  launchctl bootout "gui/$(id -u)/$(service_label)" 2>/dev/null
  if launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null; then
    [ -n "$quiet" ] || ok "registered; the cluster starts now and at every login"
  else
    # bootstrap fails if the agent is already loaded, which is not an error
    # worth reporting to someone reinstalling.
    launchctl enable "gui/$(id -u)/$(service_label)" 2>/dev/null
    [ -n "$quiet" ] || warn "could not register the agent with launchd; 'ferry up' still works"
  fi
}

cmd_service_uninstall() {
  local plist; plist="$(service_plist)"
  launchctl bootout "gui/$(id -u)/$(service_label)" 2>/dev/null
  if [ -f "$plist" ]; then rm -f "$plist"; ok "removed $plist"
  else ok "no login agent was registered"; fi
}

cmd_service_status() {
  local plist; plist="$(service_plist)"
  bold "ferry service ($(service_label))"
  if [ ! -f "$plist" ]; then
    bad "not registered -- ferry will not start at login"
    echo "      register it: ferry service install"
    return 1
  fi
  ok "$plist"
  if launchctl print "gui/$(id -u)/$(service_label)" >/dev/null 2>&1; then
    ok "loaded by launchd"
  else
    bad "not loaded -- ferry service install"
  fi
  echo "  log  $FERRY_HOME/logs/service.log"
}

# What launchd runs. Starts the cluster and stays in the foreground holding it,
# because launchd tracks a job by its process: a script that starts the cluster
# in the background and exits looks to launchd like a job that finished, and
# with KeepAlive it would be started again immediately, forever.
cmd_service_run() {
  # Nothing to do if no cluster was ever made here, or one was torn down with
  # --purge.
  if [ ! -f "$FERRY_HOME/pki/ca.crt" ] && [ ! -f "$FERRY_RUN/kubelet.conf" ]; then
    echo "no cluster has been created on this Mac yet; nothing to start"
    exit 0
  fi

  # A Mac that joined someone else's cluster cannot be restarted from here.
  #
  # Its kubelet's certificate, its kubeconfig and its bootstrap config all live
  # under FERRY_RUN, which is /tmp -- deliberately, because macOS caps a unix
  # socket path near 104 bytes and the kubelet builds its podresources socket
  # beneath --root-dir. /tmp does not survive a reboot, so by the time this runs
  # at the next login the node's credentials are gone and the only way back is
  # to bootstrap again with a fresh token.
  #
  # Calling cmd_up here would be much worse than doing nothing: it would start a
  # *control plane* on a machine that is supposed to be a worker, with its own
  # etcd and its own idea of the cluster.
  if [ "$(cat "$FERRY_HOME/role" 2>/dev/null)" = worker ] && [ ! -f "$FERRY_RUN/kubelet.conf" ]; then
    echo "this Mac joined a cluster on another, and a worker's credentials live"
    echo "in $FERRY_RUN, which does not survive a reboot."
    echo "Rejoin from a Terminal window on this Mac:"
    echo "    ferry join --server <host:6443> --token <token from 'ferry token create'>"
    exit 0
  fi

  # launchd sends SIGTERM when the session ends or the job is booted out. Taking
  # the cluster down properly matters more here than anywhere else: ferry-cri
  # has to release its vmnet network, and a subnet left claimed by a killed
  # runtime stays claimed for about a minute -- so an unclean stop moves the pod
  # network on the next start.
  # Whether this agent started the cluster or merely found one.
  #
  # It decides what SIGTERM means. An agent that started the cluster owns it and
  # should take it down; an agent that adopted a running one must leave it
  # exactly as it found it -- otherwise `ferry service uninstall`, which boots
  # the job out and so delivers SIGTERM, stops a cluster the operator started by
  # hand and never asked the agent to manage. That is what it did: registering
  # the agent on a running cluster and then deregistering it tore the cluster
  # down, with `ferry status` showing everything stopped seconds after a command
  # whose whole job was to remove a plist.
  adopted=""

  on_term() {
    if [ -n "$adopted" ]; then
      echo "leaving the cluster up; this agent adopted it rather than starting it"
      exit 0
    fi
    echo "stopping"
    cmd_down
    exit 0
  }
  trap on_term TERM INT

  # A cluster that is already up is held, not started again. Without this,
  # registering the agent on a running cluster -- which is what re-running the
  # installer does -- makes cmd_up refuse with "already up", which is a non-zero
  # exit, which is the KeepAlive condition: launchd would restart this every few
  # seconds forever against a perfectly healthy cluster.
  if running ferry-cri && running kubelet; then
    adopted=1
    echo "cluster is already up; holding it"
  else
    cmd_up || exit 1
  fi

  # Hold the job open, and notice if the cluster falls over underneath it. An
  # exit here is a non-zero exit, which is the KeepAlive condition, so launchd
  # brings it back.
  #
  # The sleep is short because bash runs a trap only after the foreground child
  # returns: whatever this waits on is added to how long the SIGTERM handler
  # takes to start, and launchd follows SIGTERM with SIGKILL after 20 seconds.
  # Being killed there means ferry-cri never releases its vmnet network, and a
  # subnet left claimed stays claimed for about a minute -- so the pod network
  # moves on the next start. Five seconds leaves ample room for the teardown.
  while running ferry-cri && running kubelet; do sleep 5; done

  # Which kind of stop this was decides whether launchd brings it back. 'ferry
  # down' is the whole reason this distinction exists: without it, stopping the
  # cluster by hand is undone five seconds later and ferry cannot be turned off.
  if was_stopped; then
    echo "cluster was stopped with 'ferry down'; not restarting it"
    exit 0
  fi
  # What is left has to go before launchd starts us again. Usually only one of
  # the two died -- ferry-cri, most often, with the kubelet and the control
  # plane still running -- and cmd_up refuses to start over a half-running
  # cluster, so the restart failed with "already up", launchd retried it, and
  # the node stayed NotReady for good. ferry-cri cannot be restarted on its own:
  # its pod VMs and its vmnet network went with it, so the gateway the control
  # plane advertises may not be the one it gets back.
  echo "ferry-cri or the kubelet stopped on their own; restarting the cluster"
  cmd_down
  clear_stopped
  exit 1
}

cmd_service() {
  case "${1:-status}" in
    install)   shift; cmd_service_install "$@" ;;
    uninstall) shift; cmd_service_uninstall ;;
    status)    shift; cmd_service_status ;;
    run)       shift; cmd_service_run ;;
    *) bad "usage: ferry service [install|uninstall|status]"; return 2 ;;
  esac
}

# --- removing ferry --------------------------------------------------------
#
# The counterpart to install.sh, and the reason it is a command rather than a
# script the installer drops somewhere: ferry knows where its state is, and that
# is per profile.
cmd_uninstall() {
  local purge="" yes=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge) purge=1; shift ;;
      --yes|-y) yes=1; shift ;;
      *) bad "usage: ferry uninstall [--purge] [--yes]"; return 2 ;;
    esac
  done

  # Before anything, including the prompt. This guard was written below, next to
  # the `rm -rf "$FERRY_HOME"` it protects, which made it useless: `cmd_down
  # --purge` runs first and is itself destructive -- it deletes $FERRY_HOME/etcd
  # through control-plane/down.sh, plus $FERRY_HOME/version and version.previous.
  # With FERRY_HOME=$HOME those three are gone by the time the guard downstairs
  # says it is refusing. A guard on the last destructive step is not a guard.
  if [ -n "$purge" ]; then
    [ -n "${FERRY_HOME:-}" ] && [ "$FERRY_HOME" != "/" ] && [ "$FERRY_HOME" != "$HOME" ] \
      || { bad "refusing to purge FERRY_HOME='${FERRY_HOME:-}'"; return 1; }
  fi

  bold "uninstalling ferry ($PROFILE)"
  echo "  stops the cluster, removes the login agent, and unlinks the CLI"
  if [ -n "$purge" ]; then
    echo "  --purge also deletes $FERRY_HOME -- etcd, the cluster's certificates,"
    echo "  and every object in it. There is no undo and no backup taken."
  else
    echo "  $FERRY_HOME is kept, so reinstalling brings the same cluster back."
  fi
  echo
  if [ -z "$yes" ]; then
    printf '  type the word yes to continue: '
    local answer; read -r answer
    [ "$answer" = yes ] || { echo "  nothing was changed"; return 1; }
  fi
  echo

  # The agent goes first. launchd restarts a cluster whose processes vanish, so
  # tearing one down while its agent is still loaded is a race against a
  # relaunch -- and the relaunch wins, because cmd_down's waits give it time.
  cmd_service_uninstall
  cmd_down ${purge:+--purge} || true

  # The launcher, but only when it is a link to the ferry that is running right
  # now. A prefix match on the install directory would be close enough and is
  # not the same thing: someone else's ferry on the PATH is not ours to delete,
  # and this is the one step here that removes a file outside ferry's own
  # directories. Resolving and comparing is exact.
  local dir link
  for dir in /usr/local/bin "$HOME/.local/bin" "${FERRY_BIN_DIR:-}"; do
    [ -n "$dir" ] && [ -L "$dir/ferry" ] || continue
    link="$(readlink "$dir/ferry")"
    case "$link" in
      /*) : ;;
      *) link="$(cd "$dir" && pwd)/$link" ;;
    esac
    if [ "$(cd "$(dirname "$link")" 2>/dev/null && pwd)" = "$here" ]; then
      rm -f "$dir/ferry"
      ok "unlinked $dir/ferry"
    fi
  done

  if [ -n "$purge" ]; then
    rm -rf "$FERRY_HOME"
    ok "removed $FERRY_HOME"
  else
    echo "  kept $FERRY_HOME"
  fi

  # The release itself goes last, and is left for the person to remove: this
  # script is executing out of that directory, and deleting it from underneath
  # a running bash produces failures that are very hard to read.
  #
  # Where it is comes from $here rather than from FERRY_INSTALL_DIR. That
  # variable is an input to install.sh, set once at install time and gone by the
  # time anybody runs uninstall, so reading it here names the default and misses
  # every install that used something else. ferry is standing in the directory;
  # it does not need to guess. $here is .../ferry-dist/current, so the
  # installation is its parent.
  if is_release; then
    local dist; dist="$(cd "$here/.." 2>/dev/null && pwd)"
    echo
    if [ -n "$dist" ] && [ -d "$dist/versions" ]; then
      echo "  The releases themselves are still at $dist. To remove them:"
      echo "      rm -rf $dist"
    else
      echo "  This release is still at $here. To remove it:"
      echo "      rm -rf $here"
    fi
  fi
  echo
  bold "done"
}

# Where the admin credentials are, and optionally putting them where kubectl
# looks by default.
#
# 'export KUBECONFIG=...' is a line every Kubernetes distribution makes people
# paste, and the one people forget when they open a second terminal. Merging is
# the offer, not the default: ~/.kube/config is usually pointed at clusters that
# matter, and an installer that rewrites it uninvited is an installer that
# eventually breaks someone's day.
cmd_kubeconfig() {
  local conf="$FERRY_HOME/admin.conf"
  case "${1:-}" in
    "") echo "$conf"; return 0 ;;
    --merge) : ;;
    *) bad "usage: ferry kubeconfig [--merge]"; return 2 ;;
  esac

  [ -f "$conf" ] || { bad "no cluster on this Mac yet -- run: ferry up"; return 1; }
  command -v kubectl >/dev/null || { bad "kubectl is not installed"; return 1; }

  local context="ferry${SUFFIX}"
  local target="${KUBECONFIG:-$HOME/.kube/config}"
  # KUBECONFIG can be a list; the first entry is where kubectl writes, so that
  # is the file being merged into and the one to back up.
  target="${target%%:*}"

  # 'ferry up' prints `export KUBECONFIG=<admin.conf>` and, on the next line,
  # offers this command. Anyone who followed both in one shell arrives here with
  # target and source being the same file -- and the merge then backs admin.conf
  # up, flattens it over itself, renames its context and reports success, while
  # ~/.kube/config is never touched. It looks exactly like it worked.
  if [ "$target" = "$conf" ]; then
    target="$HOME/.kube/config"
    echo "  KUBECONFIG points at ferry's own admin.conf; merging into $target"
  fi
  mkdir -p "$(dirname "$target")"

  if [ -f "$target" ]; then
    local backup; backup="$target.before-ferry.$(date -u +%Y%m%dT%H%M%SZ)"
    cp "$target" "$backup"
    ok "backed up $target to $(basename "$backup")"
  fi

  # Every profile's admin.conf calls its cluster "ferry" and its user "admin",
  # and a flattened merge keeps the first entry of each name it meets. Renaming
  # only the context, after the merge, left the second profile's context aimed
  # at the first profile's API server. So the cluster, user and context are all
  # given the profile's name in a copy, before anything is merged.
  local renamed tmp; renamed="$(mktemp)"; tmp="$(mktemp)"
  field() { KUBECONFIG="$conf" kubectl config view --minify --flatten -o jsonpath="{$1}"; }
  local server ca cert key
  server="$(field .clusters[0].cluster.server)"
  ca="$(field '.clusters[0].cluster.certificate-authority-data')"
  cert="$(field '.users[0].user.client-certificate-data')"
  key="$(field '.users[0].user.client-key-data')"
  unset -f field
  if [ -z "$server" ] || [ -z "$ca" ] || [ -z "$cert" ] || [ -z "$key" ]; then
    rm -f "$renamed" "$tmp"
    bad "could not read the cluster's credentials from $conf"; return 1
  fi
  # `config set` base64-decodes what it is given for a *-data field, and these
  # come out of --flatten already encoded. No current-context is written:
  # merging should not move anyone off the context they are on -- someone
  # pointed at production who adds ferry's context is still pointed at it.
  {
    KUBECONFIG="$renamed" kubectl config set-cluster "$context" --server="$server" &&
    KUBECONFIG="$renamed" kubectl config set "clusters.$context.certificate-authority-data" "$ca" &&
    KUBECONFIG="$renamed" kubectl config set "users.$context.client-certificate-data" "$cert" &&
    KUBECONFIG="$renamed" kubectl config set "users.$context.client-key-data" "$key" &&
    KUBECONFIG="$renamed" kubectl config set-context "$context" --cluster="$context" --user="$context"
  } >/dev/null 2>&1 || { rm -f "$renamed" "$tmp"; bad "could not prepare the merge"; return 1; }

  # ferry's copy is listed first so that, for a cluster recreated since the last
  # merge, its new certificates win over the stale ones already in $target.
  # Written to a temporary file first: KUBECONFIG=a:b `kubectl config view
  # --flatten` reads both and a redirect into one of them truncates it before it
  # is read.
  if KUBECONFIG="$renamed:$target" kubectl config view --flatten > "$tmp" 2>/dev/null \
     && [ -s "$tmp" ]; then
    mv "$tmp" "$target"
    chmod 600 "$target"
    rm -f "$renamed"
  else
    rm -f "$tmp" "$renamed"
    bad "could not merge into $target"; return 1
  fi

  ok "merged into $target as context '$context'"
  echo "  kubectl config use-context $context"
}

cmd_version() {
  local release
  if release="$(ferry_release_version)"; then
    echo "ferry $release"
  else
    echo "ferry (checkout $(git -C "$here" rev-parse --short HEAD 2>/dev/null || echo unknown))"
  fi

  # Two different facts: what this copy of ferry carries, and what this Mac's
  # cluster was last started at. They differ after every upgrade until the
  # cluster is restarted, and the cluster's record outlives the cluster -- so
  # reading the cluster's version into the first lines reported, after an
  # install, a Kubernetes the installed release does not contain. The copy's
  # own versions come from what bin/ points at or, before anything is built,
  # what the release was packaged with.
  local k8s; k8s="$(ferry_active_version)"
  [ -z "$k8s" ] && [ -f "$here/VERSION" ] && k8s="$(sed -n 's/^kubernetes=//p' "$here/VERSION" | head -1)"
  version_of() { # field
    [ -n "$k8s" ] && ferry_manifest_field "$k8s" "$1" 2>/dev/null && return 0
    [ -f "$here/VERSION" ] && sed -n "s/^$1=//p" "$here/VERSION" | head -1 | grep . && return 0
    [ -n "$k8s" ] && [ "$1" = control-plane ] && { ferry_control_plane_version "$k8s"; return 0; }
    [ -n "$k8s" ] && [ "$1" = etcd ] && { ferry_etcd_version "$k8s"; return 0; }
    echo unknown
  }
  echo "  kubernetes    ${k8s:-not built}"
  echo "  control plane $(version_of control-plane)"
  echo "  etcd          $(version_of etcd)"
  unset -f version_of
  echo "  profile       $PROFILE"
  echo "  root          $here"
  local cluster; cluster="$(ferry_cluster_field kubernetes 2>/dev/null)"
  if running kubelet; then
    echo "  cluster       up${cluster:+, kubernetes $cluster}"
  elif [ -n "$cluster" ]; then
    echo "  cluster       not running (last started at kubernetes $cluster)"
  else
    echo "  cluster       not running"
  fi
}

# ferry-cri cannot be restarted on its own -- see cmd_service_run -- so this is
# the whole cluster, down and up. The data stays; the pods are recreated.
cmd_restart() {
  [ $# -eq 0 ] || { bad "usage: ferry restart"; return 2; }
  cmd_down || return 1
  cmd_up
}

cmd_status() {
  bold "ferry status"
  local cluster active
  cluster="$(ferry_cluster_field kubernetes 2>/dev/null || echo "")"
  active="$(ferry_active_version)"
  if [ -n "$cluster" ] && [ -n "$active" ] && [ "$cluster" != "$active" ]; then
    warn "kubernetes $cluster (this checkout is built at $active)"
  else
    echo "  kubernetes ${cluster:-${active:-not built}}"
  fi
  if durability_is_relaxed; then
    echo "  durability relaxed -- writes acknowledged before they reach the disk"
  else
    echo "  durability full -- every etcd commit reaches the disk first"
  fi
  for component in ferry-cri ferry-streamer ferry-proxyd ferry-netpol ferry-storage ferry-gpud kubelet ferry-proxy; do
    if running "$component"; then ok "$component (pid $(cat "$FERRY_RUN/$component.pid"))"
    else bad "$component"; fi
  done
  for component in etcd kube-apiserver kube-controller-manager kube-scheduler; do
    if [ -f "$FERRY_HOME/$component.pid" ] && kill -0 "$(cat "$FERRY_HOME/$component.pid")" 2>/dev/null
    then ok "$component"; else bad "$component"; fi
  done
  if machines_enabled; then
    for component in ferry-node ferry-machined ferry-karpenter; do
      if running "$component"; then ok "$component (pid $(cat "$FERRY_RUN/$component.pid"))"
      else bad "$component (machines are enabled)"; fi
    done
  fi
  if machine_registry_enabled; then
    if running ferry-registry; then ok "ferry-registry (pid $(cat "$FERRY_RUN/ferry-registry.pid"))"
    else bad "ferry-registry (loaded images stay on the node they were loaded on)"; fi
  fi
  # A dead runtime under a live kubelet is a node that reads NotReady and will
  # stay that way: the runtime took its pod VMs and its vmnet network with it,
  # and nothing brings it back but a restart of the whole cluster.
  if ! running ferry-cri && running kubelet && ! was_stopped; then
    warn "ferry-cri has stopped and the node cannot run pods"
    echo "      Why:  tail -40 $FERRY_RUN/logs/ferry-cri.log"
    echo "      Fix:  ferry restart"
  fi
  # count_vms sees every Virtualization.framework VM on the Mac -- Docker
  # Desktop's, a simulator's, another profile's pods -- and none of them is
  # attributable to a profile from the process table. The API server knows
  # which pods are this node's, so it is asked; the Mac-wide figure is labelled
  # for what it is.
  if [ -f "$FERRY_HOME/admin.conf" ] && running kubelet; then
    local pods
    pods="$(KUBECONFIG="$FERRY_HOME/admin.conf" kubectl get pods -A --no-headers \
      --field-selector "spec.nodeName=$NODE_NAME,status.phase=Running" 2>/dev/null | wc -l | tr -d ' ')"
    echo "  $pods pods running on $NODE_NAME"
  fi
  echo "  $(count_vms) virtual machines on this Mac, from any app"
  if [ -f "$FERRY_HOME/admin.conf" ] && running kubelet; then
    echo
    KUBECONFIG="$FERRY_HOME/admin.conf" kubectl get nodes 2>/dev/null
  fi
}

cmd_logs() {
  local which="${1:-}"
  case "$which" in
    ferry-cri|kubelet|control-plane|ferry-proxy|ferry-proxyd|ferry-streamer|ferry-netpol|ferry-storage|ferry-gpud|ferry-machined|ferry-node|ferry-karpenter|ferry-registry) tail -f "$FERRY_RUN/logs/$which.log" ;;
    apiserver|kube-apiserver)        tail -f "$FERRY_HOME/logs/kube-apiserver.log" ;;
    etcd)                            tail -f "$FERRY_HOME/logs/etcd.log" ;;
    *) echo "usage: ferry logs <ferry-cri|kubelet|control-plane|apiserver|etcd|ferry-machined|ferry-node|ferry-karpenter|ferry-registry>"; return 1 ;;
  esac
}

case "${1:-}" in
  doctor)     shift; cmd_doctor "$@" ;;
  kernel)     shift
              # A release ships the built kernel and not the script that makes
              # it, so without this the command fails with a bare "No such file
              # or directory" -- while usage() still advertises it.
              if is_release; then
                bad "this is an installed ferry $(ferry_release_version); it already carries the guest kernel"
                echo "    Building one needs a checkout and Docker:"
                echo "        git clone https://github.com/imaustink/ferry && cd ferry && ./ferry kernel"
                exit 1
              fi
              "$here/kernel/build-kernel.sh" "$@" ;;
  build)      shift; cmd_build "$@" ;;
  up)         shift; cmd_up "$@" ;;
  profile)    shift; cmd_profile ;;
  addons)     shift; cmd_addons "$@" ;;
  image)      shift
              case "${1:-}" in
                build) shift; cmd_image_build "$@" ;;
                load) shift; cmd_image_load "$@" ;;
                ls|"") KUBECONFIG="$FERRY_HOME/admin.conf" kubectl get pods -A -o jsonpath='{range .items[*]}{.spec.containers[*].image}{"\n"}{end}' 2>/dev/null | sort -u ;;
                *) bad "usage: ferry image [build|load <name|archive|dir>|ls]"; exit 2 ;;
              esac ;;
  token)      shift; case "${1:-}" in create|"") cmd_token_create ;; *) bad "usage: ferry token create"; exit 2 ;; esac ;;
  join)       shift; cmd_join "$@" ;;
  node)       shift
              case "${1:-}" in
                add) shift; cmd_node_add "$@" ;;
                rm)  shift; cmd_node_rm "$@" ;;
                ls|"") KUBECONFIG="$FERRY_HOME/admin.conf" kubectl get nodes ;;
                *)   bad "usage: ferry node [add <name>|rm <name>|ls]"; exit 2 ;;
              esac ;;
  upgrade)    shift; cmd_upgrade "$@" ;;
  machines)   shift; cmd_machines "$@" ;;
  node-image) shift; cmd_node_image "$@" ;;
  service)    shift; cmd_service "$@" ;;
  uninstall)  shift; cmd_uninstall "$@" ;;
  down)       shift; cmd_down "$@" ;;
  restart)    shift; cmd_restart "$@" ;;
  status)     shift; cmd_status "$@" ;;
  logs)       shift; cmd_logs "$@" ;;
  kubeconfig) shift; cmd_kubeconfig "$@" ;;
  version|--version) shift; cmd_version ;;
  -h|--help|help|"") usage ;;
  *) echo "unknown command: $1"; echo; usage; exit 1 ;;
esac
