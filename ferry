#!/usr/bin/env bash
# ferry -- Kubernetes on a Mac, one virtual machine per pod.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# A kubelet holds thousands of descriptors -- watches, TLS connections, one log
# file per container. A login shell on macOS allows about a million, but an SSH
# session allows 256, and 'ferry join' is usually run over SSH. Inheriting that
# gives a node that works for a few minutes and then fails to reach the API, with
# an error that says nothing about descriptors.
ulimit -n 65536 2>/dev/null || ulimit -n unlimited 2>/dev/null || true

# Which cluster this is.
#
# ferry keeps its state at fixed paths and binds fixed ports, which is right
# until a second copy of ferry runs on the same Mac -- and with git worktrees
# that happens without anyone deciding to. Two clusters then share one etcd, one
# set of certificates, one set of sockets, and both try to reserve the same vmnet
# subnet. What it looks like from outside is a cluster that was working and
# quietly stopped.
#
# So everything that cannot be shared is named after the checkout it belongs to.
# The main checkout is "default" and keeps exactly the paths and ports it always
# had; a linked worktree gets its own. The key is the directory rather than the
# branch: a branch changes under a running cluster the moment someone checks
# something else out, two worktrees can sit on the same branch, and a detached
# HEAD has no branch at all.
ferry_profile() {
  [ -n "${FERRY_PROFILE:-}" ] && { echo "$FERRY_PROFILE"; return; }
  local common top
  common="$(git -C "$here" rev-parse --git-common-dir 2>/dev/null)"
  top="$(git -C "$here" rev-parse --git-dir 2>/dev/null)"
  # In the main checkout these are the same directory; in a worktree they differ.
  if [ -n "$common" ] && [ "$common" = "$top" ]; then echo default; return; fi
  basename "$here" | tr -c 'a-zA-Z0-9_-' '-' | sed 's/-*$//' | cut -c1-24
}
PROFILE="$(ferry_profile)"

# A number for the profile, so ports and subnets can be moved out of each other's
# way. It is allocated and written down rather than hashed: a hash cannot promise
# two profiles differ, and with a handful of worktrees a collision is likely
# rather than exotic -- the first attempt here put two of three worktrees on the
# same number, which is the bug this whole change exists to prevent.
#
# The register is a file of "<index> <profile>" lines. Claiming is done under a
# directory lock, because concurrent checkouts is the case being designed for and
# two of them starting at once must not claim the same number.
FERRY_PROFILES="${FERRY_PROFILES:-$HOME/.ferry-profiles}"

ferry_profile_index() {
  [ "$PROFILE" = default ] && { echo 0; return; }

  local existing
  existing="$(awk -v p="$PROFILE" '$2 == p {print $1; exit}' "$FERRY_PROFILES" 2>/dev/null)"
  [ -n "$existing" ] && { echo "$existing"; return; }

  local lock="$FERRY_PROFILES.lock" waited=0
  while ! mkdir "$lock" 2>/dev/null; do
    waited=$((waited + 1))
    [ "$waited" -gt 50 ] && { rmdir "$lock" 2>/dev/null; break; }
    sleep 0.1
  done

  # Re-read inside the lock: another checkout may have claimed it while waiting.
  existing="$(awk -v p="$PROFILE" '$2 == p {print $1; exit}' "$FERRY_PROFILES" 2>/dev/null)"
  if [ -z "$existing" ]; then
    local n=1
    while awk -v i="$n" '$1 == i {found=1} END {exit !found}' "$FERRY_PROFILES" 2>/dev/null; do
      n=$((n + 1))
      [ "$n" -gt 50 ] && break
    done
    existing="$n"
    printf '%s %s\n' "$existing" "$PROFILE" >> "$FERRY_PROFILES"
  fi
  rmdir "$lock" 2>/dev/null
  echo "$existing"
}
PROFILE_INDEX="$(ferry_profile_index)"
PORT_SHIFT=$(( PROFILE_INDEX * 1000 ))
# Suffix for anything named rather than numbered.
[ "$PROFILE" = default ] && SUFFIX="" || SUFFIX="-$PROFILE"

# Cluster state that should survive a restart: certificates and etcd.
FERRY_HOME="${FERRY_HOME:-$HOME/.ferry$SUFFIX}"
# Runtime state lives under /tmp deliberately. macOS caps unix socket paths at
# ~104 bytes and the kubelet builds its podresources socket beneath --root-dir,
# so a long home directory would break it.
FERRY_RUN="${FERRY_RUN:-/tmp/ferry-run$SUFFIX}"
FERRY_SOCK="${FERRY_SOCK:-/tmp/ferry-cri$SUFFIX.sock}"
FERRY_EXEC_SOCK="${FERRY_EXEC_SOCK:-/tmp/ferry-exec$SUFFIX.sock}"
FERRY_STREAMER_SOCK="${FERRY_STREAMER_SOCK:-/tmp/ferry-streamer$SUFFIX.sock}"
FERRY_STREAM_ADDR="${FERRY_STREAM_ADDR:-127.0.0.1:$(( 10350 + PORT_SHIFT ))}"
FERRY_PROXYD_SOCK="${FERRY_PROXYD_SOCK:-/tmp/ferry-proxyd$SUFFIX.sock}"
FERRY_NETPOL_SOCK="${FERRY_NETPOL_SOCK:-/tmp/ferry-netpol$SUFFIX.sock}"
FERRY_GPUD_SOCK="${FERRY_GPUD_SOCK:-/tmp/ferry-gpud$SUFFIX.sock}"
# Pod sockets are named by pod uid, and macOS caps a unix socket path near 104
# bytes, so this directory is deliberately short.
FERRY_GPU_DIR="${FERRY_GPU_DIR:-$FERRY_RUN/gpu}"
# How many pods may hold the GPU at once. There is one GPU; this is policy.
GPU_CAPACITY="${FERRY_GPU_CAPACITY:-1}"
# How long one request holds the device before a waiting pod gets a turn, and so
# roughly the worst wait a co-tenant sees.
GPU_SLICE="${FERRY_GPU_SLICE:-0.5}"
NODE_NAME="${FERRY_NODE_NAME:-ferry-mac$SUFFIX}"
POD_SUBNET="${FERRY_POD_SUBNET:-192.168.66.1/24}"
POD_CPUS="${FERRY_POD_CPUS:-2}"
# What counts as too little disk to start pods on.
#
# The upstream default is a percentage, and a percentage is the wrong shape for a
# laptop: 5% of a 1TB disk is 46GB held in reserve, so a Mac with 45GB free taints
# itself and schedules nothing, while a Mac with a small disk gets almost no
# margin at all. An absolute figure says what it means. Kubernetes accepts either.
EVICT_DISK="${FERRY_EVICTION_DISK:-4Gi}"
EVICT_MEMORY="${FERRY_EVICTION_MEMORY:-500Mi}"
# The cluster pod network: one flat segment every pod shares, on every node and
# every machine. Pods keep a vmnet NIC for the internet; this is the address
# Kubernetes knows them by. Setting it empty returns ferry to vmnet addressing
# and a single node.
# Each profile needs its own pod network: a vmnet subnet is reserved for the
# whole Mac, so two clusters asking for the same one means the second has none.
# The default keeps 10.244 so an existing cluster is undisturbed; the rest are
# numbered from 10.151 upward, which leaves room for fifty and stays clear of the
# ranges Docker and colima like.
if [ "$PROFILE_INDEX" = 0 ]; then
  CLUSTER_CIDR="${FERRY_CLUSTER_CIDR:-10.244.0.0/16}"
else
  CLUSTER_CIDR="${FERRY_CLUSTER_CIDR:-10.$(( 150 + PROFILE_INDEX )).0.0/16}"
fi
NODE_INDEX="${FERRY_NODE_INDEX:-0}"
RELAY_PORT="${FERRY_RELAY_PORT:-$(( 8472 + PORT_SHIFT ))}"
PEERS="${FERRY_PEERS:-}"
PEERS_FILE="$FERRY_RUN/peers"
# Advertised to the other nodes, so it must be the address they can reach. The
# LAN address works for a node on this Mac and for a node on another.
lan_address() { ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en7 2>/dev/null || echo 127.0.0.1; }
LAN_IP="${FERRY_LAN_IP:-$(lan_address)}"
POD_MEMORY_MIB="${FERRY_POD_MEMORY_MIB:-512}"

# Prefer the NAT-capable kernel when it has been built. The fallback is the
# kata-containers kernel, which boots pods perfectly well but ships netfilter
# without the NAT extensions -- so a pod cannot program Service rules in its own
# kernel, and ClusterIP routing has to happen on the host instead.
NAT_KERNEL="$here/kernel/vmlinux-arm64"
FALLBACK_KERNEL="$here/experiments/03-vm-ceiling/assets/vmlinux-arm64"
if [ -f "$NAT_KERNEL" ]; then KERNEL="$NAT_KERNEL"; else KERNEL="$FALLBACK_KERNEL"; fi
CLUSTER_DOMAIN="${FERRY_CLUSTER_DOMAIN:-cluster.local}"
COREDNS_IMAGE="${FERRY_COREDNS_IMAGE:-docker.io/coredns/coredns:1.11.3}"

# macOS pgrep does not count reliably with -c, so count lines.
count_vms() { pgrep -f "com.apple.Virtualization.VirtualMachine" 2>/dev/null | wc -l | tr -d ' '; }

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }

usage() {
  cat <<EOF
ferry -- Kubernetes on a Mac, one virtual machine per pod

  ferry doctor      check that this machine can run ferry
  ferry kernel      build a guest kernel with NAT support (slow, needs docker)
  ferry build       build the kubelet, the runtime, and fetch the guest kernel
                    --kubernetes-version <vX.Y.Z> to pick a version, --rebuild to force
  ferry up          start the cluster
  ferry down        stop the cluster
  ferry status      show what is running
  ferry logs <c>    tail a component log (ferry-cri, kubelet, ferry-proxy, apiserver, etcd)
  ferry kubeconfig  print the path to the admin kubeconfig
  ferry node add <name>   add another node on this Mac
  ferry node rm <name>    stop one
  ferry node ls           list the nodes
  ferry image load <x>    run an image you built here, without a registry
  ferry profile           which cluster this checkout runs, and on what ports
  ferry addons list       what can be turned on (metrics-server, ingress-nginx)
  ferry addons enable <n> turn one on
  ferry token create      print a command another Mac can join with
  ferry join ...          join this Mac to a cluster on another

Environment:
  FERRY_HOME             cluster state, default ~/.ferry
  FERRY_POD_SUBNET       pod network, default 192.168.66.1/24
  FERRY_POD_CPUS         cpus per pod VM, default 2
  FERRY_CLUSTER_CIDR     the pod network, default 10.244.0.0/16 (empty = vmnet)
  FERRY_EVICTION_DISK    free disk below which pods stop scheduling, default 4Gi
  FERRY_HOST_CLUSTER_IPS 1 to bind ClusterIPs on the Mac too, so the API server
                         can reach aggregated APIs like metrics.k8s.io (needs sudo)
  FERRY_RELAY_PORT       udp port the pod switch uses, default 8472
  FERRY_POD_MEMORY_MIB   memory per pod VM, default 512
  K8S_VERSION            kubernetes to build, default v1.34.0 (same as
                         'ferry build --kubernetes-version')
EOF
}

cmd_doctor() {
  bold "ferry doctor"
  local fatal=0

  if [ "$(uname -m)" = "arm64" ]; then ok "Apple silicon"
  else bad "Apple silicon required (found $(uname -m))"; fatal=1; fi

  local major; major="$(sw_vers -productVersion | cut -d. -f1)"
  if [ "$major" -ge 26 ] 2>/dev/null; then ok "macOS $(sw_vers -productVersion)"
  else
    bad "macOS 26 or newer required (found $(sw_vers -productVersion))"
    warn "per-pod networking uses VZVmnetNetworkDeviceAttachment, which is macOS 26+"
    fatal=1
  fi

  if command -v swift >/dev/null; then
    local sv; sv="$(swift --version 2>&1 | grep -oE 'version [0-9]+\.[0-9]+' | head -1 | cut -d' ' -f2)"
    if [ "$(printf '%s\n6.2\n' "$sv" | sort -V | head -1)" = "6.2" ]; then ok "Swift $sv"
    else
      bad "Swift 6.2+ required (found $sv)"
      warn 'softwareupdate --install "Command Line Tools for Xcode 26.6-26.6"'
      fatal=1
    fi
  else bad "Swift not found"; fatal=1; fi

  if command -v go >/dev/null; then ok "$(go version | cut -d' ' -f3)"
  else bad "Go 1.24+ required, needed to build the kubelet"; fatal=1; fi

  if command -v kubectl >/dev/null; then ok "kubectl present"
  else warn "kubectl not found; you will want it to talk to the cluster"; fi

  # A pod is a VM, and every other VM on the Mac takes one of ferry's 128 slots.
  local vms; vms="$(count_vms)"
  local docker; docker="$(pgrep -f "com.docker.virtualization" 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$docker" -gt 0 ]; then
    warn "Docker Desktop is running and holds one of the 128 VM slots"
  fi
  ok "$vms virtual machines running (ceiling is 128, shared with all apps)"

  if [ -f "$NAT_KERNEL" ]; then
    ok "guest kernel with NAT support — Services route inside pods, no root needed"
  else
    warn "guest kernel without NAT (kata); Services will route through the host,"
    echo "      which needs root. Build one with: ./kernel/build-kernel.sh"
  fi

  local free; free="$(df -g "$HOME" | tail -1 | awk '{print $4}')"
  if [ "$free" -ge 20 ]; then ok "${free}G free disk"
  else warn "${free}G free disk; images and pod root filesystems need room"; fi

  echo
  if [ "$fatal" -eq 0 ]; then bold "ready -- run: ferry build && ferry up"; return 0
  else bold "not ready"; return 1; fi
}

# Which Kubernetes ferry builds.
#
# Every distribution lets you pick: minikube takes --kubernetes-version, kind
# takes a node image. ferry compiles the kubelet itself, so a version is a build
# input rather than a download, and the patches in patches/ are written against
# a particular tree. That makes another version a thing you can ask for and not
# a thing that is promised to work -- build-kubelet.sh verifies every seam it
# edits and fails loudly if one has moved, which is the honest failure for a
# version whose source has drifted.
K8S_VERSION="${K8S_VERSION:-v1.34.0}"
BUILT_VERSION_FILE="$here/bin/.kubelet-version"

cmd_build() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --kubernetes-version)
        [ $# -ge 2 ] && [ -n "${2:-}" ] || { bad "--kubernetes-version needs a value, such as v1.34.0"; return 2; }
        K8S_VERSION="$2"; shift 2 ;;
      --kubernetes-version=*) K8S_VERSION="${1#*=}"; shift ;;
      --rebuild) FERRY_REBUILD=1; shift ;;
      *) bad "usage: ferry build [--kubernetes-version <vX.Y.Z>] [--rebuild]"; return 2 ;;
    esac
  done
  export K8S_VERSION

  bold "building ferry"
  echo "  kubernetes $K8S_VERSION"
  "$here/experiments/03-vm-ceiling/fetch-kernel.sh" || return 1
  echo
  # A kubelet built from a different version is not the one that was asked for,
  # so the version it was built from is recorded and a change forces a rebuild.
  local built=""
  [ -f "$BUILT_VERSION_FILE" ] && built="$(cat "$BUILT_VERSION_FILE")"
  if [ ! -x "$here/bin/kubelet" ] || [ "${FERRY_REBUILD:-}" = "1" ] || [ "$built" != "$K8S_VERSION" ]; then
    [ -n "$built" ] && [ "$built" != "$K8S_VERSION" ] &&       echo "==> kubelet was built from $built; rebuilding for $K8S_VERSION"
    "$here/build-kubelet.sh" || return 1
    echo "$K8S_VERSION" > "$BUILT_VERSION_FILE"
  else
    echo "==> kubelet present, $built (--rebuild to force)"
  fi
  echo
  ( cd "$here/ferry-cri" && ./build.sh ) || return 1
  echo
  echo "==> ferry-proxy"
  ( cd "$here/ferry-proxy" && go build -o "$here/bin/ferry-proxy" . ) || return 1
  echo "==> $here/bin/ferry-proxy"
  echo
  echo "==> ferry-netpol"
  ( cd "$here/ferry-netpol" && go build -o "$here/bin/ferry-netpol" . ) || return 1
  echo "==> $here/bin/ferry-netpol"
  echo
  # ferry-cni and the upstream plugins it runs, in both architectures.
  "$here/ferry-cni/build.sh" || return 1
  echo
  echo "==> ferry-storage"
  ( cd "$here/ferry-storage" && go build -o "$here/bin/ferry-storage" . ) || return 1
  echo "==> $here/bin/ferry-storage"
  echo
  echo "==> ferry-gpud"
  ( cd "$here/ferry-gpud" && ./build.sh ) || return 1
  echo
  echo "==> ferry-streamer"
  ( cd "$here/ferry-streamer" && go build -o "$here/bin/ferry-streamer" . ) || return 1
  echo "==> $here/bin/ferry-streamer"
  echo
  # kube-proxy's own rule generation, built for darwin from the patched tree.
  echo "==> ferry-proxyd"
  src="${K8S_SRC:-${TMPDIR:-/tmp}/ferry-kubernetes-${K8S_VERSION}}"
  if [ -d "$src" ]; then
    ( cd "$src" && GOFLAGS=-mod=vendor GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 \
        go build -o "$here/bin/ferry-proxyd" ./cmd/ferry-proxyd ) || return 1
    echo "==> $here/bin/ferry-proxyd"
  else
    warn "kubernetes source missing; run build-kubelet.sh first"
  fi
  echo
  # nft, for applying those rules inside pods.
  "$here/guest/build-nft.sh" || return 1
  echo
  bold "built -- run: ferry up"
}

running() { [ -f "$FERRY_RUN/$1.pid" ] && kill -0 "$(cat "$FERRY_RUN/$1.pid")" 2>/dev/null; }

cmd_up() {
  for required in "$here/bin/kubelet" "$here/bin/ferry-cri" "$here/bin/ferry-cni" "$KERNEL"; do
    [ -e "$required" ] || { bad "missing $(basename "$required") -- run: ferry build"; return 1; }
  done
  if running ferry-cri || running kubelet; then
    warn "ferry is already up; run 'ferry down' first"; return 1
  fi

  mkdir -p "$FERRY_HOME" "$FERRY_RUN"/{kubelet,pki,podlogs,containerlogs,volume-plugins,logs}
  rm -f "$FERRY_SOCK" "$FERRY_EXEC_SOCK" "$FERRY_STREAMER_SOCK" "$FERRY_PROXYD_SOCK" "$FERRY_GPUD_SOCK"

  bold "starting ferry"

  start_gpud

  "$here/bin/ferry-cri" \
    --endpoint "$FERRY_SOCK" --state "$FERRY_RUN/cri" --kernel "$KERNEL" \
    --pod-subnet "$POD_SUBNET" --pod-cpus "$POD_CPUS" --pod-memory-mib "$POD_MEMORY_MIB" \
    --exec-socket "$FERRY_EXEC_SOCK" --streamer-control "$FERRY_STREAMER_SOCK" \
    --nft-bundle "$here/guest/nft" --proxyd-socket "$FERRY_PROXYD_SOCK" \
    --netpol-socket "$FERRY_NETPOL_SOCK" --gpud-socket "$FERRY_GPUD_SOCK" \
    --cni "$here/bin/ferry-cni" \
    --cni-host-plugins "$here/ferry-cni/plugins/host" \
    --cni-guest-plugins "$here/ferry-cni/plugins/guest" \
    ${FERRY_CNI_CONFLIST:+--cni-conflist "$FERRY_CNI_CONFLIST"} \
    --cluster-cidr "$CLUSTER_CIDR" --node-index "$NODE_INDEX" \
    --relay-port "$RELAY_PORT" --peers "$PEERS" \
    --peers-file "$PEERS_FILE" --relay-endpoint "$LAN_IP:$RELAY_PORT" \
    >"$FERRY_RUN/logs/ferry-cri.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-cri.pid"

  local ready=
  for _ in $(seq 1 90); do
    if [ -S "$FERRY_SOCK" ] && grep -q "serving" "$FERRY_RUN/logs/ferry-cri.log" 2>/dev/null; then ready=1; break; fi
    running ferry-cri || break
    sleep 1
  done
  [ -n "$ready" ] || { bad "runtime failed to start"; tail -5 "$FERRY_RUN/logs/ferry-cri.log"; return 1; }
  ok "runtime on $(grep -oE 'network .*' "$FERRY_RUN/logs/ferry-cri.log" | tail -1)"

  # The API server must advertise the gateway of the subnet the runtime actually
  # obtained, which is not always the one requested -- vmnet networks can stay
  # claimed by an earlier run.
  local gateway; gateway="$(cat "$FERRY_RUN/cri/gateway" 2>/dev/null)"
  [ -n "$gateway" ] || { bad "runtime did not publish a pod gateway"; return 1; }
  # The runtime reserves an address for cluster DNS before any pod can take it,
  # so the kubelet can be told where DNS will be before CoreDNS exists.
  local dns; dns="$(cat "$FERRY_RUN/cri/dns" 2>/dev/null)"

  # Advertise the LAN address when there is one: it is the only address a pod on
  # another Mac can reach. Without a network, the pod gateway is still right.
  local advertise="$gateway"
  [ "$LAN_IP" != "127.0.0.1" ] && advertise="$LAN_IP"
  STATE="$FERRY_HOME" POD_GATEWAY="$gateway" ADVERTISE="$advertise" NODE_NAME="$NODE_NAME" \
    API_PORT="$(( 6443 + PORT_SHIFT ))" \
    ETCD_CLIENT_PORT="$(( 2379 + PORT_SHIFT ))" ETCD_PEER_PORT="$(( 2380 + PORT_SHIFT ))" \
    CONTROLLER_PORT="$(( 10257 + PORT_SHIFT ))" SCHEDULER_PORT="$(( 10259 + PORT_SHIFT ))" \
    SERVICE_NODE_PORT_RANGE="$(( 30000 + PROFILE_INDEX * 200 ))-$(( 30199 + PROFILE_INDEX * 200 ))" \
    "$here/control-plane/up.sh" >"$FERRY_RUN/logs/control-plane.log" 2>&1 \
    || { bad "control plane failed"; tail -5 "$FERRY_RUN/logs/control-plane.log"; return 1; }
  ok "control plane advertising $gateway"

  # kubectl exec arrives as SPDY, which ferry-streamer terminates before
  # handing the request to ferry-cri. It has to be up first, because ferry-cri
  # asks it for streaming URLs.
  if [ -x "$here/bin/ferry-streamer" ]; then
    "$here/bin/ferry-streamer" --listen "$FERRY_STREAM_ADDR" \
      --exec-socket "$FERRY_EXEC_SOCK" --control "$FERRY_STREAMER_SOCK" \
      --kubeconfig "$FERRY_HOME/admin.conf" \
      --node-name "$NODE_NAME" --relay-endpoint "$LAN_IP:$RELAY_PORT" \
      --peers-file "$PEERS_FILE" --gpud-socket "$FERRY_GPUD_SOCK" \
      >"$FERRY_RUN/logs/ferry-streamer.log" 2>&1 &
    echo $! > "$FERRY_RUN/ferry-streamer.pid"
    for _ in $(seq 1 30); do [ -S "$FERRY_STREAMER_SOCK" ] && break; sleep 0.5; done
    [ -S "$FERRY_STREAMER_SOCK" ] && ok "streaming server on $FERRY_STREAM_ADDR" \
      || warn "streaming server did not start; kubectl exec will not work"
  else
    warn "ferry-streamer not built; kubectl exec will not work"
  fi

  cat > "$FERRY_RUN/kubelet.yaml" <<EOF
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
port: $(( 10250 + PORT_SHIFT ))
healthzPort: $(( 10248 + PORT_SHIFT ))
podLogsDir: $FERRY_RUN/podlogs
containerRuntimeEndpoint: unix://$FERRY_SOCK
imageServiceEndpoint: unix://$FERRY_SOCK
volumePluginDir: $FERRY_RUN/volume-plugins
# The upstream hard-eviction defaults are sized for small cloud nodes; on a
# laptop disk imagefs.available<15% means holding tens of gigabytes idle or the
# node taints itself NoSchedule.
evictionHard:
  memory.available: "$EVICT_MEMORY"
  nodefs.available: "$EVICT_DISK"
  imagefs.available: "$EVICT_DISK"
  nodefs.inodesFree: "5%"
cgroupsPerQOS: false
enforceNodeAllocatable: []
failSwapOn: false
readOnlyPort: 0
clusterDomain: $CLUSTER_DOMAIN
${dns:+clusterDNS: [$dns]}
# A pod is a VM here, and a VM takes longer to appear than a container does.
runtimeRequestTimeout: 10m
authentication:
  x509: {clientCAFile: $FERRY_HOME/pki/ca.crt}
  anonymous: {enabled: false}
  webhook: {enabled: true}
authorization: {mode: Webhook}
EOF

  FERRY_CONTAINER_LOGS_DIR="$FERRY_RUN/containerlogs" \
  "$here/bin/kubelet" \
    --config="$FERRY_RUN/kubelet.yaml" --kubeconfig="$FERRY_HOME/kubelet.conf" \
    --hostname-override="$NODE_NAME" --root-dir="$FERRY_RUN/kubelet" \
    --cert-dir="$FERRY_RUN/pki" --v=2 >"$FERRY_RUN/logs/kubelet.log" 2>&1 &
  echo $! > "$FERRY_RUN/kubelet.pid"

  export KUBECONFIG="$FERRY_HOME/admin.conf"
  for _ in $(seq 1 60); do
    [ "$(kubectl get node "$NODE_NAME" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ] && break
    running kubelet || break
    sleep 1
  done
  if [ "$(kubectl get node "$NODE_NAME" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ]; then
    ok "node $NODE_NAME Ready"
  else
    bad "node did not become Ready"; tail -5 "$FERRY_RUN/logs/kubelet.log"; return 1
  fi

  if [ -x "$here/bin/ferry-proxyd" ]; then
    "$here/bin/ferry-proxyd" --kubeconfig "$FERRY_HOME/admin.conf" \
      --node-ip "$gateway" --socket "$FERRY_PROXYD_SOCK" \
      >"$FERRY_RUN/logs/ferry-proxyd.log" 2>&1 &
    echo $! > "$FERRY_RUN/ferry-proxyd.pid"
    for _ in $(seq 1 30); do [ -S "$FERRY_PROXYD_SOCK" ] && break; sleep 0.5; done
    [ -S "$FERRY_PROXYD_SOCK" ] && ok "Service rules rendered by kube-proxy" \
      || warn "ferry-proxyd did not start; Services will not route"
  fi

  start_netpol
  start_proxy
  start_storage
  advertise_gpu
  if [ -n "$dns" ]; then install_dns "$gateway" "$dns"; fi

  echo
  bold "ferry is up"
  echo "  export KUBECONFIG=$FERRY_HOME/admin.conf"
}

# NetworkPolicy, enforced where the packets are.
#
# A policy is per pod, and every ferry pod is a virtual machine with its own
# kernel, so the rules are worked out here and applied there -- the same way
# Service rules already reach a pod. Without this, policies were accepted and
# silently ignored, which is worse than not supporting them.
start_netpol() {
  [ -x "$here/bin/ferry-netpol" ] || { warn "ferry-netpol not built; NetworkPolicies will be ignored"; return 0; }
  rm -f "$FERRY_NETPOL_SOCK"
  "$here/bin/ferry-netpol" --kubeconfig "$FERRY_HOME/admin.conf" \
    --socket "$FERRY_NETPOL_SOCK" --cluster-cidr "$CLUSTER_CIDR" \
    >"$FERRY_RUN/logs/ferry-netpol.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-netpol.pid"
  for _ in $(seq 1 30); do [ -S "$FERRY_NETPOL_SOCK" ] && break; sleep 0.5; done
  [ -S "$FERRY_NETPOL_SOCK" ] && ok "NetworkPolicies enforced in the pods" \
    || warn "ferry-netpol did not start; NetworkPolicies will be ignored"
}

# The Mac's GPU, offered to pods over a socket.
#
# There is no GPU pass-through on Apple silicon: Virtualization.framework has no
# PCI passthrough and no compute device, and Metal is reachable only from a
# macOS process. So the work does not move into the pod -- ferry-gpud holds the
# GPU here, and a pod that asks for ferry.dev/gpu is handed a unix socket to it,
# relayed into its VM over vsock. See docs/GPU.md.
start_gpud() {
  [ -x "$here/bin/ferry-gpud" ] || { warn "ferry-gpud not built; ferry.dev/gpu will not be offered"; return 0; }
  rm -f "$FERRY_GPUD_SOCK"
  # The directory is the daemon's to create -- it makes it 0700, and doing it
  # here first would leave it 0755 until the daemon caught up.
  # Pod sockets from a previous run are stale the moment that process is gone.
  # ...and the record of who held them: this is a fresh cluster, so the daemon
  # must not restore grants for pods from the last one.
  [ -n "$FERRY_GPU_DIR" ] && rm -f "$FERRY_GPU_DIR"/*.sock "$FERRY_GPU_DIR/grants.json" 2>/dev/null || true
  "$here/bin/ferry-gpud" --control "$FERRY_GPUD_SOCK" \
    --socket-dir "$FERRY_GPU_DIR" --capacity "$GPU_CAPACITY" \
    --time-slice "$GPU_SLICE" \
    >"$FERRY_RUN/logs/ferry-gpud.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-gpud.pid"
  for _ in $(seq 1 30); do [ -S "$FERRY_GPUD_SOCK" ] && break; sleep 0.5; done
  if [ -S "$FERRY_GPUD_SOCK" ]; then
    ok "GPU offered to pods: $(sed -n 's/.*device  *//p' "$FERRY_RUN/logs/ferry-gpud.log" | head -1)"
  else
    warn "ferry-gpud did not start; ferry.dev/gpu will not be offered"
  fi
}

# Advertise the GPU as a schedulable resource.
#
# No device plugin is involved. The kubelet merges into node.status.capacity
# rather than replacing it -- "avoid blindly overwriting the capacity in case
# opaque resources are being advertised" -- so this sticks, and the scheduler
# gates on it. The number is how many pods may hold the GPU at once, not how
# many GPUs there are; there is one.
advertise_gpu() { # node-name [kubeconfig]
  local node="${1:-$NODE_NAME}"
  [ -S "$FERRY_GPUD_SOCK" ] || return 0

  # Whichever credential this machine has. A joined node has no admin.conf --
  # only the certificate the cluster issued its kubelet.
  local cfg="${2:-}"
  if [ -z "$cfg" ]; then
    if [ -r "$FERRY_HOME/admin.conf" ]; then cfg="$FERRY_HOME/admin.conf"
    elif [ -r "$FERRY_RUN/kubelet.conf" ]; then cfg="$FERRY_RUN/kubelet.conf"
    else warn "no kubeconfig to advertise ferry.dev/gpu with"; return 0; fi
  fi

  # Written with curl rather than kubectl, and that is the whole fix.
  #
  # A node may update its own status -- its kubelet does nothing else all day --
  # but it may not *get* nodes/status, which the Node authorizer scopes to the
  # object rather than the subresource. kubectl fetches before it patches, even
  # for a merge patch, so it was refused at the first step on every joined node
  # and the GPU was only ever offered by the Mac that had the admin kubeconfig.
  #
  # Sending the patch directly asks for exactly the permission the node has.
  local server cert key
  server="$(sed -n 's|.*server: *||p' "$cfg" | head -1)"
  cert="$(sed -n 's|.*client-certificate: *||p' "$cfg" | head -1)"
  key="$(sed -n 's|.*client-key: *||p' "$cfg" | head -1)"
  [ -n "$server" ] || { warn "could not read the API server address from $cfg"; return 0; }

  local auth=()
  if [ -n "$cert" ] && [ -n "$key" ]; then
    auth=(--cert "$cert" --key "$key")
  else
    # admin.conf embeds its credentials, and kubectl is present wherever that is.
    command -v kubectl >/dev/null 2>&1 || { warn "no usable credential for ferry.dev/gpu"; return 0; }
    if KUBECONFIG="$cfg" kubectl patch node "$node" --subresource=status --type=merge \
         -p "{\"status\":{\"capacity\":{\"ferry.dev/gpu\":\"$GPU_CAPACITY\"}}}" >/dev/null 2>&1; then
      ok "node advertises ferry.dev/gpu: $GPU_CAPACITY"
    else
      warn "could not advertise ferry.dev/gpu on $node"
    fi
    return 0
  fi

  local code
  code="$(curl -sk --max-time 15 -o /dev/null -w '%{http_code}' "${auth[@]}" \
    -X PATCH -H "Content-Type: application/merge-patch+json" \
    -d "{\"status\":{\"capacity\":{\"ferry.dev/gpu\":\"$GPU_CAPACITY\"}}}" \
    "$server/api/v1/nodes/$node/status" 2>/dev/null)"
  if [ "$code" = "200" ]; then
    ok "node advertises ferry.dev/gpu: $GPU_CAPACITY"
  else
    warn "could not advertise ferry.dev/gpu on $node (HTTP ${code:-no response})"
  fi
}

# Take ferry.dev/gpu off the node. Best effort and deliberately quiet: the
# control plane may already be gone, which is not worth a warning during
# shutdown.
withdraw_gpu() {
  command -v kubectl >/dev/null 2>&1 || return 0
  [ -f "$FERRY_HOME/admin.conf" ] || return 0
  local op='[{"op":"remove","path":"/status/capacity/ferry.dev~1gpu"}]'
  KUBECONFIG="$FERRY_HOME/admin.conf" kubectl patch node "$NODE_NAME" \
    --subresource=status --type=json -p "$op" >/dev/null 2>&1 || true
}

# Somewhere for a PersistentVolumeClaim to live.
#
# A volume is a directory on this Mac, handed to the pod as a virtiofs share --
# the same mechanism every other ferry mount uses. That makes it local to one
# machine, so the volume carries node affinity and binding waits for the
# scheduler to choose a node.
start_storage() {
  [ -x "$here/bin/ferry-storage" ] || { warn "ferry-storage not built; PersistentVolumeClaims will stay Pending"; return 0; }
  "$here/bin/ferry-storage" --kubeconfig "$FERRY_HOME/admin.conf" \
    --node-name "$NODE_NAME" --root "$FERRY_HOME/volumes" \
    >"$FERRY_RUN/logs/ferry-storage.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-storage.pid"
  for _ in $(seq 1 30); do
    grep -q "serving" "$FERRY_RUN/logs/ferry-storage.log" 2>/dev/null && break
    sleep 0.5
  done
  if grep -q "serving" "$FERRY_RUN/logs/ferry-storage.log" 2>/dev/null; then
    ok "PersistentVolumeClaims bind to $FERRY_HOME/volumes"
  else
    warn "ferry-storage did not start; see $FERRY_RUN/logs/ferry-storage.log"
  fi
}

# CoreDNS forwards names it does not serve. It must not forward to itself, so
# it takes the resolvers the Mac itself uses.
host_resolvers() {
  local servers
  servers="$(scutil --dns 2>/dev/null | awk '/nameserver\[[0-9]+\]/ {print $3}' | sort -u | grep -v '^127\.' | head -3 | tr '\n' ' ')"
  [ -n "$servers" ] || servers="1.1.1.1 8.8.8.8"
  echo "$servers"
}

install_dns() { # gateway dns-address
  local gateway="$1" dns="$2"
  # The same address the API server advertises and its certificate covers.
  local advertise="$gateway"
  [ "$LAN_IP" != "127.0.0.1" ] && advertise="$LAN_IP"
  local rendered="$FERRY_RUN/coredns.yaml"
  sed -e "s|__CLUSTER_DOMAIN__|$CLUSTER_DOMAIN|g" \
      -e "s|__UPSTREAM_DNS__|$(host_resolvers)|g" \
      -e "s|__COREDNS_IMAGE__|$COREDNS_IMAGE|g" \
      `# CoreDNS talks to the API server directly rather than through the` \
      `# kubernetes Service, so it has an address of its own to be told. It has` \
      `# to be one the API server's certificate covers, which the pod network` \
      `# gateway is not -- that address belongs to whichever subnet this node` \
      `# happens to have. The advertised address is in the certificate and is` \
      `# what every other client already uses.` \
      -e "s|__APISERVER_HOST__|$advertise|g" \
      -e "s|__APISERVER_PORT__|$(( 6443 + PORT_SHIFT ))|g" \
      "$here/manifests/coredns.yaml" > "$rendered"

  KUBECONFIG="$FERRY_HOME/admin.conf" kubectl apply -f "$rendered" >/dev/null 2>&1 \
    || { warn "could not apply CoreDNS"; return 0; }

  # Wait on this rollout rather than on readyReplicas.
  #
  # The cluster's objects outlive a restart -- they are in etcd, and 'ferry down'
  # stops processes rather than deleting anything. So at this point the previous
  # CoreDNS is still recorded as ready, and the apply above has just started
  # replacing it, because the pod network gateway is part of the manifest and
  # can differ from the last run. Polling readyReplicas sees that stale 1 and
  # stops immediately, and by the time it is checked again the old pod has gone
  # and the new one has not arrived -- so ferry announced a broken cluster DNS
  # that was in fact seconds from ready.
  #
  # 'rollout status' waits for the generation that was just applied, which is
  # the question actually being asked.
  if KUBECONFIG="$FERRY_HOME/admin.conf" kubectl rollout status deployment/coredns \
       -n kube-system --timeout=180s >/dev/null 2>&1; then
    ok "cluster DNS at $dns"
  else
    warn "CoreDNS did not become ready; pods will start without cluster DNS"
    echo "  Check with: ferry kubeconfig && kubectl -n kube-system logs deploy/coredns"
  fi
}

# Services route inside each pod when the guest kernel can do NAT: ferry-cri
# pushes the ruleset into pods, which program their own kernels. That needs no
# privilege on the Mac and keeps traffic pod to pod.
#
# The host proxy below is the fallback for a guest kernel without NAT. It has to
# bind ClusterIPs locally and listen on 443 for the kubernetes Service, both of
# which need root, and every Service connection then passes through the Mac.
start_proxy() {
  [ -x "$here/bin/ferry-proxy" ] || { warn "ferry-proxy not built; NodePort and LoadBalancer will not work"; return 0; }

  # ClusterIPs are handled inside each pod when the guest kernel can NAT, which
  # needs no privilege. Without such a kernel they fall back to this process,
  # which binds them on the Mac and does need root.
  # Aggregated APIs -- metrics.k8s.io and anything else served by a pod rather
  # than by the API server -- are reached by the API server itself, which is a
  # macOS process and is not on the pod network. Binding ClusterIPs on the Mac is
  # the way to give it a route there, and that needs root, so it is asked for
  # rather than assumed.
  local cluster_ips="${FERRY_HOST_CLUSTER_IPS:-false}" extra=""
  if [ "$KERNEL" = "$NAT_KERNEL" ] && [ -x "$here/bin/ferry-proxyd" ] && [ "$cluster_ips" != true ]; then
    ok "Services route inside pods (no host proxy, no root)"
  elif [ "$cluster_ips" = true ]; then
    echo "  Binding ClusterIPs on the Mac as well, so the API server can reach"
    echo "  aggregated APIs such as metrics.k8s.io. This is what needs sudo."
  else
    cluster_ips=true
    echo "  The guest kernel cannot do NAT, so ClusterIPs fall back to a host proxy."
    echo "  Build a NAT-capable kernel with 'ferry kernel' to avoid this."
  fi

  # NodePort and LoadBalancer are the outside edge of a Service and always live
  # on the Mac, whichever way ClusterIPs are handled. Node ports need no
  # privilege; a LoadBalancer port below 1024 does, and ferry-proxy says so.
  local lb="$LAN_IP"
  [ "$lb" = "127.0.0.1" ] && lb=""

  if [ "$cluster_ips" = true ]; then
    if ! sudo -n true 2>/dev/null; then
      echo "  ferry needs sudo once to bind ClusterIPs and listen on port 443."
      sudo -v || { warn "no sudo; ClusterIPs will not route (pods and DNS still work)"; return 0; }
    fi
    sudo "$here/bin/ferry-proxy" --kubeconfig "$FERRY_HOME/admin.conf" \
      --cluster-ips --node-ports --node-name "$NODE_NAME" \
      --host-ports "$FERRY_RUN/cri/hostports" \
      ${lb:+--load-balancer-ip "$lb"} \
      >"$FERRY_RUN/logs/ferry-proxy.log" 2>&1 &
    sleep 2
    local pid; pid="$(pgrep -f "bin/ferry-proxy --kubeconfig" | head -1)"
  else
    "$here/bin/ferry-proxy" --kubeconfig "$FERRY_HOME/admin.conf" \
      --node-ports --node-name "$NODE_NAME" \
      --host-ports "$FERRY_RUN/cri/hostports" \
      ${lb:+--load-balancer-ip "$lb"} \
      >"$FERRY_RUN/logs/ferry-proxy.log" 2>&1 &
    local pid=$!
  fi

  if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
    echo "$pid" > "$FERRY_RUN/ferry-proxy.pid"
    if [ -n "$lb" ]; then
      ok "NodePort on this Mac, LoadBalancer at $lb"
    else
      ok "NodePort on this Mac"
    fi
  else
    warn "ferry-proxy did not start; see $FERRY_RUN/logs/ferry-proxy.log"
  fi
}

# Another node on this Mac.
#
# A node here is a kubelet and a runtime, not a machine and not a container --
# the Mac is already the machine. So a second one costs two processes and a set
# of ports, and the pods it runs are virtual machines exactly like the first
# node's. Their addresses come from this node's own /24 inside the cluster /16,
# and they reach the first node's pods across ferry's switch.
cmd_node_add() {
  local name="${1:-}"
  [ -n "$name" ] || { bad "usage: ferry node add <name>"; return 2; }
  running ferry-cri || { bad "ferry is not up; run 'ferry up' first"; return 1; }

  # Find the first free index. Node 0 is the one 'ferry up' started.
  local index=1
  while [ -f "$FERRY_RUN/node-$index.pid" ]; do index=$((index + 1)); done
  [ "$index" -le 200 ] || { bad "too many nodes"; return 1; }

  local sock="/tmp/ferry-cri-$index.sock"
  local exec_sock="/tmp/ferry-exec-$index.sock"
  local streamer_sock="/tmp/ferry-str-$index.sock"
  local relay=$((RELAY_PORT + index))
  local kubelet_port=$(( 10250 + PORT_SHIFT + index ))
  local healthz_port=$(( 10248 + PORT_SHIFT + index * 100 ))
  local stream_addr="127.0.0.1:$((10350 + index))"
  local run="$FERRY_RUN/node-$index"

  bold "adding node $name"
  mkdir -p "$run"/{kubelet,pki,podlogs,containerlogs,volume-plugins,cri}
  rm -f "$sock" "$exec_sock" "$streamer_sock"

  "$here/bin/ferry-cri" \
    --endpoint "$sock" --state "$run/cri" --kernel "$KERNEL" \
    --pod-subnet auto --pod-cpus "$POD_CPUS" --pod-memory-mib "$POD_MEMORY_MIB" \
    --exec-socket "$exec_sock" --streamer-control "$streamer_sock" \
    --nft-bundle "$here/guest/nft" --proxyd-socket "$FERRY_PROXYD_SOCK" \
    --netpol-socket "$FERRY_NETPOL_SOCK" --gpud-socket "$FERRY_GPUD_SOCK" \
    --cni "$here/bin/ferry-cni" \
    --cni-host-plugins "$here/ferry-cni/plugins/host" \
    --cni-guest-plugins "$here/ferry-cni/plugins/guest" \
    ${FERRY_CNI_CONFLIST:+--cni-conflist "$FERRY_CNI_CONFLIST"} \
    --cluster-cidr "$CLUSTER_CIDR" --node-index "$index" \
    --relay-port "$relay" --peers-file "$PEERS_FILE" \
    --relay-endpoint "$LAN_IP:$relay" \
    >"$FERRY_RUN/logs/node-$index-cri.log" 2>&1 &
  echo $! > "$FERRY_RUN/node-$index.pid"
  local ready=
  for _ in $(seq 1 90); do
    [ -S "$sock" ] && grep -q "serving" "$FERRY_RUN/logs/node-$index-cri.log" 2>/dev/null && { ready=1; break; }
    sleep 1
  done
  [ -n "$ready" ] || { bad "the runtime for $name did not start"; tail -5 "$FERRY_RUN/logs/node-$index-cri.log"; return 1; }
  ok "runtime on 10.244.$index.0/24, switch udp/$relay"

  "$here/bin/ferry-streamer" --listen "$stream_addr" \
    --exec-socket "$exec_sock" --control "$streamer_sock" \
    --kubeconfig "$FERRY_HOME/admin.conf" \
    --node-name "$name" --relay-endpoint "$LAN_IP:$relay" \
    --peers-file "$PEERS_FILE" \
    >"$FERRY_RUN/logs/node-$index-streamer.log" 2>&1 &
  echo $! > "$FERRY_RUN/node-$index-streamer.pid"
  for _ in $(seq 1 30); do [ -S "$streamer_sock" ] && break; sleep 0.5; done

  # The kubelet's config differs from node 0's only in where things live and
  # which ports it holds; everything that makes a kubelet work on darwin is the
  # same, so it is derived rather than written out again.
  sed -e "s|$FERRY_RUN/podlogs|$run/podlogs|" \
      -e "s|unix://$FERRY_SOCK|unix://$sock|g" \
      -e "s|$FERRY_RUN/volume-plugins|$run/volume-plugins|" \
      -e "s|^readOnlyPort: 0|readOnlyPort: 0\nport: $kubelet_port\nhealthzPort: $healthz_port|" \
      "$FERRY_RUN/kubelet.yaml" > "$run/kubelet.yaml"

  FERRY_CONTAINER_LOGS_DIR="$run/containerlogs" \
  "$here/bin/kubelet" \
    --config="$run/kubelet.yaml" --kubeconfig="$FERRY_HOME/kubelet.conf" \
    --hostname-override="$name" --root-dir="$run/kubelet" \
    --cert-dir="$run/pki" --v=2 >"$FERRY_RUN/logs/node-$index-kubelet.log" 2>&1 &
  echo $! > "$FERRY_RUN/node-$index-kubelet.pid"

  export KUBECONFIG="$FERRY_HOME/admin.conf"
  for _ in $(seq 1 90); do
    [ "$(kubectl get node "$name" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ] && break
    sleep 1
  done
  if [ "$(kubectl get node "$name" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ]; then
    ok "node $name Ready"
    echo
    kubectl get nodes
  else
    bad "node $name did not become Ready"; tail -5 "$FERRY_RUN/logs/node-$index-kubelet.log"; return 1
  fi
}

cmd_node_rm() {
  local name="${1:-}"
  [ -n "$name" ] || { bad "usage: ferry node rm <name>"; return 2; }
  export KUBECONFIG="$FERRY_HOME/admin.conf"
  local index
  for index in $(seq 1 200); do
    [ -f "$FERRY_RUN/node-$index.pid" ] || continue
    grep -q "hostname-override=$name" "$FERRY_RUN/logs/node-$index-kubelet.log" 2>/dev/null && break
    pgrep -f "hostname-override=$name" >/dev/null && break
  done
  pkill -f "hostname-override=$name" 2>/dev/null
  for suffix in "" -streamer -kubelet; do
    local pidfile="$FERRY_RUN/node-$index$suffix.pid"
    [ -f "$pidfile" ] && { kill -TERM "$(cat "$pidfile")" 2>/dev/null; rm -f "$pidfile"; }
  done
  kubectl delete node "$name" >/dev/null 2>&1
  ok "node $name removed"
}

# A token another Mac can join with.
#
# Kubernetes already has a way to admit a node it has never met: a bootstrap
# token lets the kubelet ask for a certificate, and the control plane signs it.
# ferry uses that rather than inventing anything -- the token is a Secret, the
# approval is upstream RBAC, and the certificate the node ends up with is a real
# one, not a copied credential.
cmd_token_create() {
  export KUBECONFIG="$FERRY_HOME/admin.conf"
  kubectl get nodes >/dev/null 2>&1 || { bad "ferry is not up"; return 1; }

  local id secret
  id="$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 6)"
  secret="$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 16)"

  kubectl create -f - >/dev/null 2>&1 <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: bootstrap-token-$id
  namespace: kube-system
type: bootstrap.kubernetes.io/token
stringData:
  token-id: "$id"
  token-secret: "$secret"
  expiration: "$(date -u -v+24H '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u -d '+24 hours' '+%Y-%m-%dT%H:%M:%SZ')"
  usage-bootstrap-authentication: "true"
  usage-bootstrap-signing: "true"
  auth-extra-groups: system:bootstrappers:ferry
EOF

  # Let a bootstrapping node ask for a certificate, and let the control plane
  # approve the ask automatically. Without the second binding a joining node
  # waits forever on a CSR nobody looks at.
  kubectl create clusterrolebinding ferry-bootstrap \
    --clusterrole=system:node-bootstrapper \
    --group=system:bootstrappers:ferry >/dev/null 2>&1
  kubectl create clusterrolebinding ferry-autoapprove \
    --clusterrole=system:certificates.k8s.io:certificatesigningrequests:nodeclient \
    --group=system:bootstrappers:ferry >/dev/null 2>&1
  kubectl create clusterrolebinding ferry-autorenew \
    --clusterrole=system:certificates.k8s.io:certificatesigningrequests:selfnodeclient \
    --group=system:nodes >/dev/null 2>&1
  # Every node renders its own Service rules, so every node has to be able to
  # read Services and EndpointSlices. system:node-proxier is the role upstream
  # already has for this; the node's own certificate is the credential.
  kubectl create clusterrolebinding ferry-node-proxier \
    --clusterrole=system:node-proxier \
    --group=system:nodes >/dev/null 2>&1

  # A joining Mac trusts nothing yet, so it cannot fetch the CA over a verified
  # connection -- and the CA is not on the wire either, because the API server
  # serves only its own certificate. So the CA is published where anyone can read
  # it and the token carries a hash of it: the fetch is unverified, the contents
  # are not. This is how kubeadm does discovery, and for the same reason.
  kubectl create configmap cluster-info -n kube-public \
    --from-file=ca.crt="$FERRY_HOME/pki/ca.crt" >/dev/null 2>&1
  kubectl create role ferry-cluster-info -n kube-public \
    --verb=get --resource=configmaps --resource-name=cluster-info >/dev/null 2>&1
  kubectl create rolebinding ferry-cluster-info -n kube-public \
    --role=ferry-cluster-info --user=system:anonymous >/dev/null 2>&1

  local hash count index
  hash="$(openssl x509 -pubkey -in "$FERRY_HOME/pki/ca.crt" \
          | openssl pkey -pubin -outform der 2>/dev/null \
          | openssl dgst -sha256 -hex | awk '{print $NF}')"
  count="$(kubectl get nodes --no-headers 2>/dev/null | wc -l | tr -d ' ')"
  index="$count"

  bold "join token"
  echo
  echo "  On the other Mac, in a ferry checkout with the binaries copied over:"
  echo
  echo "    ./ferry join --server $LAN_IP:$(( 6443 + PORT_SHIFT )) \\"
  echo "      --token $id.$secret \\"
  echo "      --ca-hash sha256:$hash \\"
  echo "      --node-index $index"
  echo
  echo "  The token is good for 24 hours. Each node needs its own --node-index;"
  echo "  it decides which /24 of $CLUSTER_CIDR that node's pods come from."
}

# Join this Mac to a cluster running on another.
cmd_join() {
  local server= token= ca_hash= node_name= index=
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) server="$2"; shift 2 ;;
      --token) token="$2"; shift 2 ;;
      --ca-hash) ca_hash="$2"; shift 2 ;;
      --node-name) node_name="$2"; shift 2 ;;
      --node-index) index="$2"; shift 2 ;;
      *) bad "unknown option $1"; return 2 ;;
    esac
  done
  [ -n "$server" ] && [ -n "$token" ] && [ -n "$index" ] || {
    bad "usage: ferry join --server <host:6443> --token <id.secret> --ca-hash sha256:<hash> --node-index <n>"
    return 2; }
  node_name="${node_name:-$(hostname -s | tr '[:upper:]' '[:lower:]')}"

  for binary in ferry-cri kubelet ferry-streamer; do
    [ -x "$here/bin/$binary" ] || { bad "bin/$binary is missing; copy it from the first Mac"; return 1; }
  done
  [ -f "$KERNEL" ] || { bad "no guest kernel at $KERNEL; copy it from the first Mac"; return 1; }

  # macOS grants access to the local network per launching session, and an SSH
  # session ends when the command returns. A node started over SSH therefore runs
  # perfectly until that moment and then cannot reach the cluster at all, with
  # "no route to host" against an address that answers ping and answers curl.
  # Measured: zero failures for three minutes with the session held open, and
  # failures within twenty seconds of it closing.
  if [ -n "${SSH_CONNECTION:-}" ] && [ -z "${FERRY_ALLOW_SSH_JOIN:-}" ]; then
    bad "this looks like an SSH session, and a node started from one stops being"
    echo "    able to reach the cluster as soon as the session ends."
    echo
    echo "    Run 'ferry join' from a Terminal window on this Mac instead. If the"
    echo "    first pod cannot reach the network, approve the local network prompt"
    echo "    macOS shows the first time."
    echo
    echo "    To override anyway: FERRY_ALLOW_SSH_JOIN=1 ferry join ..."
    return 1
  fi

  bold "joining $server as $node_name"
  mkdir -p "$FERRY_HOME/pki" "$FERRY_RUN"/{kubelet,pki,podlogs,containerlogs,volume-plugins,logs,cri}

  # Fetch the cluster's CA without trusting the connection, then refuse it unless
  # it hashes to what the token said. The connection being unverified does not
  # matter: a server that hands over the wrong CA fails the check.
  # sed and printf rather than a JSON parser: a machine joining a cluster should
  # need nothing but what macOS ships, and the one field wanted here sits on a
  # single line with escaped newlines.
  local encoded
  encoded="$(curl -sk --max-time 20 \
    "https://$server/api/v1/namespaces/kube-public/configmaps/cluster-info" \
    | sed -n 's/^ *"ca\.crt": "\(.*\)"$/\1/p' | head -1)"
  [ -n "$encoded" ] && printf '%b' "$encoded" > "$FERRY_RUN/fetched-ca.crt"
  if [ ! -s "$FERRY_RUN/fetched-ca.crt" ]; then
    bad "could not read cluster-info from $server (was the token made by 'ferry token create'?)"
    return 1
  fi
  local h
  h="$(openssl x509 -pubkey -in "$FERRY_RUN/fetched-ca.crt" 2>/dev/null \
       | openssl pkey -pubin -outform der 2>/dev/null \
       | openssl dgst -sha256 -hex | awk '{print $NF}')"
  if [ "sha256:$h" != "$ca_hash" ]; then
    bad "the CA at $server hashes to sha256:$h, not $ca_hash -- refusing to join"
    rm -f "$FERRY_RUN/fetched-ca.crt"
    return 1
  fi
  mv "$FERRY_RUN/fetched-ca.crt" "$FERRY_HOME/pki/ca.crt"
  ok "verified the cluster CA against the token's hash"

  cat > "$FERRY_RUN/bootstrap.conf" <<EOF
apiVersion: v1
kind: Config
clusters:
- cluster: {certificate-authority: $FERRY_HOME/pki/ca.crt, server: "https://$server"}
  name: ferry
contexts:
- context: {cluster: ferry, user: bootstrap}
  name: ferry
current-context: ferry
users:
- name: bootstrap
  user: {token: "$token"}
EOF

  NODE_NAME="$node_name"
  NODE_INDEX="$index"
  RELAY_PORT=$((RELAY_PORT))
  start_worker "$node_name" "$index" || return 1
}

# The parts of a node that are not the control plane: a runtime, a streamer and
# a kubelet. Used by 'ferry join'; 'ferry up' starts these itself because it has
# a control plane to start first.
start_worker() {
  local name="$1" index="$2"
  rm -f "$FERRY_SOCK" "$FERRY_EXEC_SOCK" "$FERRY_STREAMER_SOCK"

  # A joining Mac has its own GPU, so it runs its own daemon and advertises its
  # own capacity -- unlike 'node add', which is another node on this Mac and
  # shares the one that is already running.
  start_gpud

  "$here/bin/ferry-cri" \
    --endpoint "$FERRY_SOCK" --state "$FERRY_RUN/cri" --kernel "$KERNEL" \
    --pod-subnet auto --pod-cpus "$POD_CPUS" --pod-memory-mib "$POD_MEMORY_MIB" \
    --exec-socket "$FERRY_EXEC_SOCK" --streamer-control "$FERRY_STREAMER_SOCK" \
    --nft-bundle "$here/guest/nft" --proxyd-socket "$FERRY_PROXYD_SOCK" \
    --netpol-socket "$FERRY_NETPOL_SOCK" --gpud-socket "$FERRY_GPUD_SOCK" \
    --cni "$here/bin/ferry-cni" \
    --cni-host-plugins "$here/ferry-cni/plugins/host" \
    --cni-guest-plugins "$here/ferry-cni/plugins/guest" \
    ${FERRY_CNI_CONFLIST:+--cni-conflist "$FERRY_CNI_CONFLIST"} \
    --cluster-cidr "$CLUSTER_CIDR" --node-index "$index" \
    --relay-port "$RELAY_PORT" --peers-file "$PEERS_FILE" \
    --relay-endpoint "$LAN_IP:$RELAY_PORT" \
    >"$FERRY_RUN/logs/ferry-cri.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-cri.pid"
  local ready=
  for _ in $(seq 1 90); do
    [ -S "$FERRY_SOCK" ] && grep -q "serving" "$FERRY_RUN/logs/ferry-cri.log" 2>/dev/null && { ready=1; break; }
    sleep 1
  done
  [ -n "$ready" ] || { bad "the runtime did not start"; tail -5 "$FERRY_RUN/logs/ferry-cri.log"; return 1; }
  ok "runtime on 10.244.$index.0/24, switch udp/$RELAY_PORT"

  cat > "$FERRY_RUN/kubelet.yaml" <<EOF
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
port: $(( 10250 + PORT_SHIFT ))
healthzPort: $(( 10248 + PORT_SHIFT ))
podLogsDir: $FERRY_RUN/podlogs
containerRuntimeEndpoint: unix://$FERRY_SOCK
imageServiceEndpoint: unix://$FERRY_SOCK
volumePluginDir: $FERRY_RUN/volume-plugins
evictionHard:
  memory.available: "$EVICT_MEMORY"
  nodefs.available: "$EVICT_DISK"
  imagefs.available: "$EVICT_DISK"
  nodefs.inodesFree: "5%"
cgroupsPerQOS: false
enforceNodeAllocatable: []
failSwapOn: false
readOnlyPort: 0
clusterDomain: $CLUSTER_DOMAIN
clusterDNS: [10.244.0.2]
runtimeRequestTimeout: 10m
authentication:
  x509: {clientCAFile: $FERRY_HOME/pki/ca.crt}
  anonymous: {enabled: false}
  webhook: {enabled: true}
authorization: {mode: Webhook}
EOF

  FERRY_CONTAINER_LOGS_DIR="$FERRY_RUN/containerlogs" \
  "$here/bin/kubelet" \
    --config="$FERRY_RUN/kubelet.yaml" \
    --bootstrap-kubeconfig="$FERRY_RUN/bootstrap.conf" \
    --kubeconfig="$FERRY_RUN/kubelet.conf" \
    --hostname-override="$name" --root-dir="$FERRY_RUN/kubelet" \
    --cert-dir="$FERRY_RUN/pki" --v=2 >"$FERRY_RUN/logs/kubelet.log" 2>&1 &
  echo $! > "$FERRY_RUN/kubelet.pid"

  for _ in $(seq 1 120); do
    [ -f "$FERRY_RUN/kubelet.conf" ] && break
    sleep 1
  done
  if [ -f "$FERRY_RUN/kubelet.conf" ]; then
    ok "got a certificate from the cluster"
  else
    bad "the kubelet never got a certificate"; tail -8 "$FERRY_RUN/logs/kubelet.log"; return 1
  fi

  # Only now: the streamer authenticates as this node, and the credential it
  # needs is the one the kubelet has just been issued. Started any earlier it
  # has nothing to present, and the node never advertises where its switch is.
  "$here/bin/ferry-streamer" --listen "$FERRY_STREAM_ADDR" \
    --exec-socket "$FERRY_EXEC_SOCK" --control "$FERRY_STREAMER_SOCK" \
    --kubeconfig "$FERRY_RUN/kubelet.conf" \
    --node-name "$name" --relay-endpoint "$LAN_IP:$RELAY_PORT" \
    --peers-file "$PEERS_FILE" --gpud-socket "$FERRY_GPUD_SOCK" \
    >"$FERRY_RUN/logs/ferry-streamer.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-streamer.pid"
  for _ in $(seq 1 30); do [ -S "$FERRY_STREAMER_SOCK" ] && break; sleep 0.5; done
  ok "advertising this node's switch at $LAN_IP:$RELAY_PORT"

  # The node object exists now, so its GPU capacity can go on it.
  advertise_gpu "$name" "$FERRY_RUN/kubelet.conf"

  # Service rules are rendered per node, so a worker runs its own ferry-proxyd.
  # Like the streamer it authenticates as the node, so it also waits for the
  # certificate. ferry-cri is already asking for a ruleset and simply keeps
  # asking until this answers.
  if [ -x "$here/bin/ferry-proxyd" ]; then
    local gateway; gateway="$(cat "$FERRY_RUN/cri/gateway" 2>/dev/null || echo "$LAN_IP")"
    rm -f "$FERRY_PROXYD_SOCK"
    "$here/bin/ferry-proxyd" --kubeconfig "$FERRY_RUN/kubelet.conf" \
      --node-name "$name" --node-ip "$gateway" --socket "$FERRY_PROXYD_SOCK" \
      >"$FERRY_RUN/logs/ferry-proxyd.log" 2>&1 &
    echo $! > "$FERRY_RUN/ferry-proxyd.pid"
    for _ in $(seq 1 30); do [ -S "$FERRY_PROXYD_SOCK" ] && break; sleep 0.5; done
    [ -S "$FERRY_PROXYD_SOCK" ] && ok "Service rules rendered by kube-proxy" \
      || warn "ferry-proxyd did not start; Services will not route on this node"
  else
    warn "bin/ferry-proxyd is missing; Services will not route on this node"
  fi

  # Node ports and claims are per node too: a pod scheduled here needs its
  # volume made here, and a connection arriving here needs forwarding here.
  local lb="$LAN_IP"; [ "$lb" = "127.0.0.1" ] && lb=""
  if [ -x "$here/bin/ferry-proxy" ]; then
    "$here/bin/ferry-proxy" --kubeconfig "$FERRY_RUN/kubelet.conf" \
      --node-ports --node-name "$name" \
      --host-ports "$FERRY_RUN/cri/hostports" \
      ${lb:+--load-balancer-ip "$lb"} \
      >"$FERRY_RUN/logs/ferry-proxy.log" 2>&1 &
    echo $! > "$FERRY_RUN/ferry-proxy.pid"
    ok "NodePort on this Mac${lb:+, LoadBalancer at $lb}"
  fi
  if [ -x "$here/bin/ferry-storage" ]; then
    "$here/bin/ferry-storage" --kubeconfig "$FERRY_RUN/kubelet.conf" \
      --node-name "$name" --root "$FERRY_HOME/volumes" --default=false \
      >"$FERRY_RUN/logs/ferry-storage.log" 2>&1 &
    echo $! > "$FERRY_RUN/ferry-storage.pid"
    ok "PersistentVolumeClaims bind to $FERRY_HOME/volumes"
  fi

  echo
  bold "joined as $name"
  echo "  its pods will be 10.244.$index.x and reach the other nodes' pods directly"
}

# Things everybody wants and nobody should have to hunt for.
#
# An addon is a directory of ordinary Kubernetes manifests under addons/. Nothing
# about them is special to ferry; they are here so a laptop cluster can have
# metrics and an ingress controller without a scavenger hunt, and so the versions
# are pinned to ones that have actually been run.
cmd_addons() {
  local action="${1:-list}" name="${2:-}"
  export KUBECONFIG="$FERRY_HOME/admin.conf"

  case "$action" in
    list|"")
      bold "addons"
      local dir
      for dir in "$here"/addons/*/; do
        [ -d "$dir" ] || continue
        local addon; addon="$(basename "$dir")"
        if kubectl get namespace "$addon" >/dev/null 2>&1 \
           || kubectl -n kube-system get deployment "$addon" >/dev/null 2>&1; then
          ok "$addon (enabled)"
        else
          echo "    $addon"
        fi
      done
      echo
      echo "  ferry addons enable <name>"
      ;;

    enable)
      [ -n "$name" ] || { bad "usage: ferry addons enable <name>"; return 2; }
      local dir="$here/addons/$name"
      [ -d "$dir" ] || { bad "no addon called $name"; return 1; }
      kubectl get nodes >/dev/null 2>&1 || { bad "ferry is not up"; return 1; }

      bold "enabling $name"
      local dns; dns="$(cat "$FERRY_RUN/cri/dns" 2>/dev/null || echo "")"
      local rendered; rendered="$(mktemp -d)"
      # shellcheck disable=SC2064
      trap "rm -rf '$rendered'" RETURN
      local file
      for file in "$dir"/*.yaml; do
        [ -f "$file" ] || continue
        sed -e "s|__CLUSTER_DNS__|$dns|g" -e "s|__NODE_NAME__|$NODE_NAME|g" \
          "$file" > "$rendered/$(basename "$file")"
      done
      kubectl apply -f "$rendered" >/dev/null 2>&1 || { bad "could not apply $name"; return 1; }
      ok "applied"
      [ -f "$dir/NOTES" ] && { echo; sed 's/^/  /' "$dir/NOTES"; }
      ;;

    disable)
      [ -n "$name" ] || { bad "usage: ferry addons disable <name>"; return 2; }
      local dir="$here/addons/$name"
      [ -d "$dir" ] || { bad "no addon called $name"; return 1; }
      bold "disabling $name"
      kubectl delete -f "$dir" --ignore-not-found >/dev/null 2>&1
      ok "removed"
      ;;

    *) bad "usage: ferry addons [list|enable <name>|disable <name>]"; return 2 ;;
  esac
}

# Run an image you just built.
#
# Everything else in ferry comes from a registry, which is fine for busybox and
# useless for the thing you are working on. 'minikube image load' and 'kind load
# docker-image' exist for this, and until now ferry had no answer at all.
#
# What arrives can be an OCI layout directory, an archive of one, or the name of
# an image Docker or Podman is holding -- in the last case ferry asks that tool
# to export it first. The image keeps the name it already has, so a manifest
# saying `myapp:dev` still says that.
cmd_image_load() {
  local what="${1:-}"
  [ -n "$what" ] || { bad "usage: ferry image load <name|archive.tar|oci-directory>"; return 2; }
  [ -S "$FERRY_EXEC_SOCK" ] || { bad "ferry is not up"; return 1; }

  local staging; staging="$(mktemp -d "${TMPDIR:-/tmp}/ferry-load.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -rf '$staging'" RETURN

  local layout=
  if [ -d "$what" ]; then
    layout="$what"
  elif [ -f "$what" ]; then
    tar -xf "$what" -C "$staging" 2>/dev/null || { bad "could not unpack $what"; return 1; }
    layout="$staging"
  else
    # A name: ask whichever tool has it to hand over an OCI archive. Docker's
    # plain 'save' format is not one, so the flag is not optional.
    local exported="$staging/image.tar"
    if command -v docker >/dev/null 2>&1 && docker image inspect "$what" >/dev/null 2>&1; then
      echo "  exporting $what from docker"
      docker save --output "$exported" "$what" >/dev/null 2>&1 || { bad "docker save failed"; return 1; }
    elif command -v podman >/dev/null 2>&1 && podman image exists "$what" 2>/dev/null; then
      echo "  exporting $what from podman"
      podman save --format oci-archive --output "$exported" "$what" >/dev/null 2>&1 \
        || { bad "podman save failed"; return 1; }
    else
      bad "no such file, directory, or local image: $what"
      return 1
    fi
    mkdir -p "$staging/layout"
    tar -xf "$exported" -C "$staging/layout" 2>/dev/null || { bad "could not unpack the export"; return 1; }
    layout="$staging/layout"
  fi

  # An OCI layout says so. Anything else will fail inside ferry-cri with a less
  # helpful message, so it is worth saying here.
  if [ ! -f "$layout/oci-layout" ] || [ ! -f "$layout/index.json" ]; then
    bad "$what is not an OCI layout (no oci-layout/index.json)"
    echo "    Docker's default 'save' format is not one. Export with:"
    echo "      docker save <name> | ...   # docker 25+ with the containerd store"
    echo "      podman save --format oci-archive <name> -o image.tar"
    return 1
  fi

  # ferry-cri owns the image store, so the load happens there. One JSON line in,
  # one back, over the socket it already listens on.
  echo "  loading into the image store"
  local reply
  reply="$(printf '{"op":"loadimage","path":"%s"}\n' "$layout" | nc -U "$FERRY_EXEC_SOCK" 2>/dev/null)"

  case "$reply" in
    *'"images"'*)
      # {"images":["a","b"]} -> one name per line, without reaching for a parser.
      echo "$reply" \
        | sed -e 's/.*"images":\[//' -e 's/\].*//' -e 's/","/\n/g' -e 's/"//g' -e 's|\\/|/|g' \
        | while read -r name; do [ -n "$name" ] && ok "loaded $name"; done
      echo
      echo "  Pods must not try to fetch it again: set"
      echo "    imagePullPolicy: IfNotPresent   (or Never)"
      ;;
    *'"error"'*)
      bad "$(echo "$reply" | sed -n 's/.*"error":"\(.*\)".*/\1/p')" ;;
    *)
      bad "ferry-cri did not answer; see 'ferry logs ferry-cri'" ;;
  esac
}

# What this checkout is using, and why.
#
# Worth being able to ask: when two clusters are running on one Mac the first
# question is always which one you are talking to.
cmd_profile() {
  bold "profile $PROFILE"
  echo "  state       $FERRY_HOME"
  echo "  runtime     $FERRY_RUN"
  echo "  node name   $NODE_NAME"
  echo "  pod network $CLUSTER_CIDR"
  echo "  api server  https://$(lan_address):$(( 6443 + PORT_SHIFT ))"
  echo "  kubelet     $(( 10250 + PORT_SHIFT ))"
  echo "  streaming   $FERRY_STREAM_ADDR"
  echo "  pod switch  udp/$RELAY_PORT"
  echo "  node ports  $(( 30000 + PROFILE_INDEX * 200 ))-$(( 30199 + PROFILE_INDEX * 200 ))"
  echo
  if [ "$PROFILE" = default ]; then
    echo "  This is the main checkout, so nothing is renamed or moved."
  else
    echo "  This is a worktree, so it has its own state, ports and pod network"
    echo "  and will not disturb a cluster running from another checkout."
  fi
  echo "  Set FERRY_PROFILE to override."
}

cmd_down() {
  bold "stopping ferry"
  # ferry-proxy runs as root, so stopping it does too.
  if [ -f "$FERRY_RUN/ferry-proxy.pid" ]; then
    sudo kill -TERM "$(cat "$FERRY_RUN/ferry-proxy.pid")" 2>/dev/null \
      && ok "Service proxy stopped"
    rm -f "$FERRY_RUN/ferry-proxy.pid"
    sleep 1
  fi
  # Extra nodes first: each is a kubelet, a runtime and a streamer of its own.
  local index
  for index in $(seq 1 200); do
    [ -f "$FERRY_RUN/node-$index.pid" ] || continue
    for suffix in -kubelet -streamer ""; do
      local pidfile="$FERRY_RUN/node-$index$suffix.pid"
      [ -f "$pidfile" ] || continue
      local pid; pid="$(cat "$pidfile")"; rm -f "$pidfile"
      kill -TERM "$pid" 2>/dev/null || continue
      for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
      kill -KILL "$pid" 2>/dev/null
    done
    rm -f "/tmp/ferry-cri-$index.sock" "/tmp/ferry-exec-$index.sock" "/tmp/ferry-str-$index.sock"
    ok "node $index stopped"
  done

  for component in kubelet ferry-cri ferry-streamer ferry-proxyd ferry-netpol ferry-storage ferry-gpud; do
    local pidfile="$FERRY_RUN/$component.pid"
    [ -f "$pidfile" ] || continue
    local pid; pid="$(cat "$pidfile")"
    rm -f "$pidfile"
    kill -TERM "$pid" 2>/dev/null || continue
    # ferry-cri must finish releasing its vmnet network before another run can
    # claim the same subnet.
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -KILL "$pid" 2>/dev/null
    ok "$component stopped"
  done
  # A listener that outlives its pid file holds the node port against the next
  # run, and the symptom -- "address already in use" buried in a log -- is a poor
  # way to find that out.
  pkill -f "bin/ferry-proxy --kubeconfig" 2>/dev/null
  sudo pkill -f "bin/ferry-proxy --kubeconfig" 2>/dev/null

  # After the streamer, which would otherwise put it straight back, and before
  # the control plane, which has to be up to accept the patch.
  withdraw_gpu

  STATE="$FERRY_HOME" "$here/control-plane/down.sh" >/dev/null 2>&1 && ok "control plane stopped"
  rm -f "$FERRY_SOCK" "$FERRY_EXEC_SOCK" "$FERRY_STREAMER_SOCK" "$FERRY_PROXYD_SOCK" "$FERRY_NETPOL_SOCK" "$PEERS_FILE"
}

cmd_status() {
  bold "ferry status"
  for component in ferry-cri ferry-streamer ferry-proxyd ferry-netpol ferry-storage ferry-gpud kubelet ferry-proxy; do
    if running "$component"; then ok "$component (pid $(cat "$FERRY_RUN/$component.pid"))"
    else bad "$component"; fi
  done
  for component in etcd kube-apiserver kube-controller-manager kube-scheduler; do
    if [ -f "$FERRY_HOME/$component.pid" ] && kill -0 "$(cat "$FERRY_HOME/$component.pid")" 2>/dev/null
    then ok "$component"; else bad "$component"; fi
  done
  echo "  $(count_vms) pod VMs running"
  if [ -f "$FERRY_HOME/admin.conf" ] && running kubelet; then
    echo
    KUBECONFIG="$FERRY_HOME/admin.conf" kubectl get nodes 2>/dev/null
  fi
}

cmd_logs() {
  local which="${1:-}"
  case "$which" in
    ferry-cri|kubelet|control-plane|ferry-proxy|ferry-proxyd|ferry-streamer|ferry-netpol|ferry-storage|ferry-gpud) tail -f "$FERRY_RUN/logs/$which.log" ;;
    apiserver|kube-apiserver)        tail -f "$FERRY_HOME/logs/kube-apiserver.log" ;;
    etcd)                            tail -f "$FERRY_HOME/logs/etcd.log" ;;
    *) echo "usage: ferry logs <ferry-cri|kubelet|control-plane|apiserver|etcd>"; return 1 ;;
  esac
}

case "${1:-}" in
  doctor)     shift; cmd_doctor "$@" ;;
  kernel)     shift; "$here/kernel/build-kernel.sh" "$@" ;;
  build)      shift; cmd_build "$@" ;;
  up)         shift; cmd_up "$@" ;;
  profile)    shift; cmd_profile ;;
  addons)     shift; cmd_addons "$@" ;;
  image)      shift
              case "${1:-}" in
                load) shift; cmd_image_load "$@" ;;
                ls|"") KUBECONFIG="$FERRY_HOME/admin.conf" kubectl get pods -A -o jsonpath='{range .items[*]}{.spec.containers[*].image}{"\n"}{end}' 2>/dev/null | sort -u ;;
                *) bad "usage: ferry image [load <name|archive|dir>|ls]"; exit 2 ;;
              esac ;;
  token)      shift; case "${1:-}" in create|"") cmd_token_create ;; *) bad "usage: ferry token create"; exit 2 ;; esac ;;
  join)       shift; cmd_join "$@" ;;
  node)       shift
              case "${1:-}" in
                add) shift; cmd_node_add "$@" ;;
                rm)  shift; cmd_node_rm "$@" ;;
                ls|"") KUBECONFIG="$FERRY_HOME/admin.conf" kubectl get nodes ;;
                *)   bad "usage: ferry node [add <name>|rm <name>|ls]"; exit 2 ;;
              esac ;;
  down)       shift; cmd_down "$@" ;;
  status)     shift; cmd_status "$@" ;;
  logs)       shift; cmd_logs "$@" ;;
  kubeconfig) echo "$FERRY_HOME/admin.conf" ;;
  -h|--help|help|"") usage ;;
  *) echo "unknown command: $1"; echo; usage; exit 1 ;;
esac
