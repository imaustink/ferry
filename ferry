#!/usr/bin/env bash
# ferry -- Kubernetes on a Mac, one virtual machine per pod.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Cluster state that should survive a restart: certificates and etcd.
FERRY_HOME="${FERRY_HOME:-$HOME/.ferry}"
# Runtime state lives under /tmp deliberately. macOS caps unix socket paths at
# ~104 bytes and the kubelet builds its podresources socket beneath --root-dir,
# so a long home directory would break it.
FERRY_RUN="${FERRY_RUN:-/tmp/ferry-run}"
FERRY_SOCK="${FERRY_SOCK:-/tmp/ferry-cri.sock}"
FERRY_EXEC_SOCK="${FERRY_EXEC_SOCK:-/tmp/ferry-exec.sock}"
FERRY_STREAMER_SOCK="${FERRY_STREAMER_SOCK:-/tmp/ferry-streamer.sock}"
FERRY_STREAM_ADDR="${FERRY_STREAM_ADDR:-127.0.0.1:10350}"
FERRY_PROXYD_SOCK="${FERRY_PROXYD_SOCK:-/tmp/ferry-proxyd.sock}"
NODE_NAME="${FERRY_NODE_NAME:-ferry-mac}"
POD_SUBNET="${FERRY_POD_SUBNET:-192.168.66.1/24}"
POD_CPUS="${FERRY_POD_CPUS:-2}"
# The cluster pod network: one flat segment every pod shares, on every node and
# every machine. Pods keep a vmnet NIC for the internet; this is the address
# Kubernetes knows them by. Setting it empty returns ferry to vmnet addressing
# and a single node.
CLUSTER_CIDR="${FERRY_CLUSTER_CIDR:-10.244.0.0/16}"
NODE_INDEX="${FERRY_NODE_INDEX:-0}"
RELAY_PORT="${FERRY_RELAY_PORT:-8472}"
PEERS="${FERRY_PEERS:-}"
PEERS_FILE="$FERRY_RUN/peers"
# Advertised to the other nodes, so it must be the address they can reach. The
# LAN address works for a node on this Mac and for a node on another.
lan_address() { ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en7 2>/dev/null || echo 127.0.0.1; }
LAN_IP="${FERRY_LAN_IP:-$(lan_address)}"
POD_MEMORY_MIB="${FERRY_POD_MEMORY_MIB:-512}"

# Prefer the NAT-capable kernel when it has been built. The fallback is the
# kata-containers kernel, which boots pods perfectly well but ships netfilter
# without the NAT extensions -- so a pod cannot program Service rules in its own
# kernel, and ClusterIP routing has to happen on the host instead.
NAT_KERNEL="$here/kernel/vmlinux-arm64"
FALLBACK_KERNEL="$here/experiments/03-vm-ceiling/assets/vmlinux-arm64"
if [ -f "$NAT_KERNEL" ]; then KERNEL="$NAT_KERNEL"; else KERNEL="$FALLBACK_KERNEL"; fi
CLUSTER_DOMAIN="${FERRY_CLUSTER_DOMAIN:-cluster.local}"
COREDNS_IMAGE="${FERRY_COREDNS_IMAGE:-docker.io/coredns/coredns:1.11.3}"

# macOS pgrep does not count reliably with -c, so count lines.
count_vms() { pgrep -f "com.apple.Virtualization.VirtualMachine" 2>/dev/null | wc -l | tr -d ' '; }

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }

usage() {
  cat <<EOF
ferry -- Kubernetes on a Mac, one virtual machine per pod

  ferry doctor      check that this machine can run ferry
  ferry kernel      build a guest kernel with NAT support (slow, needs docker)
  ferry build       build the kubelet, the runtime, and fetch the guest kernel
  ferry up          start the cluster
  ferry down        stop the cluster
  ferry status      show what is running
  ferry logs <c>    tail a component log (ferry-cri, kubelet, ferry-proxy, apiserver, etcd)
  ferry kubeconfig  print the path to the admin kubeconfig
  ferry node add <name>   add another node on this Mac
  ferry node rm <name>    stop one
  ferry node ls           list the nodes

Environment:
  FERRY_HOME             cluster state, default ~/.ferry
  FERRY_POD_SUBNET       pod network, default 192.168.66.1/24
  FERRY_POD_CPUS         cpus per pod VM, default 2
  FERRY_CLUSTER_CIDR     the pod network, default 10.244.0.0/16 (empty = vmnet)
  FERRY_RELAY_PORT       udp port the pod switch uses, default 8472
  FERRY_POD_MEMORY_MIB   memory per pod VM, default 512
EOF
}

cmd_doctor() {
  bold "ferry doctor"
  local fatal=0

  if [ "$(uname -m)" = "arm64" ]; then ok "Apple silicon"
  else bad "Apple silicon required (found $(uname -m))"; fatal=1; fi

  local major; major="$(sw_vers -productVersion | cut -d. -f1)"
  if [ "$major" -ge 26 ] 2>/dev/null; then ok "macOS $(sw_vers -productVersion)"
  else
    bad "macOS 26 or newer required (found $(sw_vers -productVersion))"
    warn "per-pod networking uses VZVmnetNetworkDeviceAttachment, which is macOS 26+"
    fatal=1
  fi

  if command -v swift >/dev/null; then
    local sv; sv="$(swift --version 2>&1 | grep -oE 'version [0-9]+\.[0-9]+' | head -1 | cut -d' ' -f2)"
    if [ "$(printf '%s\n6.2\n' "$sv" | sort -V | head -1)" = "6.2" ]; then ok "Swift $sv"
    else
      bad "Swift 6.2+ required (found $sv)"
      warn 'softwareupdate --install "Command Line Tools for Xcode 26.6-26.6"'
      fatal=1
    fi
  else bad "Swift not found"; fatal=1; fi

  if command -v go >/dev/null; then ok "$(go version | cut -d' ' -f3)"
  else bad "Go 1.24+ required, needed to build the kubelet"; fatal=1; fi

  if command -v kubectl >/dev/null; then ok "kubectl present"
  else warn "kubectl not found; you will want it to talk to the cluster"; fi

  # A pod is a VM, and every other VM on the Mac takes one of ferry's 128 slots.
  local vms; vms="$(count_vms)"
  local docker; docker="$(pgrep -f "com.docker.virtualization" 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$docker" -gt 0 ]; then
    warn "Docker Desktop is running and holds one of the 128 VM slots"
  fi
  ok "$vms virtual machines running (ceiling is 128, shared with all apps)"

  if [ -f "$NAT_KERNEL" ]; then
    ok "guest kernel with NAT support — Services route inside pods, no root needed"
  else
    warn "guest kernel without NAT (kata); Services will route through the host,"
    echo "      which needs root. Build one with: ./kernel/build-kernel.sh"
  fi

  local free; free="$(df -g "$HOME" | tail -1 | awk '{print $4}')"
  if [ "$free" -ge 20 ]; then ok "${free}G free disk"
  else warn "${free}G free disk; images and pod root filesystems need room"; fi

  echo
  if [ "$fatal" -eq 0 ]; then bold "ready -- run: ferry build && ferry up"; return 0
  else bold "not ready"; return 1; fi
}

cmd_build() {
  bold "building ferry"
  "$here/experiments/03-vm-ceiling/fetch-kernel.sh" || return 1
  echo
  if [ ! -x "$here/bin/kubelet" ] || [ "${FERRY_REBUILD:-}" = "1" ]; then
    "$here/build-kubelet.sh" || return 1
  else
    echo "==> kubelet present (FERRY_REBUILD=1 to force)"
  fi
  echo
  ( cd "$here/ferry-cri" && ./build.sh ) || return 1
  echo
  echo "==> ferry-proxy"
  ( cd "$here/ferry-proxy" && go build -o "$here/bin/ferry-proxy" . ) || return 1
  echo "==> $here/bin/ferry-proxy"
  echo
  echo "==> ferry-streamer"
  ( cd "$here/ferry-streamer" && go build -o "$here/bin/ferry-streamer" . ) || return 1
  echo "==> $here/bin/ferry-streamer"
  echo
  # kube-proxy's own rule generation, built for darwin from the patched tree.
  echo "==> ferry-proxyd"
  src="${K8S_SRC:-${TMPDIR:-/tmp}/ferry-kubernetes-${K8S_VERSION:-v1.34.0}}"
  if [ -d "$src" ]; then
    ( cd "$src" && GOFLAGS=-mod=vendor GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 \
        go build -o "$here/bin/ferry-proxyd" ./cmd/ferry-proxyd ) || return 1
    echo "==> $here/bin/ferry-proxyd"
  else
    warn "kubernetes source missing; run build-kubelet.sh first"
  fi
  echo
  # nft, for applying those rules inside pods.
  "$here/guest/build-nft.sh" || return 1
  echo
  bold "built -- run: ferry up"
}

running() { [ -f "$FERRY_RUN/$1.pid" ] && kill -0 "$(cat "$FERRY_RUN/$1.pid")" 2>/dev/null; }

cmd_up() {
  for required in "$here/bin/kubelet" "$here/bin/ferry-cri" "$KERNEL"; do
    [ -e "$required" ] || { bad "missing $(basename "$required") -- run: ferry build"; return 1; }
  done
  if running ferry-cri || running kubelet; then
    warn "ferry is already up; run 'ferry down' first"; return 1
  fi

  mkdir -p "$FERRY_HOME" "$FERRY_RUN"/{kubelet,pki,podlogs,containerlogs,volume-plugins,logs}
  rm -f "$FERRY_SOCK" "$FERRY_EXEC_SOCK" "$FERRY_STREAMER_SOCK" "$FERRY_PROXYD_SOCK"

  bold "starting ferry"

  "$here/bin/ferry-cri" \
    --endpoint "$FERRY_SOCK" --state "$FERRY_RUN/cri" --kernel "$KERNEL" \
    --pod-subnet "$POD_SUBNET" --pod-cpus "$POD_CPUS" --pod-memory-mib "$POD_MEMORY_MIB" \
    --exec-socket "$FERRY_EXEC_SOCK" --streamer-control "$FERRY_STREAMER_SOCK" \
    --nft-bundle "$here/guest/nft" --proxyd-socket "$FERRY_PROXYD_SOCK" \
    --cluster-cidr "$CLUSTER_CIDR" --node-index "$NODE_INDEX" \
    --relay-port "$RELAY_PORT" --peers "$PEERS" \
    --peers-file "$PEERS_FILE" --relay-endpoint "$LAN_IP:$RELAY_PORT" \
    >"$FERRY_RUN/logs/ferry-cri.log" 2>&1 &
  echo $! > "$FERRY_RUN/ferry-cri.pid"

  local ready=
  for _ in $(seq 1 90); do
    if [ -S "$FERRY_SOCK" ] && grep -q "serving" "$FERRY_RUN/logs/ferry-cri.log" 2>/dev/null; then ready=1; break; fi
    running ferry-cri || break
    sleep 1
  done
  [ -n "$ready" ] || { bad "runtime failed to start"; tail -5 "$FERRY_RUN/logs/ferry-cri.log"; return 1; }
  ok "runtime on $(grep -oE 'network .*' "$FERRY_RUN/logs/ferry-cri.log" | tail -1)"

  # The API server must advertise the gateway of the subnet the runtime actually
  # obtained, which is not always the one requested -- vmnet networks can stay
  # claimed by an earlier run.
  local gateway; gateway="$(cat "$FERRY_RUN/cri/gateway" 2>/dev/null)"
  [ -n "$gateway" ] || { bad "runtime did not publish a pod gateway"; return 1; }
  # The runtime reserves an address for cluster DNS before any pod can take it,
  # so the kubelet can be told where DNS will be before CoreDNS exists.
  local dns; dns="$(cat "$FERRY_RUN/cri/dns" 2>/dev/null)"

  STATE="$FERRY_HOME" POD_GATEWAY="$gateway" NODE_NAME="$NODE_NAME" \
    "$here/control-plane/up.sh" >"$FERRY_RUN/logs/control-plane.log" 2>&1 \
    || { bad "control plane failed"; tail -5 "$FERRY_RUN/logs/control-plane.log"; return 1; }
  ok "control plane advertising $gateway"

  # kubectl exec arrives as SPDY, which ferry-streamer terminates before
  # handing the request to ferry-cri. It has to be up first, because ferry-cri
  # asks it for streaming URLs.
  if [ -x "$here/bin/ferry-streamer" ]; then
    "$here/bin/ferry-streamer" --listen "$FERRY_STREAM_ADDR" \
      --exec-socket "$FERRY_EXEC_SOCK" --control "$FERRY_STREAMER_SOCK" \
      --kubeconfig "$FERRY_HOME/admin.conf" \
      --node-name "$NODE_NAME" --relay-endpoint "$LAN_IP:$RELAY_PORT" \
      --peers-file "$PEERS_FILE" \
      >"$FERRY_RUN/logs/ferry-streamer.log" 2>&1 &
    echo $! > "$FERRY_RUN/ferry-streamer.pid"
    for _ in $(seq 1 30); do [ -S "$FERRY_STREAMER_SOCK" ] && break; sleep 0.5; done
    [ -S "$FERRY_STREAMER_SOCK" ] && ok "streaming server on $FERRY_STREAM_ADDR" \
      || warn "streaming server did not start; kubectl exec will not work"
  else
    warn "ferry-streamer not built; kubectl exec will not work"
  fi

  cat > "$FERRY_RUN/kubelet.yaml" <<EOF
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
podLogsDir: $FERRY_RUN/podlogs
containerRuntimeEndpoint: unix://$FERRY_SOCK
imageServiceEndpoint: unix://$FERRY_SOCK
volumePluginDir: $FERRY_RUN/volume-plugins
# The upstream hard-eviction defaults are sized for small cloud nodes; on a
# laptop disk imagefs.available<15% means holding tens of gigabytes idle or the
# node taints itself NoSchedule.
evictionHard:
  memory.available: "500Mi"
  nodefs.available: "5%"
  imagefs.available: "5%"
  nodefs.inodesFree: "5%"
cgroupsPerQOS: false
enforceNodeAllocatable: []
failSwapOn: false
readOnlyPort: 0
clusterDomain: $CLUSTER_DOMAIN
${dns:+clusterDNS: [$dns]}
# A pod is a VM here, and a VM takes longer to appear than a container does.
runtimeRequestTimeout: 10m
authentication:
  x509: {clientCAFile: $FERRY_HOME/pki/ca.crt}
  anonymous: {enabled: false}
  webhook: {enabled: true}
authorization: {mode: Webhook}
EOF

  FERRY_CONTAINER_LOGS_DIR="$FERRY_RUN/containerlogs" \
  "$here/bin/kubelet" \
    --config="$FERRY_RUN/kubelet.yaml" --kubeconfig="$FERRY_HOME/kubelet.conf" \
    --hostname-override="$NODE_NAME" --root-dir="$FERRY_RUN/kubelet" \
    --cert-dir="$FERRY_RUN/pki" --v=2 >"$FERRY_RUN/logs/kubelet.log" 2>&1 &
  echo $! > "$FERRY_RUN/kubelet.pid"

  export KUBECONFIG="$FERRY_HOME/admin.conf"
  for _ in $(seq 1 60); do
    [ "$(kubectl get node "$NODE_NAME" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ] && break
    running kubelet || break
    sleep 1
  done
  if [ "$(kubectl get node "$NODE_NAME" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ]; then
    ok "node $NODE_NAME Ready"
  else
    bad "node did not become Ready"; tail -5 "$FERRY_RUN/logs/kubelet.log"; return 1
  fi

  if [ -x "$here/bin/ferry-proxyd" ]; then
    "$here/bin/ferry-proxyd" --kubeconfig "$FERRY_HOME/admin.conf" \
      --node-ip "$gateway" --socket "$FERRY_PROXYD_SOCK" \
      >"$FERRY_RUN/logs/ferry-proxyd.log" 2>&1 &
    echo $! > "$FERRY_RUN/ferry-proxyd.pid"
    for _ in $(seq 1 30); do [ -S "$FERRY_PROXYD_SOCK" ] && break; sleep 0.5; done
    [ -S "$FERRY_PROXYD_SOCK" ] && ok "Service rules rendered by kube-proxy" \
      || warn "ferry-proxyd did not start; Services will not route"
  fi

  start_proxy
  if [ -n "$dns" ]; then install_dns "$gateway" "$dns"; fi

  echo
  bold "ferry is up"
  echo "  export KUBECONFIG=$FERRY_HOME/admin.conf"
}

# CoreDNS forwards names it does not serve. It must not forward to itself, so
# it takes the resolvers the Mac itself uses.
host_resolvers() {
  local servers
  servers="$(scutil --dns 2>/dev/null | awk '/nameserver\[[0-9]+\]/ {print $3}' | sort -u | grep -v '^127\.' | head -3 | tr '\n' ' ')"
  [ -n "$servers" ] || servers="1.1.1.1 8.8.8.8"
  echo "$servers"
}

install_dns() { # gateway dns-address
  local gateway="$1" dns="$2"
  local rendered="$FERRY_RUN/coredns.yaml"
  sed -e "s|__CLUSTER_DOMAIN__|$CLUSTER_DOMAIN|g" \
      -e "s|__UPSTREAM_DNS__|$(host_resolvers)|g" \
      -e "s|__COREDNS_IMAGE__|$COREDNS_IMAGE|g" \
      -e "s|__APISERVER_HOST__|$gateway|g" \
      -e "s|__APISERVER_PORT__|6443|g" \
      "$here/manifests/coredns.yaml" > "$rendered"

  KUBECONFIG="$FERRY_HOME/admin.conf" kubectl apply -f "$rendered" >/dev/null 2>&1 \
    || { warn "could not apply CoreDNS"; return 0; }

  for _ in $(seq 1 90); do
    [ "$(KUBECONFIG=$FERRY_HOME/admin.conf kubectl get deploy coredns -n kube-system \
        -o jsonpath='{.status.readyReplicas}' 2>/dev/null)" = "1" ] && break
    sleep 2
  done
  if [ "$(KUBECONFIG=$FERRY_HOME/admin.conf kubectl get deploy coredns -n kube-system \
      -o jsonpath='{.status.readyReplicas}' 2>/dev/null)" = "1" ]; then
    ok "cluster DNS at $dns"
  else
    warn "CoreDNS did not become ready; pods will start without cluster DNS"
  fi
}

# Services route inside each pod when the guest kernel can do NAT: ferry-cri
# pushes the ruleset into pods, which program their own kernels. That needs no
# privilege on the Mac and keeps traffic pod to pod.
#
# The host proxy below is the fallback for a guest kernel without NAT. It has to
# bind ClusterIPs locally and listen on 443 for the kubernetes Service, both of
# which need root, and every Service connection then passes through the Mac.
start_proxy() {
  if [ "$KERNEL" = "$NAT_KERNEL" ] && [ -x "$here/bin/ferry-proxyd" ]; then
    ok "Services route inside pods (no host proxy, no root)"
    return 0
  fi

  [ -x "$here/bin/ferry-proxy" ] || { warn "ferry-proxy not built; Services will not route"; return 0; }
  echo "  The guest kernel cannot do NAT, so Services fall back to a host proxy."
  echo "  Build a NAT-capable kernel with 'ferry kernel' to avoid this."

  if ! sudo -n true 2>/dev/null; then
    echo "  ferry needs sudo once to bind ClusterIPs and listen on port 443."
    sudo -v || { warn "no sudo; Services will not route (pods and DNS still work)"; return 0; }
  fi

  sudo "$here/bin/ferry-proxy" --kubeconfig "$FERRY_HOME/admin.conf" \
    >"$FERRY_RUN/logs/ferry-proxy.log" 2>&1 &
  # The pid here is sudo's; record the child so 'ferry down' can stop it.
  sleep 2
  local pid; pid="$(pgrep -f "bin/ferry-proxy --kubeconfig" | head -1)"
  if [ -n "$pid" ]; then
    echo "$pid" > "$FERRY_RUN/ferry-proxy.pid"
    ok "Service proxy running (ClusterIPs routable)"
  else
    warn "Service proxy did not start; see $FERRY_RUN/logs/ferry-proxy.log"
  fi
}

# Another node on this Mac.
#
# A node here is a kubelet and a runtime, not a machine and not a container --
# the Mac is already the machine. So a second one costs two processes and a set
# of ports, and the pods it runs are virtual machines exactly like the first
# node's. Their addresses come from this node's own /24 inside the cluster /16,
# and they reach the first node's pods across ferry's switch.
cmd_node_add() {
  local name="${1:-}"
  [ -n "$name" ] || { bad "usage: ferry node add <name>"; return 2; }
  running ferry-cri || { bad "ferry is not up; run 'ferry up' first"; return 1; }

  # Find the first free index. Node 0 is the one 'ferry up' started.
  local index=1
  while [ -f "$FERRY_RUN/node-$index.pid" ]; do index=$((index + 1)); done
  [ "$index" -le 200 ] || { bad "too many nodes"; return 1; }

  local sock="/tmp/ferry-cri-$index.sock"
  local exec_sock="/tmp/ferry-exec-$index.sock"
  local streamer_sock="/tmp/ferry-str-$index.sock"
  local relay=$((RELAY_PORT + index))
  local kubelet_port=$((10250 + index))
  local healthz_port=$((10248 + index * 100))
  local stream_addr="127.0.0.1:$((10350 + index))"
  local run="$FERRY_RUN/node-$index"

  bold "adding node $name"
  mkdir -p "$run"/{kubelet,pki,podlogs,containerlogs,volume-plugins,cri}
  rm -f "$sock" "$exec_sock" "$streamer_sock"

  "$here/bin/ferry-cri" \
    --endpoint "$sock" --state "$run/cri" --kernel "$KERNEL" \
    --pod-subnet auto --pod-cpus "$POD_CPUS" --pod-memory-mib "$POD_MEMORY_MIB" \
    --exec-socket "$exec_sock" --streamer-control "$streamer_sock" \
    --nft-bundle "$here/guest/nft" --proxyd-socket "$FERRY_PROXYD_SOCK" \
    --cluster-cidr "$CLUSTER_CIDR" --node-index "$index" \
    --relay-port "$relay" --peers-file "$PEERS_FILE" \
    --relay-endpoint "$LAN_IP:$relay" \
    >"$FERRY_RUN/logs/node-$index-cri.log" 2>&1 &
  echo $! > "$FERRY_RUN/node-$index.pid"
  local ready=
  for _ in $(seq 1 90); do
    [ -S "$sock" ] && grep -q "serving" "$FERRY_RUN/logs/node-$index-cri.log" 2>/dev/null && { ready=1; break; }
    sleep 1
  done
  [ -n "$ready" ] || { bad "the runtime for $name did not start"; tail -5 "$FERRY_RUN/logs/node-$index-cri.log"; return 1; }
  ok "runtime on 10.244.$index.0/24, switch udp/$relay"

  "$here/bin/ferry-streamer" --listen "$stream_addr" \
    --exec-socket "$exec_sock" --control "$streamer_sock" \
    --kubeconfig "$FERRY_HOME/admin.conf" \
    --node-name "$name" --relay-endpoint "$LAN_IP:$relay" \
    --peers-file "$PEERS_FILE" \
    >"$FERRY_RUN/logs/node-$index-streamer.log" 2>&1 &
  echo $! > "$FERRY_RUN/node-$index-streamer.pid"
  for _ in $(seq 1 30); do [ -S "$streamer_sock" ] && break; sleep 0.5; done

  # The kubelet's config differs from node 0's only in where things live and
  # which ports it holds; everything that makes a kubelet work on darwin is the
  # same, so it is derived rather than written out again.
  sed -e "s|$FERRY_RUN/podlogs|$run/podlogs|" \
      -e "s|unix://$FERRY_SOCK|unix://$sock|g" \
      -e "s|$FERRY_RUN/volume-plugins|$run/volume-plugins|" \
      -e "s|^readOnlyPort: 0|readOnlyPort: 0\nport: $kubelet_port\nhealthzPort: $healthz_port|" \
      "$FERRY_RUN/kubelet.yaml" > "$run/kubelet.yaml"

  FERRY_CONTAINER_LOGS_DIR="$run/containerlogs" \
  "$here/bin/kubelet" \
    --config="$run/kubelet.yaml" --kubeconfig="$FERRY_HOME/kubelet.conf" \
    --hostname-override="$name" --root-dir="$run/kubelet" \
    --cert-dir="$run/pki" --v=2 >"$FERRY_RUN/logs/node-$index-kubelet.log" 2>&1 &
  echo $! > "$FERRY_RUN/node-$index-kubelet.pid"

  export KUBECONFIG="$FERRY_HOME/admin.conf"
  for _ in $(seq 1 90); do
    [ "$(kubectl get node "$name" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ] && break
    sleep 1
  done
  if [ "$(kubectl get node "$name" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = "True" ]; then
    ok "node $name Ready"
    echo
    kubectl get nodes
  else
    bad "node $name did not become Ready"; tail -5 "$FERRY_RUN/logs/node-$index-kubelet.log"; return 1
  fi
}

cmd_node_rm() {
  local name="${1:-}"
  [ -n "$name" ] || { bad "usage: ferry node rm <name>"; return 2; }
  export KUBECONFIG="$FERRY_HOME/admin.conf"
  local index
  for index in $(seq 1 200); do
    [ -f "$FERRY_RUN/node-$index.pid" ] || continue
    grep -q "hostname-override=$name" "$FERRY_RUN/logs/node-$index-kubelet.log" 2>/dev/null && break
    pgrep -f "hostname-override=$name" >/dev/null && break
  done
  pkill -f "hostname-override=$name" 2>/dev/null
  for suffix in "" -streamer -kubelet; do
    local pidfile="$FERRY_RUN/node-$index$suffix.pid"
    [ -f "$pidfile" ] && { kill -TERM "$(cat "$pidfile")" 2>/dev/null; rm -f "$pidfile"; }
  done
  kubectl delete node "$name" >/dev/null 2>&1
  ok "node $name removed"
}

cmd_down() {
  bold "stopping ferry"
  # ferry-proxy runs as root, so stopping it does too.
  if [ -f "$FERRY_RUN/ferry-proxy.pid" ]; then
    sudo kill -TERM "$(cat "$FERRY_RUN/ferry-proxy.pid")" 2>/dev/null \
      && ok "Service proxy stopped"
    rm -f "$FERRY_RUN/ferry-proxy.pid"
    sleep 1
  fi
  # Extra nodes first: each is a kubelet, a runtime and a streamer of its own.
  local index
  for index in $(seq 1 200); do
    [ -f "$FERRY_RUN/node-$index.pid" ] || continue
    for suffix in -kubelet -streamer ""; do
      local pidfile="$FERRY_RUN/node-$index$suffix.pid"
      [ -f "$pidfile" ] || continue
      local pid; pid="$(cat "$pidfile")"; rm -f "$pidfile"
      kill -TERM "$pid" 2>/dev/null || continue
      for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
      kill -KILL "$pid" 2>/dev/null
    done
    rm -f "/tmp/ferry-cri-$index.sock" "/tmp/ferry-exec-$index.sock" "/tmp/ferry-str-$index.sock"
    ok "node $index stopped"
  done

  for component in kubelet ferry-cri ferry-streamer ferry-proxyd; do
    local pidfile="$FERRY_RUN/$component.pid"
    [ -f "$pidfile" ] || continue
    local pid; pid="$(cat "$pidfile")"
    rm -f "$pidfile"
    kill -TERM "$pid" 2>/dev/null || continue
    # ferry-cri must finish releasing its vmnet network before another run can
    # claim the same subnet.
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -KILL "$pid" 2>/dev/null
    ok "$component stopped"
  done
  STATE="$FERRY_HOME" "$here/control-plane/down.sh" >/dev/null 2>&1 && ok "control plane stopped"
  rm -f "$FERRY_SOCK" "$FERRY_EXEC_SOCK" "$FERRY_STREAMER_SOCK" "$FERRY_PROXYD_SOCK" "$PEERS_FILE"
}

cmd_status() {
  bold "ferry status"
  for component in ferry-cri ferry-streamer ferry-proxyd kubelet ferry-proxy; do
    if running "$component"; then ok "$component (pid $(cat "$FERRY_RUN/$component.pid"))"
    else bad "$component"; fi
  done
  for component in etcd kube-apiserver kube-controller-manager kube-scheduler; do
    if [ -f "$FERRY_HOME/$component.pid" ] && kill -0 "$(cat "$FERRY_HOME/$component.pid")" 2>/dev/null
    then ok "$component"; else bad "$component"; fi
  done
  echo "  $(count_vms) pod VMs running"
  if [ -f "$FERRY_HOME/admin.conf" ] && running kubelet; then
    echo
    KUBECONFIG="$FERRY_HOME/admin.conf" kubectl get nodes 2>/dev/null
  fi
}

cmd_logs() {
  local which="${1:-}"
  case "$which" in
    ferry-cri|kubelet|control-plane|ferry-proxy|ferry-proxyd|ferry-streamer) tail -f "$FERRY_RUN/logs/$which.log" ;;
    apiserver|kube-apiserver)        tail -f "$FERRY_HOME/logs/kube-apiserver.log" ;;
    etcd)                            tail -f "$FERRY_HOME/logs/etcd.log" ;;
    *) echo "usage: ferry logs <ferry-cri|kubelet|control-plane|apiserver|etcd>"; return 1 ;;
  esac
}

case "${1:-}" in
  doctor)     shift; cmd_doctor "$@" ;;
  kernel)     shift; "$here/kernel/build-kernel.sh" "$@" ;;
  build)      shift; cmd_build "$@" ;;
  up)         shift; cmd_up "$@" ;;
  node)       shift
              case "${1:-}" in
                add) shift; cmd_node_add "$@" ;;
                rm)  shift; cmd_node_rm "$@" ;;
                ls|"") KUBECONFIG="$FERRY_HOME/admin.conf" kubectl get nodes ;;
                *)   bad "usage: ferry node [add <name>|rm <name>|ls]"; exit 2 ;;
              esac ;;
  down)       shift; cmd_down "$@" ;;
  status)     shift; cmd_status "$@" ;;
  logs)       shift; cmd_logs "$@" ;;
  kubeconfig) echo "$FERRY_HOME/admin.conf" ;;
  -h|--help|help|"") usage ;;
  *) echo "unknown command: $1"; echo; usage; exit 1 ;;
esac
